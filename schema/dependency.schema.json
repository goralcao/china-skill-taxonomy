{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dependency.schema.json",
  "title": "先修依赖（图谱边）",
  "type": "object",
  "required": ["version", "schemaVersion", "dependencies"],
  "properties": {
    "version": { "type": "string" },
    "schemaVersion": { "type": "integer" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topicId", "prerequisiteId", "strength", "reason"],
        "properties": {
          "topicId": { "type": "string", "pattern": "^mt_[a-z0-9-]+$" },
          "prerequisiteId": { "type": "string", "pattern": "^mt_[a-z0-9-]+$" },
          "strength": { "enum": ["hard", "soft"] },
          "reason": { "type": "string", "minLength": 4, "maxLength": 60 }
        }
      }
    }
  }
}
