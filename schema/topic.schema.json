{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "topic.schema.json",
  "title": "主题（图谱节点）",
  "type": "object",
  "required": ["version", "schemaVersion", "topics"],
  "properties": {
    "version": { "type": "string" },
    "schemaVersion": { "type": "integer" },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "subject", "domain", "name", "description",
                     "gradeRangeStart", "gradeRangeEnd", "stage", "evidence",
                     "assessmentPrompt", "standards", "textbooks"],
        "properties": {
          "id": { "type": "string", "pattern": "^mt_[a-z0-9-]+$" },
          "type": { "enum": ["CONCEPTUAL", "PROCEDURAL", "REPRESENTATIONAL", "LANGUAGE", "META"] },
          "subject": { "enum": ["数学", "语文", "英语"] },
          "domain": { "type": "string", "minLength": 2, "maxLength": 12 },
          "name": { "type": "string", "minLength": 2, "maxLength": 24 },
          "description": { "type": "string", "minLength": 30, "maxLength": 120 },
          "gradeRangeStart": { "type": "integer", "minimum": 1, "maximum": 6 },
          "gradeRangeEnd": { "type": "integer", "minimum": 1, "maximum": 6 },
          "stage": { "type": "string", "minLength": 4 },
          "centrality": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "string", "minLength": 6, "maxLength": 60 }
          },
          "assessmentPrompt": { "type": "string", "minLength": 10, "maxLength": 120, "pattern": "\\{\\{name\\}\\}" },
          "standards": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": { "type": "string", "pattern": "^(math|chinese|english)-2022:" }
          },
          "textbooks": {
            "type": "array", "minItems": 1, "maxItems": 4,
            "items": {
              "type": "string",
              "pattern": "^(pep-math:[1-6][ab](:u[1-9])?|tongbian-chinese:[1-6][ab](:u[1-8])?(#[^#]+)?|pep-english:[3-6][ab](:u[1-6])?)$"
            }
          }
        }
      }
    }
  }
}
