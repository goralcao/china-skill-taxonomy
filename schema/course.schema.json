{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "course.schema.json",
  "title": "课件索引与元数据",
  "type": "object",
  "required": ["version", "schemaVersion", "courses"],
  "properties": {
    "version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date" },
    "counts": {
      "type": "object",
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "byTemplate": { "type": "object" },
        "byStatus": { "type": "object" },
        "bySubject": { "type": "object" }
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topicId", "title", "template", "duration", "interactions", "status", "version", "path"],
        "additionalProperties": false,
        "properties": {
          "topicId": { "type": "string", "pattern": "^mt_[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 4, "maxLength": 40 },
          "template": { "enum": ["explain", "drill", "explore", "review"] },
          "duration": { "type": "integer", "minimum": 5, "maximum": 25 },
          "interactions": { "type": "integer", "minimum": 2, "maximum": 15 },
          "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
          "subject": { "type": "string", "minLength": 2 },
          "standards": {
            "type": "array", "minItems": 0, "maxItems": 3,
            "items": { "type": "string", "pattern": "^[a-z]+-2022:[A-Z0-9]+:" }
          },
          "prerequisites": {
            "type": "array", "items": { "type": "string", "pattern": "^mt_[a-z0-9-]+$" }
          },
          "next": {
            "type": "array", "items": { "type": "string", "pattern": "^mt_[a-z0-9-]+$" }
          },
          "objectives": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": { "type": "string", "minLength": 4, "maxLength": 40 }
          },
          "status": { "enum": ["draft", "reviewed", "deprecated"] },
          "author": { "type": "string", "minLength": 1 },
          "license": { "const": "CC-BY-SA-4.0" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "updatedAt": { "type": "string", "format": "date" },
          "path": { "type": "string", "pattern": "^courses/mt_[a-z0-9-]+/$" }
        }
      }
    }
  }
}
