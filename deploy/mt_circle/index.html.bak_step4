  下次遇到圆，先找<strong>圆心和半径</strong>，再套 d = 2r；判断直径时一定问一句「过不过圆心」。
</p>
</section>
</div><!-- /pageContainer -->

<!-- ===== 渐进揭示提示条 ===== -->
<div id="revealHint"><span class="r-dot"></span>点击页面继续揭示 <span class="r-progress" id="revealProgress"></span></div>

<!-- ===== 图片全屏灯箱 ===== -->
<div id="imgLightbox" onclick="closeLightbox()">
  <button class="lb-close" onclick="closeLightbox()">✕</button>
  <img id="lbImg" src="" alt="全屏查看">
</div>

<!-- ===== 底部翻页按钮 ===== -->
<div id="navBtns">
  <button id="btnPrev" onclick="prevPage()" disabled>◀</button>
  <span id="pageIndicator">1/N</span>
  <button id="btnNext" onclick="nextPage()">▶</button>
</div>

<script>
// ⚠ 加载顺序：page-flip-system.js 必须最先（其中定义了 getPageParam，供 mqtt-framework/teaching-control 复用）
// 引用: references/templates/page-flip-system.js
// 引用: references/templates/quiz-engine.js
// 引用: references/templates/matching-quiz.js
// 引用: references/templates/canvas-engine-patterns.js
// 引用: references/templates/infographic-generator.js
// 各仿真和绘制函数按需添加...

// ===== 全屏：v2026-09-28e 定案「默认不放按钮」 =====
// 外壳 sandbox 无 allow-fullscreen，网页代码达不到 F11 式真全屏，故不放全屏按钮及其 JS。
// 需要全屏 → 用户按 F11 或直开 HTML；确需按钮 → 从 teaching-control.js 取三级降级实现。


// ===== 渐进呈现动画引擎 =====
// 使用方式：在 onPageEnter 中调用 setupReveal(pageId, [...]), 定义每步揭示的元素
// 每个 item: { sel: 'CSS选择器', anim: '动画class名', delay: 可选延迟ms }
// 学生在讲授页点击空白区域依次揭示

var pageRevealQueues = {};   // { p2: [{sel, anim, delay}, ...], ... }
var pageRevealIndex = {};    // { p2: 2, ... }
var pageRevealActive = {};   // { p2: true, ... }
var _revealPlaying = {};     // 上一步动画现场 { p2: {els, anim, t0, dur} }，用于连点快进

/* ---------- 视觉顺序（v1.5.5 新增）----------
   揭示顺序一律按「版面位置」判定：先上后下、同行先左后右，禁止依赖 DOM 书写顺序。
   原因：grid/flex 的 order、column-count 多列、绝对定位、模板套用都会让 DOM 顺序 ≠ 视觉顺序，
   于是出现「下面的比上面的先出现」「右面的比左边的先出现」。 */
function _revealSortEls(els) {
  var arr = Array.prototype.slice.call(els).map(function(el, i) { return { el: el, i: i }; });
  var TOL = 12; // 同一行的容差（px）：卡片行内 top 完全一致，容差只为吸收亚像素/阴影差
  arr.sort(function(a, b) {
    var ra = a.el.getBoundingClientRect(), rb = b.el.getBoundingClientRect();
    if (Math.abs(ra.top - rb.top) > TOL) return ra.top - rb.top;
    if (Math.abs(ra.left - rb.left) > TOL) return ra.left - rb.left;
    return a.i - b.i; // 位置相同 → 保持原序（稳定）
  });
  return arr.map(function(o) { return o.el; });
}

/* 一步揭示实际命中的元素（支持 item.children：容器内子元素逐个揭示） */
function _revealMatch(pageId, item) {
  var base = document.querySelectorAll('#' + pageId + ' ' + item.sel);
  if (item.children) {
    var out = [];
    Array.prototype.forEach.call(base, function(c) {
      out = out.concat(Array.prototype.slice.call(c.querySelectorAll(item.children)));
    });
    return out;
  }
  return Array.prototype.slice.call(base);
}

function setupReveal(pageId, items) {
  pageRevealQueues[pageId] = items;
  pageRevealIndex[pageId] = 0;
  pageRevealActive[pageId] = items.length > 0;
  _revealPlaying[pageId] = null;
  // 初始隐藏所有待揭示元素
  items.forEach(function(item) {
    var els = _revealMatch(pageId, item);
    if (!els.length) {
      console.warn('[reveal] 选择器未命中，该步会被跳过并导致后续顺序前移：#' + pageId + ' ' + item.sel);
    }
    els.forEach(function(el) { el.classList.add('reveal-hidden'); });
  });
  updateRevealHint(pageId);
}

/* 零配置揭示：页面内元素标 data-reveal 即可，队列按视觉顺序自动生成（推荐，永不乱序）
   用法：
     <p data-reveal>段落</p>                        → 淡入上浮（默认）
     <figure class="fig float-r" data-reveal="reveal-float-in-r">…</figure>
     <div data-reveal data-reveal-children=".card" data-reveal-seq="150">…卡片组…</div>
   属性：data-reveal=动画class / data-reveal-children=组内逐个元素 / data-reveal-seq / data-reveal-delay */
function setupRevealAuto(pageId) {
  var root = document.getElementById(pageId);
  if (!root) { console.warn('[reveal] 页面不存在：' + pageId); return; }
  var nodes = Array.prototype.slice.call(root.querySelectorAll('[data-reveal]'));
  // 嵌套去重：祖先已带 data-reveal 的节点不再单独入队
  nodes = nodes.filter(function(el) {
    var p = el.parentElement;
    while (p && p !== root) {
      if (p.hasAttribute && p.hasAttribute('data-reveal')) return false;
      p = p.parentElement;
    }
    return true;
  });
  nodes.forEach(function(el, i) {
    if (!el.hasAttribute('data-reveal-id')) el.setAttribute('data-reveal-id', pageId + 'RV' + i);
  });

  function build() {
    var ordered = _revealSortEls(nodes);   // 每次重建都按当前真实位置排序
    var items = ordered.map(function(el) {
      return {
        sel: '[data-reveal-id="' + el.getAttribute('data-reveal-id') + '"]',
        anim: el.getAttribute('data-reveal') || 'reveal-fade-up',
        children: el.getAttribute('data-reveal-children') || '',
        seqDelay: parseInt(el.getAttribute('data-reveal-seq'), 10) || 0,
        delay: parseInt(el.getAttribute('data-reveal-delay'), 10) || 0
      };
    });
    setupReveal(pageId, items);
  }
  build();

  // 若调用时页面还没完成布局（元素 rect 全为 0，例如 display:none 中提前建队列），
  // 下一帧按真实位置重排一次队列——否则退化成 DOM 顺序，正是「下面先出/右面先出」的根源。
  var unmeasurable = nodes.some(function(el) {
    var r = el.getBoundingClientRect();
    return r.width === 0 && r.height === 0;
  });
  if (unmeasurable) {
    requestAnimationFrame(function() {
      if (pageRevealIndex[pageId] === 0) build();
    });
  }
}

function nextReveal(pageId) {
  if (!pageRevealActive[pageId]) return;
  var queue = pageRevealQueues[pageId];
  var idx = pageRevealIndex[pageId];
  if (!queue || idx >= queue.length) return;

  // ① 连点快进（v1.5.5）：上一步动画尚未播完就点了下一步 → 直接把上一步定格到终态。
  //    否则两次动画时间轴交叠，会出现「后一步还停在透明度 0 已开始计时、前一步刚过半」的倒序错觉。
  var prev = _revealPlaying[pageId];
  if (prev) {
    var elapsed = Date.now() - prev.t0;
    if (prev.dur > 0 && elapsed < prev.dur) {
      prev.els.forEach(function(el) { el.classList.remove(prev.anim); });
    }
    _revealPlaying[pageId] = null;
  }

  var item = queue[idx];
  var els = _revealMatch(pageId, item);
  if (!els.length) {
    console.warn('[reveal] 选择器未命中，该步被跳过：#' + pageId + ' ' + item.sel);
  }
  // ② 组内揭示顺序 = 视觉顺序（上→下、左→右），与 querySelectorAll 的 DOM 顺序无关
  els = _revealSortEls(els);

  var delay = item.delay || 0;
  var seq = item.seqDelay || 0;
  els.forEach(function(el, i) {
    var d = delay + seq * i;
    el.style.animationDelay = d + 'ms';
    el.classList.add(item.anim);
    el.classList.add('reveal-done');
  });

  // ③ 记录本步动画时长（含组内错峰），供下一步连点快进判断
  var dur = 0;
  if (els.length) {
    var ad = '';
    try { ad = getComputedStyle(els[0]).animationDuration || '0s'; } catch (e) {}
    dur = parseFloat(ad) * 1000;
    if (!isFinite(dur) || dur <= 0 || dur > 5000) dur = 0; // 持续型（kenburns 8s 等）不快进
    else dur += delay + seq * Math.max(0, els.length - 1);
  }
  _revealPlaying[pageId] = { els: els, anim: item.anim, t0: Date.now(), dur: dur };

  pageRevealIndex[pageId]++;
  updateRevealHint(pageId);
  // 全部揭示完 → 隐藏提示条
  if (pageRevealIndex[pageId] >= queue.length) {
    pageRevealActive[pageId] = false;
  }
}

// 逆向回退：撤销上一步揭示（配合键盘箭头回退，见 SKILL.md「Progressive Reveal Animation System」章节）
function prevReveal(pageId) {
  var queue = pageRevealQueues[pageId];
  var idx = pageRevealIndex[pageId];
  if (!queue || idx <= 0) return;
  idx--;
  var item = queue[idx];
  var els = _revealMatch(pageId, item);
  els.forEach(function(el) {
    el.classList.remove(item.anim, 'reveal-done');
    el.classList.add('reveal-hidden');
    el.style.animationDelay = '';
    // 项目扩展：此处重置该元素内的 count-num / typewriter 等特殊效果
    // 完整版（含 _twTimer 中断）见 SKILL.md「Progressive Reveal Animation System」章节 prevReveal 完整代码
  });
  _revealPlaying[pageId] = null;
  pageRevealIndex[pageId] = idx;
  pageRevealActive[pageId] = true;
  updateRevealHint(pageId);
}

function updateRevealHint(pageId) {
  var hint = document.getElementById('revealHint');
  var progress = document.getElementById('revealProgress');
  var active = pageRevealActive[pageId];
  var queue = pageRevealQueues[pageId];
  if (!active || !queue) { hint.style.display = 'none'; return; }
  var idx = pageRevealIndex[pageId];
  var remain = queue.length - idx;
  if (remain <= 0) { hint.style.display = 'none'; return; }
  hint.style.display = 'flex';
  progress.textContent = (idx + 1) + '/' + queue.length + ' ←→';
}

// 讲授页全局点击 → 触发 nextReveal（排除链接、按钮、quiz-q 等交互元素）
document.addEventListener('click', function(e) {
  var pageEl = document.querySelector('.page.active');
  if (!pageEl) return;
  var pid = pageEl.id;
  if (!pageRevealActive[pid]) return;
  // 排除交互元素（含图片——图片点击触发灯箱而非揭示）
  var tag = e.target.tagName;
  if (tag === 'A' || tag === 'BUTTON' || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'IMG') return;
  if (e.target.closest('.quiz-q') || e.target.closest('.opt') ||
      e.target.closest('nav') || e.target.closest('#navBtns') || e.target.closest('.timeline-card') ||
      e.target.closest('.mindmap') || e.target.closest('#imgLightbox')) return;
  nextReveal(pid);
});

// 翻页时重置提示条状态
var _origShowPage = showPage;
showPage = function(i) {
  _origShowPage(i);
  var pid = PAGE_IDS[i];
  setTimeout(function() { updateRevealHint(pid); }, 100);
};

// ===== 图片全屏灯箱 =====
function openLightbox(src) {
  document.getElementById('lbImg').src = src;
  document.getElementById('imgLightbox').classList.add('show');
}
function closeLightbox() {
  document.getElementById('imgLightbox').classList.remove('show');
}
// 页面图片点击 → 全屏放大
document.addEventListener('click', function(e) {
  if (e.target.tagName === 'IMG' && !e.target.closest('#imgLightbox') && !e.target.closest('.qr-img-wrap')) {
    e.stopPropagation();
    openLightbox(e.target.src);
  }
});
// ESC 关闭灯箱
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    var lb = document.getElementById('imgLightbox');
    if (lb.classList.contains('show')) { closeLightbox(); e.preventDefault(); }
  }
});

var PAGE_IDS = ["p0", "p1", "p2", "p3", "p3b", "p4", "p5", "p6", "p7", "p8", "p9", "p10"];
var PAGE_LABELS = ["封面", "前测", "圆规画圆", "d = 2r", "连一连", "中测1", "对称与生活", "仿真", "中测2", "辨析", "后测", "总结"];
var IMG_PREFIX = 'img/';
var curPage = 0;

// ===== 测验数据 =====
var QUIZZES = {
  quizPre: {
    questions: [
      { answer: 0, explain: "针尖固定的点是圆心，通常用字母 O 表示。" },
      { answer: 2, explain: "圆心到圆上一点的线段是半径 r。" },
      { answer: 1, explain: "d = 2r = 2 × 5 = 10 厘米。" }
    ]
  },
  quizMid1: {
    questions: [
      { answer: 0, explain: "r = d ÷ 2 = 12 ÷ 2 = 6 厘米。" },
      { answer: 1, explain: "直径要同时满足过圆心、两端在圆上；第三种是半径。" },
      { answer: 2, explain: "圆上有无数个点，每个点与圆心连成一条半径。" }
    ]
  },
  quizMid2: {
    questions: [
      { answer: 1, explain: "每条直径所在直线都是对称轴，直径有无数条。" },
      { answer: 2, explain: "不经过圆心的只是普通弦，只有过圆心的才是直径。" },
      { answer: 0, explain: "每条直径都是 2r，r 相同所以直径都相等。" }
    ]
  },
  quizPost: {
    questions: [
      { answer: 0, explain: "两脚距离就是半径，张开 4 厘米。" },
      { answer: 1, explain: "d = 2r = 2 × 7 = 14 厘米。" },
      { answer: 1, explain: "直径经过圆心，是圆内最长的弦。" },
      { answer: 0, explain: "d = 2r 成立；半径有无数条，弦不一定过圆心。" },
      { answer: 2, explain: "圆任意方向的宽度都等于直径，怎么转都不会掉进井口。" }
    ]
  }
};
// ===== 翻页系统 =====
function getPageParam(k) {
  try {
    var h = location.hash || '';
    if (h.indexOf(k + '=') >= 0) {
      var m1 = new RegExp('[#&]' + k + '=([^&#]*)').exec(h);
      if (m1) return decodeURIComponent(m1[1]);
    }
    var q = location.search || '';
    if (q.indexOf(k + '=') >= 0) {
      var m2 = new RegExp('[?&]' + k + '=([^&#]*)').exec(q);
      if (m2) return decodeURIComponent(m2[1]);
    }
    if (window.parent && window.parent !== window) {
      try {
        var psrc = (window.parent.location.hash || '') + '&' + (window.parent.location.search || '');
        if (psrc.indexOf(k + '=') >= 0) {
          var m3 = new RegExp('[#&?]' + k + '=([^&#]*)').exec(psrc);
          if (m3) return decodeURIComponent(m3[1]);
        }
      } catch (e) {}
    }
  } catch (e) {}
  return null;
}

function showPage(i) {
  if (i < 0 || i >= PAGE_IDS.length) return;
  var oldEl = document.querySelector('.page.active');
  if (oldEl) oldEl.classList.remove('active');
  var newEl = document.getElementById(PAGE_IDS[i]);
  if (newEl) { newEl.classList.add('active'); newEl.scrollTop = 0; }
  curPage = i;
  document.querySelectorAll('#topNav .chip').forEach(function(c, idx) {
    c.classList.toggle('active', idx === i);
  });
  document.getElementById('progressBar').style.width = ((i + 1) / PAGE_IDS.length * 100) + '%';
  document.getElementById('pageIndicator').textContent = (i + 1) + '/' + PAGE_IDS.length;
  document.getElementById('btnPrev').disabled = (i === 0);
  document.getElementById('btnNext').disabled = (i === PAGE_IDS.length - 1);
  onPageEnter(i);
  var activeChip = document.querySelector('#topNav .chip.active');
  if (activeChip && typeof activeChip.scrollIntoView === 'function') activeChip.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
}

function nextPage() { if (curPage < PAGE_IDS.length - 1) showPage(curPage + 1); }
function prevPage() { if (curPage > 0) showPage(curPage - 1); }

document.querySelectorAll('#topNav .chip').forEach(function(chip) {
  chip.addEventListener('click', function() {
    showPage(parseInt(this.getAttribute('data-page')));
  });
});

document.addEventListener('keydown', function(e) {
  var pid = PAGE_IDS[curPage];
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
    e.preventDefault();
    if (typeof pageRevealActive !== 'undefined' && pageRevealActive[pid] &&
        pageRevealQueues[pid] && pageRevealIndex[pid] < pageRevealQueues[pid].length) {
      nextReveal(pid);
    } else { nextPage(); }
  } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
    e.preventDefault();
    if (typeof pageRevealQueues !== 'undefined' && pageRevealQueues[pid] && pageRevealIndex[pid] > 0) {
      prevReveal(pid);
    } else { prevPage(); }
  }
});

var touchStartX = 0, touchStartY = 0;
document.addEventListener('touchstart', function(e) {
  touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY;
}, { passive: true });
document.addEventListener('touchend', function(e) {
  var dx = e.changedTouches[0].clientX - touchStartX;
  var dy = e.changedTouches[0].clientY - touchStartY;
  if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 60) {
    if (dx < 0) nextPage(); else prevPage();
  }
});

var pageEntered = {};
function onPageEnter(i) {
  var id = PAGE_IDS[i];
  if (pageEntered[id]) return;
  pageEntered[id] = true;
  if (id === 'p2') {
    setupReveal('p2', [
      { sel: '#p2s1', anim: 'reveal-fade-up' },
      { sel: '#p2fig', anim: 'reveal-float-in-r' },
      { sel: '#p2s2', anim: 'reveal-fade-up' },
      { sel: '#p2s3', anim: 'reveal-fade-up' },
      { sel: '#p2cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 110 },
      { sel: '#p2key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p3') {
    setupReveal('p3', [
      { sel: '#p3s1', anim: 'reveal-fade-up' },
      { sel: '#p3fig', anim: 'reveal-float-in-r' },
      { sel: '#p3s2', anim: 'reveal-fade-up' },
      { sel: '#p3rules', anim: 'reveal-fade-up' },
      { sel: '#p3key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p3b') {
    setupReveal('p3b', [{ sel: '#p3bs1', anim: 'reveal-fade-up' }]);
    initMatching('matchP3', [
      ['圆心 O', '决定圆的位置'],
      ['半径 r', '圆心到圆上一点的线段'],
      ['直径 d', '过圆心、两端在圆上的线段'],
      ['d = 2r', '直径是半径的 2 倍'],
      ['同圆内的半径', '无数条且都相等'],
      ['最长的弦', '直径'],
      ['对称轴', '直径所在的直线'],
      ['圆规两脚距离', '半径']
    ], { leftTitle: '名称 / 说法', rightTitle: '含义' });
  }
  if (id === 'p5') {
    setupReveal('p5', [
      { sel: '#p5s1', anim: 'reveal-fade-up' },
      { sel: '#p5fig', anim: 'reveal-float-in-r' },
      { sel: '#p5s2', anim: 'reveal-fade-up' },
      { sel: '#p5cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 120 },
      { sel: '#p5key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p6') { simBind(); simDraw(); }
  if (id === 'p8') {
    setupReveal('p8', [
      { sel: '#p8cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 120 },
      { sel: '#p8key', anim: 'reveal-fade-up' },
      { sel: '#p8apply', anim: 'reveal-fade-up' }
    ]);
  }
}

// ===== 测验引擎 =====
(function(){
  if (document.getElementById('quiz-engine-css')) return;
  var st = document.createElement('style');
  st.id = 'quiz-engine-css';
  st.textContent = [
    '.q-type{display:inline-block;font-size:14px;font-weight:700;padding:1px 10px;border-radius:12px;margin-right:8px;vertical-align:2px;background:var(--primary-light);color:#fff;letter-spacing:1px}',
    '.q-type.multi{background:var(--accent)}',
    '.opt-confirm{margin-top:10px;padding:7px 22px;border-radius:18px;font-size:16px;font-weight:600;cursor:pointer;border:2px solid var(--accent);background:var(--paper);color:var(--accent);transition:all .2s}',
    '.opt-confirm:hover{background:var(--accent);color:#fff}',
    '.quiz-q.submitted .opt-confirm{display:none}'
  ].join('\n');
  document.head.appendChild(st);
})();

function isMultiQ(q){ return !!(q && q.multi && Array.isArray(q.answer)); }
function sameIdxArr(a, b){
  if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
  for (var i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
  return true;
}
function ascArr(a){ return a.slice().sort(function(x, y){ return x - y; }); }
function isCorrectChoice(q, chosen){
  if (isMultiQ(q)) return sameIdxArr(chosen, ascArr(q.answer));
  return chosen === q.answer;
}
function idxInAnswer(q, j){
  return Array.isArray(q.answer) ? q.answer.indexOf(j) >= 0 : j === q.answer;
}
function idxInChosen(c, j){
  return Array.isArray(c) ? c.indexOf(j) >= 0 : c === j;
}
function quizScoreId(containerId){
  var s = String(containerId).replace(/^quiz/, '');
  return s.charAt(0).toLowerCase() + s.slice(1) + 'Score';
}

function initQuiz(quizId) {
  var container = document.getElementById(quizId);
  if (!container || !QUIZZES[quizId]) return;
  if (container._initialized) return;
  container._initialized = true;
  container._questions = QUIZZES[quizId].questions;
  container._chosen = container._questions.map(function(q){ return isMultiQ(q) ? null : -1; });
  container._picked = container._questions.map(function(q){ return isMultiQ(q) ? [] : null; });
  var isSubmitMode = false;

  container.querySelectorAll('.quiz-q').forEach(function(qq, qi) {
    var q = container._questions[qi];
    if (!q) return;
    var opts = qq.querySelectorAll('.opt');
    if (isMultiQ(q)) {
      opts.forEach(function(opt) {
        opt.addEventListener('click', function() {
          if (container._submitted) return;
          var idx = parseInt(this.getAttribute('data-idx'));
          var pos = container._picked[qi].indexOf(idx);
          if (pos >= 0) { container._picked[qi].splice(pos, 1); this.classList.remove('selected'); }
          else { container._picked[qi].push(idx); this.classList.add('selected'); }
        });
      });
      var btn = qq.querySelector('.opt-confirm');
      if (btn) btn.addEventListener('click', function() {
        if (container._submitted) return;
        if (container._picked[qi].length === 0) return;
        container._chosen[qi] = ascArr(container._picked[qi]);
        qq.classList.add('answered');
        if (!isSubmitMode) { showFeedback(quizId, qi); updateQuizScore(quizId); }
      });
    } else {
      opts.forEach(function(opt) {
        opt.addEventListener('click', function() {
          if (container._submitted) return;
          var idx = parseInt(this.getAttribute('data-idx'));
          container._chosen[qi] = idx;
          opts.forEach(function(o) { o.classList.remove('selected'); });
          this.classList.add('selected');
          qq.classList.add('answered');
          if (!isSubmitMode) { showFeedback(quizId, qi); updateQuizScore(quizId); }
        });
      });
    }
  });
}

function showFeedback(quizId, qi) {
  var container = document.getElementById(quizId);
  var q = container._questions[qi];
  var c = container._chosen[qi];
  var qq = document.getElementById('qq_' + quizId + '_' + qi);
  var fb = document.getElementById('fb_' + quizId + '_' + qi);
  if (!qq || !fb) return;
  var isCorrect = isCorrectChoice(q, c);
  fb.innerHTML = '<span class="fb-icon">' + (isCorrect ? '✓' : '✗') + '</span>' +
    (isCorrect ? '答对了。' : '再看一遍。') + q.explain;
  fb.className = 'feedback show ' + (isCorrect ? 'correct-fb' : 'wrong-fb');
  qq.querySelectorAll('.opt').forEach(function(o, j) {
    if (idxInAnswer(q, j)) o.classList.add('correct');
    if (!isCorrect && idxInChosen(c, j) && !idxInAnswer(q, j)) o.classList.add('wrong');
    o.style.pointerEvents = 'none';
  });
}

function updateQuizScore(quizId) {
  var container = document.getElementById(quizId);
  var total = container._questions.length;
  var done = 0, score = 0;
  container._questions.forEach(function(q, i) {
    var c = container._chosen[i];
    var answered = isMultiQ(q) ? (Array.isArray(c) && c.length > 0) : c >= 0;
    if (answered) { done++; if (isCorrectChoice(q, c)) score++; }
  });
  var scoreEl = document.getElementById(quizScoreId(quizId));
  if (scoreEl) {
    scoreEl.style.display = 'block';
    if (done === total) {
      scoreEl.innerHTML = '得分：' + score + '/' + total + ' &nbsp;&nbsp;' +
        (score === total ? '🌟 全部正确！' : score >= total * 0.6 ? '👍 不错，继续加油！' : '💪 回到前面再看一遍');
    } else {
      scoreEl.textContent = '已答：' + done + '/' + total + ' 正确：' + score;
    }
  }
  try { localStorage.setItem('xmn_' + quizId, JSON.stringify({ score: score, total: total, done: done })); } catch (e) {}
}

function retryQuiz(quizId) {
  var container = document.getElementById(quizId);
  if (!container) return;
  container._chosen = container._questions.map(function(q){ return isMultiQ(q) ? null : -1; });
  container._picked = container._questions.map(function(q){ return isMultiQ(q) ? [] : null; });
  container.querySelectorAll('.quiz-q').forEach(function(qq) {
    qq.classList.remove('answered');
    qq.querySelectorAll('.opt').forEach(function(o) {
      o.classList.remove('selected', 'correct', 'wrong');
      o.style.pointerEvents = 'auto';
    });
  });
  container.querySelectorAll('.feedback').forEach(function(fb) { fb.className = 'feedback'; fb.innerHTML = ''; });
  var el = document.getElementById(quizScoreId(quizId));
  if (el) el.style.display = 'none';
}

Object.keys(QUIZZES).forEach(function(k) { initQuiz(k); });

// ===== 连线题引擎 =====
(function(){
  var CSS = [
    '.match-wrap{position:relative;margin:14px 0}',
    '.match-cols{display:grid;grid-template-columns:1fr 1fr;gap:40px}',
    '.match-col h4{font-size:18px;color:var(--primary);margin-bottom:10px;text-align:center}',
    '.match-item{padding:14px 18px;margin-bottom:12px;border:2px solid var(--line);border-radius:12px;background:#fff;font-size:19px;cursor:pointer;transition:all .2s;text-align:center}',
    '.match-item:hover{border-color:var(--primary-light)}',
    '.match-item.sel{border-color:var(--accent);background:var(--accent-soft)}',
    '.match-item.ok{border-color:var(--green);background:#E8F5F3}',
    '.match-item.bad{border-color:var(--red);animation:shakeX .35s}',
    '@keyframes shakeX{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}',
    '.match-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}',
    '.mq-actions{text-align:center;margin-top:10px}',
    '.mq-actions button{padding:7px 22px;border-radius:18px;font-size:16px;font-weight:600;cursor:pointer;border:2px solid var(--primary);background:var(--paper);color:var(--primary)}',
    '.mq-done{text-align:center;font-size:18px;font-weight:700;color:var(--green);margin-top:8px;min-height:24px}'
  ].join('\n');
  var st = document.createElement('style');
  st.textContent = CSS;
  document.head.appendChild(st);
})();

function initMatching(containerId, pairs, options){
  options = options || {};
  var c = document.getElementById(containerId);
  if (!c || c._initialized) return;
  c._initialized = true;
  var list = pairs.map(function(p){ return Array.isArray(p) ? {left:p[0], right:p[1]} : p; });
  var order = list.map(function(_, i){ return i; });
  for (var i = order.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = order[i]; order[i] = order[j]; order[j] = t;
  }
  c.innerHTML =
    '<div class="match-wrap"><div class="match-cols">' +
      '<div class="match-col"><h4>' + (options.leftTitle || '左侧') + '</h4>' +
        list.map(function(p, k){ return '<div class="match-item" data-side="L" data-i="' + k + '">' + p.left + '</div>'; }).join('') +
      '</div>' +
      '<div class="match-col"><h4>' + (options.rightTitle || '右侧') + '</h4>' +
        order.map(function(k){ return '<div class="match-item" data-side="R" data-i="' + k + '">' + list[k].right + '</div>'; }).join('') +
      '</div>' +
    '</div><svg class="match-svg"></svg></div>' +
    '<div class="mq-actions"><button type="button" data-act="retry">重试</button></div>' +
    '<div class="mq-done"></div>';

  var wrap = c.querySelector('.match-wrap');
  var svg = c.querySelector('.match-svg');
  var state = { sel: null, links: {}, ok: {} };

  function itemAt(side, idx){ return c.querySelector('.match-item[data-side="' + side + '"][data-i="' + idx + '"]'); }

  function drawLinks(){
    var box = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + box.width + ' ' + box.height);
    svg.innerHTML = '';
    Object.keys(state.links).forEach(function(l){
      var a = itemAt('L', Number(l)), b = itemAt('R', state.links[l]);
      if (!a || !b) return;
      var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
      var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', ra.right - box.left);
      line.setAttribute('y1', ra.top + ra.height / 2 - box.top);
      line.setAttribute('x2', rb.left - box.left);
      line.setAttribute('y2', rb.top + rb.height / 2 - box.top);
      line.setAttribute('stroke', state.ok[l] ? '#00897B' : '#D84315');
      line.setAttribute('stroke-width', '3');
      line.setAttribute('stroke-linecap', 'round');
      svg.appendChild(line);
    });
  }

  function checkDone(){
    var total = list.length;
    var done = Object.keys(state.ok).filter(function(k){ return state.ok[k]; }).length;
    if (done === total) {
      c.querySelector('.mq-done').textContent = '✓ 全部连对，三根针的速度都记住了';
      if (options.onDone) options.onDone(done, total);
    }
  }

  c.addEventListener('click', function(e){
    var el = e.target.closest('.match-item');
    if (!el) return;
    var side = el.getAttribute('data-side');
    var idx = parseInt(el.getAttribute('data-i'), 10);
    if (el.classList.contains('ok')) return;

    if (!state.sel || state.sel.side === side) {
      c.querySelectorAll('.match-item.sel').forEach(function(x){ x.classList.remove('sel'); });
      state.sel = { side: side, idx: idx };
      el.classList.add('sel');
      return;
    }
    var l = side === 'L' ? idx : state.sel.idx;
    var r = side === 'R' ? idx : state.sel.idx;
    if (state.links[l] !== undefined) delete state.links[l];
    state.links[l] = r;
    state.ok[l] = (l === r);
    var leftEl = itemAt('L', l), rightEl = itemAt('R', r);
    c.querySelectorAll('.match-item.sel').forEach(function(x){ x.classList.remove('sel'); });
    if (state.ok[l]) {
      leftEl.classList.add('ok'); rightEl.classList.add('ok');
    } else {
      leftEl.classList.add('bad'); rightEl.classList.add('bad');
      setTimeout(function(){ leftEl.classList.remove('bad'); rightEl.classList.remove('bad'); }, 400);
    }
    state.sel = null;
    drawLinks();
    checkDone();
  });

  c.querySelector('[data-act="retry"]').addEventListener('click', function(){
    state = { sel: null, links: {}, ok: {} };
    c.querySelectorAll('.match-item').forEach(function(x){ x.className = 'match-item'; });
    c.querySelector('.mq-done').textContent = '';
    drawLinks();
  });
  window.addEventListener('resize', drawLinks);
}

// ===== 六年级仿真通用绘图库（每课 course.js 前缀） =====
var SIM_W = 880, SIM_H = 360;
var SIM_FONT = '"Microsoft YaHei","Noto Sans SC",sans-serif';

function simCtx() { return document.getElementById('simCanvas').getContext('2d'); }

function simTxt(t, x, y, size, color, weight, align) {
  var ctx = simCtx();
  ctx.save();
  ctx.font = (weight ? weight + ' ' : '') + size + 'px ' + SIM_FONT;
  ctx.fillStyle = color;
  ctx.textAlign = align || 'left';
  ctx.fillText(t, x, y);
  ctx.restore();
}

function simLine(x1, y1, x2, y2, color, w, dash) {
  var ctx = simCtx();
  ctx.save();
  ctx.strokeStyle = color; ctx.lineWidth = w || 1.6; ctx.lineCap = 'round';
  if (dash) ctx.setLineDash(dash);
  ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
  ctx.restore();
}

function simBox(x, y, w, h, fill, stroke, r) {
  var ctx = simCtx();
  r = (r === undefined) ? 8 : r;
  if (r > Math.min(w, h) / 2) r = Math.min(w, h) / 2;
  ctx.save();
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
  if (fill) { ctx.fillStyle = fill; ctx.fill(); }
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1.6; ctx.stroke(); }
  ctx.restore();
}

function simDot(x, y, r, fill, stroke) {
  var ctx = simCtx();
  ctx.save();
  ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2);
  ctx.fillStyle = fill; ctx.fill();
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1.4; ctx.stroke(); }
  ctx.restore();
}

function simArc(cx, cy, r, a0, a1, fill, stroke, w) {
  var ctx = simCtx();
  ctx.save();
  ctx.beginPath(); ctx.moveTo(cx, cy);
  ctx.arc(cx, cy, r, a0, a1); ctx.closePath();
  if (fill) { ctx.fillStyle = fill; ctx.fill(); }
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = w || 1.6; ctx.stroke(); }
  ctx.restore();
}

function simRing(cx, cy, r, color, w, dash) {
  var ctx = simCtx();
  ctx.save();
  ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.strokeStyle = color; ctx.lineWidth = w || 1.6;
  if (dash) ctx.setLineDash(dash);
  ctx.stroke(); ctx.restore();
}

function simLog(msg) {
  var box = document.getElementById('simLog');
  if (!box) return;
  var d = document.createElement('div');
  d.className = 'sim-log-line'; d.innerHTML = msg;
  box.appendChild(d);
  if (box.children.length > 3) box.removeChild(box.firstChild);
  box.scrollTop = box.scrollHeight;
}

function simFrac(n, d) { return n + '/' + d; }
function simGcd(a, b) { while (b) { var t = a % b; a = b; b = t; } return a; }
function simReduce(n, d) { var g = simGcd(n, d); return [n / g, d / g]; }

// ===== 仿真：拖半径 —— 圆随半径变大，d = 2r 始终成立 =====
var SIM_CASES = [3, 4, 5, 6, 8];
var SIM = { ci: 0, r: 3 };

function simLabel() { return '半径 ' + SIM.r + ' 厘米'; }

function simDraw() {
  var ctx = simCtx();
  if (!ctx) return;
  ctx.clearRect(0, 0, SIM_W, SIM_H);
  ctx.save(); ctx.fillStyle = '#FCFEFF'; ctx.fillRect(0, 0, SIM_W, SIM_H); ctx.restore();

  simTxt('第 ' + (SIM.ci + 1) + ' 组 · ' + simLabel() + ' · 直径 ' + (2 * SIM.r) + ' 厘米',
         34, 34, 17, '#01579B', '700');
  simTxt('半径越大圆越大；圆心不动，位置就不变', 34, 58, 12.5, '#607D8B');

  var cx = 230, cy = 208;
  var px = 22;  // 每厘米对应像素
  var rad = SIM.r * px;

  // 辅助圆：上一个半径的虚线，体现「长大了」
  if (SIM.r > 3) {
    simRing(cx, cy, (SIM.r - 1) * px, '#B0BEC5', 1.4, [5, 4]);
    simTxt('上一档', cx - (SIM.r - 1) * px - 6, cy, 10, '#90A4AE', '', 'right');
  }

  // 圆
  simRing(cx, cy, rad, '#01579B', 2.6);
  simDot(cx, cy, 5, '#01579B');

  // 半径（多角度画 3 条，强调「无数条且都相等」）
  var angs = [0, -Math.PI / 3, Math.PI * 0.8];
  for (var i = 0; i < angs.length; i++) {
    var ex = cx + rad * Math.cos(angs[i]), ey = cy + rad * Math.sin(angs[i]);
    simLine(cx, cy, ex, ey, '#0288D1', 2);
    simDot(ex, ey, 3, '#0288D1');
  }
  simTxt('r', cx + rad * 0.55, cy - 8, 13, '#0288D1', '700');

  // 直径（水平）
  simLine(cx - rad, cy, cx + rad, cy, '#FFB300', 3);
  simDot(cx - rad, cy, 3.5, '#E65100');
  simDot(cx + rad, cy, 3.5, '#E65100');
  simTxt('d = 2r', cx, cy + rad + 22, 12.5, '#E65100', '700', 'center');
  simTxt('O', cx - 16, cy - 10, 12, '#01579B', '700');

  // 右侧结果面板
  simDrawPanel(cx, cy, rad);
  simRefresh();
}

function simDrawPanel(cx, cy, rad) {
  simBox(500, 84, 346, 262, '#FFFFFF', '#81D4FA', 10);
  simTxt('本组数据', 522, 112, 12, '#8D6E63');
  simTxt(simLabel(), 522, 142, 21, '#01579B', '700');
  simLine(522, 158, 824, 158, '#E1F5FE', 1.2);

  simTxt('直径', 522, 182, 12, '#8D6E63');
  simTxt('d = 2 × ' + SIM.r + ' = ' + (2 * SIM.r) + ' 厘米', 522, 208, 16, '#E65100', '700');
  simTxt('半径', 522, 234, 12, '#8D6E63');
  simTxt('r = d ÷ 2 = ' + SIM.r + ' 厘米', 522, 258, 14, '#01579B', '700');

  simLine(522, 274, 824, 274, '#E1F5FE', 1.2);
  simTxt('半径条数：无数条，且都相等', 522, 294, 12, '#37474F');
  simTxt('直径条数：无数条，且都相等', 522, 314, 12, '#37474F');
  simTxt('对称轴：无数条（直径所在直线）', 522, 332, 11.5, '#607D8B');
}

function simRefresh() {
  var ro = document.getElementById('simReadout');
  var tp = document.getElementById('simTip');
  if (ro) ro.textContent = '第 ' + (SIM.ci + 1) + ' 组 · ' + simLabel() +
    ' · 直径 ' + (2 * SIM.r) + ' 厘米';
  if (tp) tp.textContent = SIM.r >= 8 ? '到最大了，点「换一组」' : '点画布或「加大半径」继续';
}

function simGrow() {
  if (SIM.r >= 8) { simLog('半径最大演示到 8 厘米，点「换一组」'); return; }
  SIM.r++;
  simDraw();
  simLog('半径加到 <span class="hl">' + SIM.r + ' 厘米</span>，直径变成 ' + (2 * SIM.r) + ' 厘米');
}

function simRunAll() {
  SIM.r = 8;
  simDraw();
  simLog('一键到底：r = 8 厘米，d = <span class="hl">16 厘米</span>，仍是 2 倍');
}

function simNextCase() {
  SIM.ci = (SIM.ci + 1) % SIM_CASES.length;
  SIM.r = SIM_CASES[SIM.ci];
  simDraw();
  simLog('换一组：起始 <span class="hl">' + simLabel() + '</span>');
}

function simReset() {
  SIM.r = SIM_CASES[SIM.ci];
  simDraw();
  simLog('重来：回到本组起始半径');
}

function simCase() { return SIM.ci + '/' + SIM.r; }

function simBind() {
  var cv = document.getElementById('simCanvas');
  if (!cv || cv.__simBound) return;
  cv.__simBound = true;
  cv.addEventListener('click', function () { simGrow(); });
}
// ===== V4 总结页 =====
function toggleCardV4(card){ card.classList.toggle('expanded'); }
function expandAllV4(){ document.querySelectorAll('.summary-v4-card').forEach(function(c){ c.classList.add('expanded'); }); }
function collapseAllV4(){ document.querySelectorAll('.summary-v4-card').forEach(function(c){ c.classList.remove('expanded'); }); }

// ===== 初始显示 =====
var _urlPage = getPageParam('page');
var _initIdx = (_urlPage && PAGE_IDS.indexOf(_urlPage) >= 0) ? PAGE_IDS.indexOf(_urlPage) : 0;
showPage(_initIdx);

</script>
</body>
</html>
