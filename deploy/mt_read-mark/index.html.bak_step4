<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>圈画与批注：让笔在纸上停下来</title>
<style>
/* ===== 配色方案：从 references/color-schemes.md 选一个 :root 块 ===== */
:root {
  --primary: #2E5C4A; --primary-light: #3E7A62;
  --accent: #C0622F; --accent-soft: #FBE9DD;
  --ink: #2B2B28; --paper: #FBF8F0; --paper-2: #F3EDE0;
  --line: #DDD3BE; --green: #2E7D32; --red: #C62828;
  --shadow: 0 4px 16px rgba(46,92,74,.12);
}

/* ===== 课件配置块（所有常量集中声明） ===== */
/* IMG_PREFIX: 图片路径前缀，统一为 'img/'（图片放 deploy/img/ 子目录，部署后 URL 为 img/xxx.jpg） */
/* 不在 CSS 中声明，在 JS 中用 var IMG_PREFIX = 'img/'; */

/* ===== 基础样式 ===== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{overflow:hidden;height:100%}
body{
  font-family:"Noto Serif SC","Songti SC","Microsoft YaHei",serif;
  background:var(--paper);color:var(--ink);
  height:100dvh;overflow:hidden;position:relative;
  font-size:21px;line-height:1.65;
  display:flex;flex-direction:column;
}

/* ===== 导航条 ===== */
nav#topNav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  background:linear-gradient(135deg,var(--primary),var(--primary-light));
  padding:6px 12px;display:flex;align-items:center;gap:10px;
  flex-wrap:nowrap;overflow-x:auto;
  box-shadow:0 2px 12px rgba(0,0,0,.15);
  -webkit-overflow-scrolling:touch;
}
nav#topNav::-webkit-scrollbar{height:3px}
nav#topNav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.3);border-radius:2px}
nav#topNav .chip{
  flex-shrink:0;padding:5px 14px;border-radius:20px;
  background:rgba(255,255,255,.15);color:rgba(255,255,255,.8);
  font-size:16px;cursor:pointer;transition:all .25s;
  white-space:nowrap;border:1px solid transparent;font-weight:500;
}
nav#topNav .chip:hover{background:rgba(255,255,255,.25)}
nav#topNav .chip.active{
  background:var(--accent);color:#fff;font-weight:700;
  border-color:var(--accent);box-shadow:0 2px 8px rgba(255,143,0,.4);
}
/* 导航芯片类型样式 */
nav#topNav .chip.pre{background:rgba(255,143,0,.25);color:#fff}
nav#topNav .chip.mid{background:rgba(0,137,123,.25);color:#fff}
nav#topNav .chip.post{background:rgba(211,47,47,.25);color:#fff}
nav#topNav .chip.sim{background:rgba(21,101,192,.25);color:#fff}
nav#topNav .chip-end{background:rgba(255,255,255,.25);color:#fff}

/* ===== 进度条 ===== */
#progressWrap{
  position:fixed;top:44px;left:0;right:0;height:4px;z-index:201;
  background:rgba(0,0,0,.08);
}
#progressBar{
  height:100%;background:var(--accent);
  width:0%;transition:width .4s ease;border-radius:0 2px 2px 0;
}

/* ===== 翻页容器 ===== */
#pageContainer{flex:1;position:relative;overflow:hidden;margin-top:48px}

/* ===== 页面通用 ===== */
.page{
  position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;
  display:none;padding:32px 36px 40px;
  animation:fadeSlide .4s ease;
}
.page.active{display:block}
@keyframes fadeSlide{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
.page::-webkit-scrollbar{width:5px}
.page::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

/* ===== 全屏按钮：v2026-09-28e 定案「默认不放」 =====
   资料库外壳 sandbox 无 allow-fullscreen，网页代码达不到 F11 式真全屏；
   故骨架不放全屏按钮（HTML/CSS/JS 三件套一律不配）。
   课堂需要全屏时：引导用户直接按键盘 F11，或下载 HTML 直开。
   确需按钮的特殊场景 → 从 teaching-control.js 取三级降级实现（见 SKILL.md §3.6③）。 */

/* ===== 翻页按钮 ===== */
/* ⚠ !important 加固（v2026-09-29）：页码与翻页键必须恒在底部居中——
   实测部分课件会被其它 fixed/absolute 样式挤到左侧，全部属性加 !important 防挤占。 */
/* ⚠ z-index 500 顶层（v2026-10-13；v1.7.0 改两段式）：页码指示器是教师端入口第一击（1.5s 双击武装 + 点封面徽章），
   必须恒在页面内容/通信状态/揭示遮罩之上可点击。预留层级表见 workflow-dev.md §3.6④——
   页面内容元素 z-index 一律 ≤99，禁止与导航层（500）争层级。 */
#navBtns{
  position:fixed !important;bottom:20px !important;left:50% !important;
  right:auto !important;top:auto !important;transform:translateX(-50%) !important;
  display:flex !important;align-items:center;justify-content:center;gap:16px;z-index:500;
}
#navBtns button{
  width:48px;height:48px;border-radius:50%;border:2px solid var(--primary);
  background:var(--paper);color:var(--primary);font-size:22px;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:all .2s;box-shadow:var(--shadow);
}
#navBtns button:hover{background:var(--primary);color:#fff}
#navBtns button:disabled{opacity:.35;cursor:default}
#navBtns button:disabled:hover{background:var(--paper);color:var(--primary)}
#pageIndicator{font-size:20px;font-weight:700;color:var(--primary);min-width:80px;text-align:center}

/* ===== 封面页 =====
   注意：display:flex 必须写为 .page.active .cover-page（级联选择器，特异性 0,3,0），
   绝不能写 .cover-page.active、也绝不能裸写 .cover-page{display:flex}！
   原因：翻页系统 showPage() 只给 <section class="page"> 加/减 active 类，
   嵌套的 .cover-page div 永远没有 active 类 → .cover-page.active 永不匹配；
   裸写 .cover-page{display:flex} 则同特异性(0,1,0)下源码靠后覆盖 .page{display:none}，
   导致封面翻走后仍渲染（《价格理论》翻走后不消失、《氓》浅黄底+白字均源于此坑）。
   另：本规则必须自带深色 background 衬托白字 —— 否则白字落在浅色 --paper 上＝整页白底白字
   （《基尔霍夫定律》封面即此坑：技能内 page-templates.html 用内联渐变、而本骨架曾缺失，
   两份模板不一致；现已统一由本 CSS 提供默认深色底，任何配色下白字都有对比度）。 */
.page.active .cover-page{
  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;
  width:100%;height:100%;color:#fff;
  background:linear-gradient(135deg,rgba(0,0,0,.15),rgba(0,0,0,.35)),linear-gradient(135deg,var(--primary),var(--primary-light));
}
#p0{padding:0;overflow:hidden}
.cover-page h1{font-size:48px;font-weight:900;color:#fff;margin-bottom:12px;text-shadow:0 3px 12px rgba(0,0,0,.5)}
.cover-page .sub{font-size:24px;color:rgba(255,255,255,.9);margin-bottom:32px}
.cover-page .tags{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:36px}
.cover-page .tag{padding:8px 20px;border-radius:24px;background:rgba(255,143,0,.7);color:#fff;font-size:18px;font-weight:600}
.cover-page .hint{margin-top:40px;font-size:18px;color:rgba(255,255,255,.7)}

/* ===== 讲授页 ===== */
.teach-title{font-size:34px;font-weight:900;color:var(--primary);margin-bottom:24px;border-bottom:3px solid var(--accent);padding-bottom:10px}
.teach-text{font-size:21px;line-height:1.8;margin-bottom:20px}
.teach-text strong{color:var(--accent)}
.key-box{
  background:var(--paper-2);border-left:5px solid var(--accent);
  padding:16px 20px;border-radius:0 10px 10px 0;margin:16px 0;font-size:20px;
}
.key-box strong{color:var(--primary)}
.feature-list{list-style:none;padding:0}
.feature-list li{padding:10px 0 10px 32px;position:relative;font-size:20px;border-bottom:1px dashed var(--line)}
.feature-list li::before{content:'';position:absolute;left:4px;top:16px;width:12px;height:12px;border-radius:50%;background:var(--accent)}
.card-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0}
.card{background:var(--paper-2);border-radius:12px;padding:20px;border:1px solid var(--line);transition:all .25s}
.card:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.card h4{color:var(--primary);font-size:22px;margin-bottom:10px}
.card p{font-size:19px;line-height:1.7}
.highlight-num{
  display:inline-block;background:var(--accent);color:#fff;
  width:32px;height:32px;border-radius:50%;text-align:center;
  line-height:32px;font-size:18px;font-weight:700;margin-right:8px;
}

/* ===== 仿真页 ===== */
.sim-page{padding:24px 20px 40px}
.sim-title{font-size:30px;font-weight:900;color:var(--primary);margin-bottom:12px;text-align:center}
.sim-desc{text-align:center;font-size:19px;color:var(--primary-light);margin-bottom:20px}
.sim-controls{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;margin-bottom:8px}
.sim-controls label{font-size:19px;font-weight:600;color:var(--primary)}
.sim-controls input[type="range"]{width:200px;accent-color:var(--accent)}
.sim-controls input[type="range"]:focus{outline:none}
.sim-controls .val-display{font-size:20px;font-weight:700;color:var(--accent);min-width:80px;text-align:center}
.sim-canvas-wrap{display:flex;justify-content:center;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-top:8px}
.canvas-box{text-align:center}
.canvas-box canvas{border:2px solid var(--line);border-radius:12px;background:#fff;max-width:100%;height:auto}
.canvas-box .cap{font-size:18px;color:var(--primary);margin-top:6px;font-weight:600}

/* ===== 测验页 ===== */
.quiz-page{padding:28px 36px 48px}
.quiz-title{font-size:30px;font-weight:900;color:var(--primary);margin-bottom:20px;text-align:center}
.quiz-hint{font-size:18px;color:var(--primary-light);text-align:center;margin-bottom:24px}
.quiz-q{
  background:var(--paper-2);border-radius:14px;padding:20px 24px;
  margin-bottom:16px;border:2px solid var(--line);transition:border-color .3s;
}
.quiz-q.answered{border-color:var(--primary-light)}
.quiz-q .q-stem{font-size:21px;font-weight:700;color:var(--ink);margin-bottom:14px}
.quiz-q .opts{display:flex;flex-direction:column;gap:10px}
.quiz-q .opt{
  display:flex;align-items:center;gap:12px;padding:12px 16px;
  border-radius:10px;border:2px solid var(--line);cursor:pointer;
  transition:all .2s;font-size:20px;
}
.quiz-q .opt:hover{border-color:var(--accent);background:var(--accent-soft)}
.quiz-q .opt.selected{border-color:var(--accent);background:var(--accent-soft)}
.quiz-q .opt .badge{
  width:36px;height:36px;border-radius:50%;background:var(--primary-light);
  color:#fff;display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:18px;flex-shrink:0;
}
.quiz-q .opt.correct{border-color:var(--green);background:#e0f2f1}
.quiz-q .opt.correct .badge{background:var(--green)}
.quiz-q .opt.wrong{border-color:var(--red);background:#fbe9e7}
.quiz-q .opt.wrong .badge{background:var(--red)}
/* ⚠ v2026-09-29 定案「提交前可随时修改」：选项锁定挂 .submitted 前缀（submitQuiz 时加），
   .answered 只表示已作答、不锁——学生提交前可随时改选/重确认。禁止改回 .answered 前缀锁定。 */
.quiz-q.submitted .opt{pointer-events:none;opacity:.85}
.quiz-q.submitted .opt.correct{opacity:1}
.feedback{margin-top:12px;padding:12px 16px;border-radius:8px;font-size:19px;display:none;line-height:1.7}
.feedback.show{display:block;animation:fadeSlide .25s}
.feedback.correct-fb{background:#e0f2f1;border:1px solid var(--green);color:#004d40}
.feedback.wrong-fb{background:#fbe9e7;border:1px solid var(--red);color:#4e1a06}
.feedback .fb-icon{margin-right:8px;font-weight:700}
.quiz-actions{display:flex;justify-content:center;gap:12px;margin-top:28px;flex-wrap:wrap}
.quiz-actions button{padding:12px 32px;border-radius:30px;font-size:21px;font-weight:700;cursor:pointer;border:2px solid var(--accent);transition:all .2s}
.btn-submit{background:var(--accent);color:#fff;border-color:var(--accent)!important}
.btn-submit:hover{background:#e67e00;box-shadow:0 4px 12px rgba(255,143,0,.3)}
.btn-submit:disabled{background:#ccc;color:#999;border-color:#ccc!important;cursor:not-allowed;box-shadow:none}
.btn-retry{background:var(--paper);color:var(--primary)}
.btn-retry:hover{background:var(--paper-2)}
.quiz-score{text-align:center;font-size:24px;font-weight:700;color:var(--green);margin-top:20px;display:none}

/* ===== 总结页 ===== */
.summary-page{padding:28px 36px 48px}
.summary-title{font-size:34px;font-weight:900;color:var(--primary);margin-bottom:24px;text-align:center}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.summary-item{background:var(--paper-2);border-radius:14px;padding:20px;border-left:5px solid var(--accent)}
.summary-item h4{font-size:22px;color:var(--primary);margin-bottom:8px}
.summary-item p{font-size:19px;line-height:1.7}
.mantra{text-align:center;font-size:28px;font-weight:900;color:var(--accent);margin:24px 0;padding:20px;background:var(--paper-2);border-radius:14px}
.score-compare{display:flex;justify-content:center;align-items:center;gap:32px;margin:24px 0;flex-wrap:wrap}
.score-compare .sc{text-align:center;padding:20px 28px;background:var(--paper-2);border-radius:14px;min-width:140px}
.score-compare .sc .label{font-size:20px;color:var(--primary-light);margin-bottom:4px}
.score-compare .sc .val{font-size:36px;font-weight:900;color:var(--primary)}
.score-compare .sc .val.green{color:var(--green)}
.score-compare .arrow{font-size:40px;color:var(--accent);font-weight:900}

/* ===== 知识结构图（HTML可折叠树） ===== */
.mindmap .node{cursor:pointer;padding:10px 16px;border-radius:8px;border-left:4px solid var(--primary);margin:4px 0;background:var(--paper-2)}
.mindmap .branch{margin-left:24px}
.mindmap .branch.collapsed{display:none}
.mindmap .icon{margin-right:8px}
.mindmap .brief{display:block;font-size:14px;color:var(--primary-light);margin-top:4px}

/* ===== 响应式 ===== */
@media(max-width:768px){
  .page{padding:20px 16px 56px}
  .cover-page h1{font-size:32px}
  .cover-page .sub{font-size:20px}
  .teach-title{font-size:28px}
  .teach-text{font-size:20px}
  .card-grid{grid-template-columns:1fr}
  .sim-canvas-wrap{flex-direction:column;align-items:center}
  .sim-controls input[type="range"]{width:140px}
  nav#topNav{padding:4px 8px;gap:6px}
  nav#topNav .chip{padding:4px 10px;font-size:14px}
  #navBtns button{width:40px;height:40px;font-size:18px}
  /* v2026-10-13：收窄页码防 320px 窄屏与右下二维码徽章相碰；揭示提示条上移，
     为通信状态条（step4 注入，移动端 bottom:84px）让位 */
  #pageIndicator{min-width:56px;font-size:18px}
  #revealHint{bottom:124px}
  .quiz-q{padding:16px}
  .quiz-q .q-stem{font-size:20px}
  .quiz-q .opt{font-size:19px;padding:10px 12px}
  .summary-grid{grid-template-columns:1fr}
  .score-compare{gap:16px}
  .score-compare .sc{padding:14px 20px}
  .score-compare .sc .val{font-size:28px}
}

/* ===== 图文混排（有图有文页面必用，禁止把图堆到页面底部） ===== */
/* ⚠ v1.5.5 图文层叠铁律：图片恒在文字之上（含「图片先揭示、文字后揭示」）
   —— 浮动图用 float 时是脱离文档流的，后续文字块一旦因 transform（reveal 动画）
   或 position:relative 形成层叠上下文，就会整块画在图上，把图压住（文字背景条尤其明显）。
   因此 .fig / .reveal-img-group / .page-img 一律 position:relative + z-index:2，
   而页面内文字块（含背景条）层级不得 ≥2。 */
.clearfix::after{content:'';display:block;clear:both}
.fig{text-align:center;margin:8px 0;position:relative;z-index:2}
.fig img{width:100%;border-radius:12px;box-shadow:var(--shadow);border:1px solid var(--line)}
.fig .caption{font-size:16px;color:var(--primary-light);margin-top:4px;font-weight:600;line-height:1.5}
.fig.float-r{float:right;width:44%;margin-left:24px;margin-bottom:12px}
.fig.float-l{float:left;width:42%;margin-right:24px;margin-bottom:12px}
@media(max-width:768px){
  .fig.float-r,.fig.float-l{float:none;width:100%;margin:12px 0}
}
/* 图文组（img + caption 作为一步揭示）：整组同样压住文字块 */
.reveal-img-group{position:relative;z-index:2;isolation:isolate}
.reveal-img-group img{width:100%;border-radius:12px;box-shadow:var(--shadow);border:1px solid var(--line)}
.page-img{display:block;margin:20px auto;max-width:92%;height:auto;border-radius:12px;box-shadow:var(--shadow);border:1px solid var(--line);position:relative;z-index:2}
.img-caption{text-align:center;font-size:18px;color:var(--primary-light);margin-top:6px;font-weight:600}

/* ===== 全局滚动条 ===== */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

/* ===== 渐进呈现动画系统（24种） ===== */
/* 基础隐藏状态 */
.reveal-hidden{opacity:0;visibility:hidden;pointer-events:none}
.reveal-hidden.reveal-done{animation-fill-mode:forwards;visibility:visible;opacity:1;pointer-events:auto}
/* 揭示进度指示器 */
#revealHint{
  position:fixed;bottom:80px;left:50%;transform:translateX(-50%);z-index:140;
  display:none;align-items:center;gap:8px;
  background:rgba(200,16,46,.12);color:var(--primary);padding:6px 16px;
  border-radius:20px;font-size:16px;font-weight:600;
  pointer-events:none;transition:opacity .3s;
}
#revealHint .r-dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}
#revealHint .r-progress{color:var(--accent);font-weight:700}

/* A1: 淡入上浮 */
.reveal-fade-up{animation:fadeUp .5s cubic-bezier(.25,.46,.45,.94) both}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
/* A2: 打字机 — JS实现，此处仅光标样式 */
.reveal-typewriter .tw-cursor{border-right:2px solid var(--accent);animation:blink .8s infinite}
@keyframes blink{50%{border-color:transparent}}
/* A3: 段落逐现 — 配合 animation-delay */
.reveal-fade-up-seq{animation:fadeUp .5s cubic-bezier(.25,.46,.45,.94) both}
/* A4: 模糊聚焦 */
.reveal-blur-focus{animation:blurFocus .6s ease both}
@keyframes blurFocus{from{opacity:0;filter:blur(8px)}to{opacity:1;filter:blur(0)}}
/* A5: 高亮脉冲 */
.reveal-pulse{animation:highlightPulse .8s ease both}
@keyframes highlightPulse{0%{box-shadow:0 0 0 0 var(--accent-soft)}50%{box-shadow:0 0 16px 8px var(--accent-soft)}100%{box-shadow:0 0 0 0 var(--accent-soft)}}
/* A6: 字幕展开 */
.reveal-slide-x{animation:slideX .5s cubic-bezier(.25,.46,.45,.94) both}
@keyframes slideX{from{opacity:0;transform:scaleX(0);transform-origin:left}to{opacity:1;transform:scaleX(1)}}

/* B1: 列表逐条滑入 */
.reveal-li-slide{animation:liSlide .45s cubic-bezier(.25,.46,.45,.94) both}
@keyframes liSlide{from{opacity:0;transform:translateX(-30px)}to{opacity:1;transform:translateX(0)}}
/* B2: 编号步骤 — 圆圈弹入 */
.reveal-step-num .highlight-num{animation:popIn .45s cubic-bezier(.34,1.56,.64,1) both}
@keyframes popIn{from{transform:scale(0)}60%{transform:scale(1.2)}to{transform:scale(1)}}
.reveal-step-num.reveal-hidden .highlight-num{transform:scale(0)}
/* F1: 勾选清单（编号与 SKILL.md 动画目录一致） */
.reveal-check{animation:checkReveal .5s ease both}
@keyframes checkReveal{from{opacity:0;transform:translateX(-12px)}to{opacity:1;transform:translateX(0)}}
/* F2: 层级缩进展开（编号与 SKILL.md 动画目录一致） */
.reveal-indent{animation:indentExpand .45s ease both;overflow:hidden}
@keyframes indentExpand{from{opacity:0;max-height:0;padding-top:0;padding-bottom:0}to{opacity:1;max-height:200px}}

/* C1: 帷幕揭图 */
.reveal-curtain{position:relative;overflow:hidden}
.reveal-curtain img{display:block}
.reveal-curtain::before,.reveal-curtain::after{content:'';position:absolute;top:0;width:50%;height:100%;z-index:2;transition:transform .7s cubic-bezier(.7,0,.3,1)}
.reveal-curtain::before{left:0;background:var(--primary)}
.reveal-curtain::after{right:0;background:var(--primary)}
.reveal-curtain.reveal-hidden::before{transform:translateX(0)}
.reveal-curtain.reveal-hidden::after{transform:translateX(0)}
.reveal-curtain.reveal-done::before{transform:translateX(-100%)}
.reveal-curtain.reveal-done::after{transform:translateX(100%)}
/* C2: 底片显影 */
.reveal-sepia{animation:sepiaDevelop 1s ease both}
@keyframes sepiaDevelop{from{filter:sepia(1) brightness(.3)}to{filter:sepia(0) brightness(1)}}
/* C3: 框入聚焦 */
.reveal-focus-in{animation:focusIn .55s cubic-bezier(.34,1.56,.64,1) both}
@keyframes focusIn{from{opacity:0;transform:scale(.85)}60%{transform:scale(1.03)}to{opacity:1;transform:scale(1)}}
/* C4: 浮动入位 — 右浮图片专用 */
.reveal-float-in-r{animation:floatInR .5s cubic-bezier(.25,.46,.45,.94) both}
@keyframes floatInR{from{opacity:0;transform:translateX(60px)}to{opacity:1;transform:translateX(0)}}
.reveal-float-in-l{animation:floatInL .5s cubic-bezier(.25,.46,.45,.94) both}
@keyframes floatInL{from{opacity:0;transform:translateX(-60px)}to{opacity:1;transform:translateX(0)}}
/* C5: Ken Burns 慢移（持续） */
.reveal-kenburns img{animation:kenBurns 8s ease alternate infinite}
@keyframes kenBurns{from{transform:scale(1)}to{transform:scale(1.08) translate(-2%,-1%)}}

/* F3: 卡片翻转（编号与 SKILL.md 动画目录一致） */
.reveal-flip-card{perspective:800px}
.reveal-flip-card .flip-inner{transition:transform .6s;transform-style:preserve-3d}
.reveal-flip-card.reveal-done .flip-inner{transform:rotateY(180deg)}
.reveal-flip-card .flip-front,.reveal-flip-card .flip-back{backface-visibility:hidden;position:absolute;inset:0}
.reveal-flip-card .flip-back{transform:rotateY(180deg)}
/* D2: 卡片弹入 */
.reveal-card-pop{animation:cardPop .55s cubic-bezier(.34,1.56,.64,1) both}
@keyframes cardPop{from{opacity:0;transform:scale(.7)}60%{transform:scale(1.06)}to{opacity:1;transform:scale(1)}}
/* D3: 网格填充 — 配合 animation-delay */
.reveal-card-grid .card{animation:cardPop .55s cubic-bezier(.34,1.56,.64,1) both}
.reveal-card-grid.reveal-hidden .card{opacity:0;animation:none}
/* D4: 折叠展开 */
.reveal-fold{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.25,.46,.45,.94)}
.reveal-fold.reveal-done{max-height:600px}

/* E1: 关键框滑入 */
.reveal-slide-left{animation:slideLeft .5s cubic-bezier(.25,.46,.45,.94) both}
@keyframes slideLeft{from{opacity:0;transform:translateX(-60px)}to{opacity:1;transform:translateX(0)}}
.reveal-slide-right{animation:slideRight .5s cubic-bezier(.25,.46,.45,.94) both}
@keyframes slideRight{from{opacity:0;transform:translateX(60px)}to{opacity:1;transform:translateX(0)}}
/* E2: 引用金句 */
.reveal-quote{animation:quoteReveal .6s ease both}
@keyframes quoteReveal{from{opacity:0;transform:scale(.9)}40%{opacity:1;transform:scale(1.03)}to{opacity:1;transform:scale(1)}}
/* E3: 表格逐行 */
.reveal-tr-fade{animation:fadeUp .4s cubic-bezier(.25,.46,.45,.94) both}
/* E4: 数字跳动 — JS实现 */
.reveal-count-up{}
/* E5: 聚光灯 */
.reveal-spotlight{position:relative}
.reveal-spotlight::before{content:'';position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:300;transition:opacity .4s}
.reveal-spotlight.reveal-done::before{opacity:0;pointer-events:none}
.reveal-spotlight > *{position:relative;z-index:301}

/* ===== 图片全屏灯箱 ===== */
#imgLightbox{
  display:none;position:fixed;inset:0;z-index:9999;
  background:rgba(0,0,0,.92);justify-content:center;align-items:center;
  cursor:zoom-out;
}
#imgLightbox.show{display:flex}
#imgLightbox img{
  max-width:95vw;max-height:95vh;object-fit:contain;
  border-radius:8px;box-shadow:0 8px 40px rgba(0,0,0,.5);
  animation:lightboxIn .3s ease;
}
@keyframes lightboxIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
#imgLightbox .lb-close{
  position:absolute;top:20px;right:24px;width:44px;height:44px;
  border-radius:50%;background:rgba(255,255,255,.15);color:#fff;
  font-size:24px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  border:none;transition:background .2s;
}
#imgLightbox .lb-close:hover{background:rgba(255,255,255,.3)}
/* 图片可点击放大提示 */
.teach-text img, .fig img, .page-img, .card img{cursor:zoom-in;transition:opacity .2s}
.teach-text img:hover, .fig img:hover, .page-img:hover, .card img:hover{opacity:.85}

/* ===== 伪全屏兜底 CSS（第四代标准件 §3）=====
   默认不放「全屏按钮」，但下面三条规则必须保留——
   删了 pagesync-test-mqtt.js 的 S7 直接 FAIL；伪全屏时顶部导航须压课件层之上。 */
body.fs-pseudo #pageContainer{position:fixed;inset:0;z-index:9999}
body.fs-pseudo #topNav{z-index:10001 !important}
body.fs-pseudo #navBtns, body.fs-pseudo #mqttStatus{z-index:10000 !important}

/* ===== 底部导航胶囊（深色封面上也看得见页码） ===== */
#navBtns{background:rgba(245,248,251,.95);border-radius:34px;padding:5px 10px;box-shadow:0 6px 22px rgba(0,0,0,.18)}
#revealHint{bottom:98px}
#matchP3{max-width:780px;margin:0 auto}
.page{padding-bottom:104px}

/* ===== 表格（讲授页对比表） ===== */
.teach-table{width:100%;border-collapse:collapse;margin:18px 0;font-size:19px;background:#fff;border-radius:12px;overflow:hidden;box-shadow:var(--shadow)}
.teach-table th{background:var(--primary);color:#fff;padding:12px 14px;text-align:left;font-weight:700;font-size:17px}
.teach-table td{padding:12px 14px;border-bottom:1px solid var(--line)}
.teach-table tr:last-child td{border-bottom:none}
.teach-table td:first-child{font-weight:700;color:var(--primary)}

/* ===== 按钮 ===== */
.btn-retry,.btn-primary{padding:9px 24px;border-radius:22px;font-size:17px;font-weight:600;cursor:pointer;border:2px solid var(--primary);background:var(--paper);color:var(--primary);transition:all .2s;margin:6px 4px}
.btn-retry:hover,.btn-primary:hover{background:var(--primary);color:#fff}
.btn-primary:disabled{opacity:.5;cursor:default}

/* ===== 仿真读数 ===== */
.sim-readout{text-align:center;font-size:34px;font-weight:800;letter-spacing:2px;color:var(--primary);margin:12px 0 4px;font-variant-numeric:tabular-nums}
.sim-tip{text-align:center;font-size:18px;color:var(--primary-light);margin-bottom:10px;min-height:26px}

@media(max-width:768px){.page{padding-bottom:104px}}

/* ===== V4 模块卡片总结页 ===== */
.summary-v4-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:20px;margin-bottom:20px}
.summary-v4-card{background:#fff;border:2px solid var(--line);border-radius:16px;overflow:hidden;transition:all .35s;cursor:pointer}
.summary-v4-card:hover{border-color:var(--primary);box-shadow:0 4px 16px rgba(0,0,0,.08)}
.summary-v4-card.expanded{border-color:var(--primary);box-shadow:0 6px 24px rgba(0,0,0,.12);grid-column:span 2}
@media(max-width:700px){.summary-v4-card.expanded{grid-column:auto}}
.summary-v4-header{padding:22px 24px;display:flex;align-items:center;gap:16px;background:var(--paper-2);transition:background .3s}
.summary-v4-card.expanded .summary-v4-header{background:var(--paper)}
.summary-v4-num{width:44px;height:44px;border-radius:50%;background:var(--line);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:500;flex-shrink:0;transition:all .3s}
.summary-v4-card.expanded .summary-v4-num{background:var(--primary);color:#fff}
.summary-v4-title{font-size:24px;font-weight:700;color:var(--primary);flex:1}
.summary-v4-summary{font-size:18px;color:var(--primary-light);line-height:1.5}
.summary-v4-indicator{font-size:18px;color:var(--line);transition:transform .35s;flex-shrink:0}
.summary-v4-card.expanded .summary-v4-indicator{transform:rotate(180deg);color:var(--primary)}
.summary-v4-body{max-height:0;overflow:hidden;transition:max-height .5s ease}
.summary-v4-card.expanded .summary-v4-body{max-height:900px}
.summary-v4-inner{padding:0 20px 20px;display:flex;flex-direction:column;gap:14px}
.summary-v4-flip{perspective:600px;height:150px;cursor:pointer}
.summary-v4-flip-inner{position:relative;width:100%;height:100%;transition:transform .45s;transform-style:preserve-3d}
.summary-v4-flip.flipped .summary-v4-flip-inner{transform:rotateY(180deg)}
.summary-v4-flip-front,.summary-v4-flip-back{position:absolute;width:100%;height:100%;backface-visibility:hidden;border-radius:12px;display:flex;align-items:center;justify-content:center;padding:16px 18px;font-size:20px;line-height:1.6}
.summary-v4-flip-front{background:var(--accent-soft);border:2px solid var(--accent);color:var(--primary);font-weight:700;text-align:center;flex-direction:column}
.summary-v4-flip-front .fh{font-size:14px;color:var(--primary-light);font-weight:400;margin-top:6px}
.summary-v4-flip-back{background:#fff;border:2px solid var(--primary);color:var(--ink);text-align:left;transform:rotateY(180deg);overflow-y:auto;padding:16px 18px;font-size:17px}
@keyframes popIn{0%{transform:scale(.95);opacity:0}100%{transform:scale(1);opacity:1}}
.summary-v4-card.expanded{animation:popIn .3s ease}
.summary-v4-toolbar{display:flex;gap:12px;margin-bottom:16px}
.summary-v4-toolbar button{padding:8px 20px;border-radius:18px;font-size:16px;font-weight:600;cursor:pointer;border:2px solid var(--primary);background:var(--paper);color:var(--primary);transition:all .2s}
.summary-v4-toolbar button:hover{background:var(--primary);color:#fff}

.cover-page .tag{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);color:#FFF6E6}

#p2cards.card-grid{grid-template-columns:repeat(3,1fr)}
#p5cards.card-grid{grid-template-columns:repeat(3,1fr)}
#p2cards .card .eq,#p5cards .card .eq{font-size:17px;line-height:1.7}
.card .eq{font-size:18px;font-weight:800;color:var(--primary);margin:8px 0;line-height:1.55;white-space:pre-line}

.wrong-num{font-size:20px;font-weight:800;color:var(--red);margin:4px 0 8px;line-height:1.4}

.sim-readout{font-size:19px;font-weight:800;color:var(--primary)}
.sim-log .hl{color:var(--accent);font-weight:700}
.btn-primary{background:var(--primary);color:#fff;border:none}
.btn-primary:hover{background:var(--primary-light)}
.btn-retry{background:var(--paper);color:var(--primary);border:1.5px solid var(--accent)}

#p3fig svg,#p5fig svg,#p2fig svg{max-width:100%;height:auto}

@media (max-width:640px){
  #p2cards.card-grid,#p5cards.card-grid{grid-template-columns:1fr}
  .card .eq{font-size:16px}
  .wrong-num{font-size:17px}
  .cover-fig svg{width:100%;height:auto}
}

.sim-status{display:flex;justify-content:space-between;align-items:baseline;gap:18px;flex-wrap:wrap}
.sim-status .sim-readout{flex:1 1 auto}
.sim-status .sim-tip{flex:0 1 auto;text-align:right}

#matchP3 .match-item{padding:10px 14px;margin-bottom:9px;font-size:18px}
#matchP3 .match-col h4{margin-bottom:8px}

.sim-controls{flex-wrap:wrap}
.sim-log-line{padding:3px 0;font-size:13px;color:#455A64;border-bottom:1px dashed var(--line)}

#p6 .feature-list{margin-top:10px}
#p6 .feature-list li{font-size:14px;line-height:1.6;margin:4px 0}
#p6 .canvas-box canvas{max-height:272px;width:auto;display:block;margin:0 auto}
#p6 .sim-desc{font-size:14px;line-height:1.6;margin:4px auto 8px;max-width:760px}
#p6 .sim-log{max-height:58px;overflow:auto}

/* 封面 SVG 必须有固有宽度，否则 shrink-to-fit 会算成 0 */
.cover-fig{width:min(760px,88%);margin:14px auto 0}
.cover-fig svg{display:block;width:100%;height:auto}

/* 内容密集页：隐藏辅助卡片，把关键控件压进一屏，避免被固定导航遮住 */
#p2 .card-grid,#p3 .card-grid,#p5 .card-grid,#p8 .card-grid{display:none}
#p2 .teach-title,#p3 .teach-title,#p5 .teach-title,#p8 .teach-title{font-size:23px;margin:6px 0 8px}
#p2 .teach-text,#p3 .teach-text,#p5 .teach-text,#p8 .teach-text{font-size:15px;line-height:1.6;margin:4px 0}
#p2 .feature-list li,#p3 .feature-list li,#p8 .feature-list li{font-size:14px;line-height:1.5;margin:2px 0}
#p2 .key-box,#p3 .key-box,#p5 .key-box,#p8 .key-box{padding:9px 12px;margin-top:8px}
#p2fig,#p3fig,#p5fig{width:205px}
#p6 .canvas-box canvas{max-height:272px;width:auto;display:block;margin:0 auto}

/* 通用小控件 */
.mini-btn{display:inline-block;background:var(--primary);color:#fff;border:none;border-radius:8px;
  padding:6px 12px;font-size:13px;cursor:pointer;font-family:inherit}
.mini-btn.ghost{background:#fff;color:var(--primary);border:1.5px solid var(--accent)}
.mini-btn:hover{opacity:.88}
.trace-note{font-weight:700;color:var(--primary);margin:6px 0;font-size:14px}
.trace-why{min-height:34px;font-size:13px;line-height:1.6;background:#fff;border-radius:8px;
  padding:7px 10px;margin:5px 0}

/* 起疑 p2 */
.rd-text{font-size:16px;line-height:1.9;background:#fff;border-radius:10px;padding:10px 13px;border:1px solid var(--line)}
.rd-s{display:block;padding:5px 7px;margin:3px 0;border-radius:7px;cursor:pointer;border-left:3px solid transparent}
.rd-s:hover{background:#F5F0E4}
.rd-s.stopped{background:#ECEFF1;color:#607D8B;border-left-color:#90A4AE}

/* 取证 p3 */
.ev-syms{margin:6px 0}
.ev-sym{background:#fff;border:1.5px solid var(--line);border-radius:999px;padding:4px 11px;
  margin:2px 5px 2px 0;font-size:13px;cursor:pointer;font-family:inherit;color:#4A463E}
.ev-sym:hover{border-color:var(--accent)}
.ev-sym.on{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:700}
.ev-text{font-size:15px;line-height:1.85;background:#fff;border-radius:10px;padding:9px 12px;border:1px solid var(--line)}
.ev-s{display:block;padding:4px 6px;margin:2px 0;border-radius:6px;cursor:pointer}
.ev-s:hover{background:#F5F0E4}
.ev-s.marked{background:#FFF2C9;border-left:3px solid #E0A93B}
.ev-badge{font-style:normal;color:var(--accent);font-weight:800;margin-left:6px}
.ev-idea{width:100%;box-sizing:border-box;border:1.5px dashed var(--accent);border-radius:8px;
  padding:7px 10px;font-size:15px;font-family:inherit;margin-top:6px}
.ev-idea:focus{outline:none;border-style:solid}

/* 对齐 p5 */
.al-cards,.al-slots{display:flex;gap:7px;flex-wrap:wrap;margin:5px 0}
.ev-card{flex:1 1 210px;background:#fff;border:1.5px solid var(--line);border-radius:9px;
  padding:7px 9px;font-size:13px;line-height:1.5;cursor:pointer}
.ev-card:hover{border-color:var(--accent)}
.ev-card.on{background:#FFF2C9;border-color:#E0A93B}
.ev-card > b{color:var(--primary);font-size:12px}
.ev-slot{flex:1 1 210px;min-height:56px;background:#EDF3EE;border:1.5px dashed #8FB9A3;
  border-radius:9px;padding:6px 8px;font-size:12px}
.ev-slot[data-slot="X"]{background:#FBE9DD;border-color:var(--accent)}
.ev-slot > b{display:block;color:var(--primary);font-size:13px;margin-bottom:3px}
.ev-slot .ev-card{margin-top:4px;flex:1 1 auto;font-size:12px}
.ev-paras{margin-top:4px}
.ev-para{display:inline-block;border:1px solid var(--line);border-radius:6px;background:#fff;
  padding:2px 7px;margin:2px 4px 0 0;font-size:11px;cursor:pointer;color:#4A463E}
.ev-para:hover{border-color:var(--accent)}
.ev-para.on{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:700}

/* 换文 p8 */
.tr-text{font-size:15px;line-height:1.85;background:#fff;border-radius:10px;padding:9px 12px;border:1px solid var(--line)}
.tr-s{display:block;padding:4px 6px;margin:2px 0;border-radius:6px;cursor:pointer;border-bottom:2px solid transparent}
.tr-s:hover{background:#F5F0E4}
.tr-s.marked{border-bottom-color:var(--accent);background:#FBE9DD}
.tr-cks{margin:7px 0 3px}
.tr-ck{display:inline-block;background:#fff;border:1.5px solid var(--line);border-radius:8px;
  padding:5px 10px;margin:3px 6px 0 0;font-size:12px;cursor:pointer;color:#4A463E}
.tr-ck:hover{border-color:var(--accent)}
.tr-ck.on{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:700}
.my-chain{background:#fff;border:1.5px dashed var(--accent);border-radius:12px;
  padding:12px 15px;font-size:16px;line-height:1.8;margin:12px 0}

/* p6 底部说明压进一屏 */
#p6 .sim-desc{font-size:13px;line-height:1.5;margin:3px auto 6px}
#p6 .feature-list{margin-top:6px}
#p6 .feature-list li{font-size:13px;line-height:1.45;margin:2px 0}
#p6 .sim-log{max-height:28px}
#p6 .feature-list{margin-top:3px}
#p6 .feature-list li{margin:1px 0}
#p6 .sim-controls{margin:4px 0}
#p6 .sim-page{padding-bottom:18px}
</style>
</head>
<body>

<!-- ===== 顶部导航 ===== -->
<!-- 每个chip: class="chip" + 类型样式(pre/mid/post/sim) + data-page序号 -->
<nav id="topNav">
  <span class="chip active" data-page="0">封面</span>
  <span class="chip pre" data-page="1">前测</span>
  <span class="chip" data-page="2">起疑</span>
  <span class="chip" data-page="3">取证</span>
  <span class="chip" data-page="4">连一连</span>
  <span class="chip mid" data-page="5">中测1</span>
  <span class="chip" data-page="6">对齐</span>
  <span class="chip sim" data-page="7">说清</span>
  <span class="chip mid" data-page="8">中测2</span>
  <span class="chip" data-page="9">换文</span>
  <span class="chip post" data-page="10">后测</span>
  <span class="chip chip-end" data-page="11">存起来</span>
</nav>

<!-- ===== 进度条 ===== -->
<!-- ===== 进度条 ===== -->
<div id="progressWrap"><div id="progressBar"></div></div>

<!-- ===== 页面容器 ===== -->
<div id="pageContainer">

<!-- ===== p0: 封面 ===== -->
<section class="page active" id="p0" data-cw="skill">
<div class="cover-page" style="height:100%">
  <h1>圈画与批注：让笔在纸上停下来</h1>
  <p class="sub">三年级语文 · 阅读方法</p>
  <div class="tags">
    <span class="tag">语文要素·阅读</span>
    <span class="tag">辨析</span>
    <span class="tag">2022课标</span>
    <span class="tag">一条依据链</span>
  </div>
  <div class="cover-fig">
<svg viewBox="0 0 760 190" width="760" height="190" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="从划一句到连成依据链">
  <rect x="0" y="0" width="760" height="190" rx="18" fill="#FFFFFF" opacity=".10"/>
  <text x="28" y="30" font-size="15" fill="#F3EDE0" font-weight="700">读进去留下的不是分数，是一条能指回原文的依据链</text>
  <rect x="28" y="48" width="300" height="112" rx="12" fill="#EDF3EE" stroke="#8FB9A3"/>
  <text x="44" y="74" font-size="13" fill="#2E5C4A" font-weight="700">文中写的（划下来）</text>
  <text x="44" y="100" font-size="15" fill="#4A463E">○ 关键词　□ 人物　～ 好句　？ 不懂</text>
  <text x="44" y="128" font-size="14" fill="#4A463E">它歪着头，一动不动……</text>
  <text x="352" y="104" font-size="26" fill="#FFC48A">⟶</text>
  <rect x="392" y="48" width="340" height="112" rx="12" fill="#FBE9DD" stroke="#C0622F"/>
  <text x="408" y="74" font-size="13" fill="#C0622F" font-weight="700">我想的（说清楚）</text>
  <text x="408" y="100" font-size="15" fill="#4A463E">因为第 1 段那句，所以我认为它很小心</text>
  <text x="408" y="128" font-size="14" fill="#4A463E">旁批 ≤ 10 字，且用上刚圈的词</text>
</svg>
  </div>
</div>
</section>

<section class="page" id="p1">
<div class="quiz-page" id="quizPre">
  <h2 class="quiz-title">前测 · 先看看你手里的四个符号</h2>
  <p class="quiz-hint">三道题都有唯一答案，答错会告诉你错在哪。</p>

  <div class="quiz-q" id="qq_quizPre_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 「○」在圈画批注里通常表示什么？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>圈出关键词</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>框出人物</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>标出不懂</div>
    </div>
    <div class="feedback" id="fb_quizPre_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizPre_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 旁批写在句子旁边，最该做到哪一点？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>抄下整句话</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>不超过 10 个字，且用上刚圈的词</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>写得越长越好</div>
    </div>
    <div class="feedback" id="fb_quizPre_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizPre_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. 「想法要能落回原文」，意思是？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>把原文背下来</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>把原文抄一遍</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>能指出是从第几句看出来的</div>
    </div>
    <div class="feedback" id="fb_quizPre_2"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizPre')">重做</button>
  </div>
  <span id="preScore" class="quiz-score"></span>
</div>
</section>

<!-- ===== p2: 起疑 · 138 个字里，你在哪儿停了一下？ ===== -->
<section class="page" id="p2">
<h2 class="teach-title">起疑 · 138 个字里，你在哪儿停了一下？</h2>

<div class="clearfix">
  <div class="fig float-r" id="p2fig">
<svg viewBox="0 0 300 170" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="起疑与取证的分界">
  <rect x="8" y="12" width="284" height="66" rx="10" fill="#EDF3EE" stroke="#8FB9A3"/>
  <text x="22" y="36" font-size="14" fill="#2E5C4A" font-weight="700">起疑：点句子变灰</text>
  <text x="22" y="60" font-size="13" fill="#4A463E">「我在这儿停了一下」——落在整句上</text>
  <rect x="8" y="88" width="284" height="68" rx="10" fill="#FBE9DD" stroke="#C0622F"/>
  <text x="22" y="112" font-size="14" fill="#C0622F" font-weight="700">取证：选符号，点句子变黄</text>
  <text x="22" y="138" font-size="13" fill="#4A463E">○ 关键词　□ 人物　～ 好句　？ 不懂</text>
</svg>
  </div>

  <p class="teach-text" id="p2s1">
    先读一遍《窗台上的麻雀》，三段、约 138 字。读到哪句让你停了一下，就点那句，让它变灰。
  </p>
  <p class="teach-text" id="p2s2">
    灰的必须落在<b>整句</b>上，落在空白处不算。点哪句都行，<b>这里不判对错</b>。
  </p>
  <p class="teach-text" id="p2s3">
    这一步只做一件事：把「我读过、而且卡住过」留下来。想法还没写，依据也还没找，正常。
  </p>
</div>

<div class="card-grid" id="p2cards">
  <div class="card">
    <h4>起疑</h4>
    <div class="eq">点句子变灰</div>
    <p>读过并卡住过的整句。</p>
  </div>
  <div class="card">
    <h4>取证</h4>
    <div class="eq">选符号再划</div>
    <p>下一步才做。</p>
  </div>
  <div class="card">
    <h4>对齐</h4>
    <div class="eq">句卡归观点</div>
    <p>再下一步。</p>
  </div>
</div>

<div class="key-box" id="p2key">
  <div class="rd-text" id="rdText">
  <span class="rd-s" data-p="1">清晨，窗台上落了一只麻雀。它歪着头，一动不动，像在听屋里的动静。我把作业本翻到新的一页，没敢合上，怕纸响惊了它。</span>
  <span class="rd-s" data-p="2">我放下笔，屏住气。它忽然抖了抖翅膀，又停下来，小眼睛一直盯着玻璃。我想它大概饿了，可窗台上并没有半粒米。</span>
  <span class="rd-s" data-p="3">妈妈走过来说，别打扰它。后来我才明白，玻璃里映着它自己，它跟那个影子对望了整整一个早上。</span>
</div>
<div class="trace-why" id="rdNote">花 <b>20 秒</b>读一遍，点一句「我在这儿停了一下」。<b>点哪句都行，不判对错。</b></div>
</div>
</section>

<!-- ===== p3: 取证 · 想法要能指回第几句 ===== -->
<section class="page" id="p3">
<h2 class="teach-title">取证 · 想法要能指回第几句</h2>

<div class="clearfix">
  <div class="fig float-r" id="p3fig">
<svg viewBox="0 0 300 170" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="依据链的三个环节">
  <rect x="8" y="10" width="284" height="44" rx="9" fill="#FFFFFF" stroke="#DDD3BE"/>
  <text x="20" y="38" font-size="14" fill="#4A463E">① 我的想法写一句</text>
  <rect x="8" y="62" width="284" height="44" rx="9" fill="#EDF3EE" stroke="#8FB9A3"/>
  <text x="20" y="90" font-size="14" fill="#2E5C4A">② 回到原文划出支撑它的句子</text>
  <rect x="8" y="114" width="284" height="44" rx="9" fill="#FBE9DD" stroke="#C0622F"/>
  <text x="20" y="142" font-size="14" fill="#C0622F" font-weight="700">③ 因为……所以我认为……</text>
</svg>
  </div>

  <p class="teach-text" id="p3s1">
    先选一个符号，再点一句原文把它划黄；下边写一句「我的想法」。两样都留痕，就能往下走。
  </p>
  <p class="teach-text" id="p3s2">
    <b>划中不等于读懂</b>。这里只报「已取证几处、想法写没写」，不说「你懂了」，也不给分数。
  </p>
</div>

<ul class="feature-list" id="p3rules">
  <li>○ 圈关键词、□ 框人物、～ 画好句、？ 标不懂——四个符号各管一样。</li>
  <li>旁批 ≤ 10 字，且要用上刚圈的那个词，别抄整句。</li>
  <li>想法和依据分开记：想法框非空、且至少一处指回原文，才算留下痕迹。</li>
</ul>

<div class="key-box" id="p3key">
  <div id="evBox">
  <div class="ev-syms">
    <button class="ev-sym" type="button" data-s="○">○ 关键词</button>
    <button class="ev-sym" type="button" data-s="□">□ 人物</button>
    <button class="ev-sym" type="button" data-s="～">～ 好句</button>
    <button class="ev-sym" type="button" data-s="？">？ 不懂</button>
  </div>
  <div class="ev-text">
    <span class="ev-s" data-p="1">它歪着头，一动不动，像在听屋里的动静。<i class="ev-badge"></i></span>
    <span class="ev-s" data-p="1">我把作业本翻到新的一页，没敢合上，怕纸响惊了它。<i class="ev-badge"></i></span>
    <span class="ev-s" data-p="3">玻璃里映着它自己，它跟那个影子对望了整整一个早上。<i class="ev-badge"></i></span>
  </div>
  <input class="ev-idea" id="evIdea" placeholder="我的想法：写一句就够，比如「它其实很小心」">
  <div class="trace-why" id="evWhy">先选一个符号，再点一句原文把它划下来。</div>
  <div class="trace-note" id="evNote">已取证 0 处 · 想法还没写（只记痕迹，不判对错）</div>
</div>
</div>
</section>

<!-- ===== p3b: 连一连 ===== -->
<section class="page" id="p3b">
<h2 class="teach-title">连一连 · 符号和做法，各自留下什么</h2>
<p class="teach-text" id="p3bs1">左边是圈画批注里的做法，右边是它留下的痕迹。连完不用交卷，只看自己能不能说清「为什么」。</p>
<div class="match-wrap" id="matchP3"></div>
</section>

<section class="page" id="p4">
<div class="quiz-page" id="quizMid1">
  <h2 class="quiz-title">中测一 · 依据在哪，干扰句往哪放</h2>
  <p class="quiz-hint">三道题都有唯一答案，重点看「能不能指回原文」。</p>

  <div class="quiz-q" id="qq_quizMid1_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 读到「它歪着头，一动不动」，想批注「它很小心」，依据在哪？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>第 1 段这句</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>封面标题</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>插图里的颜色</div>
    </div>
    <div class="feedback" id="fb_quizMid1_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid1_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 「窗台上并没有半粒米」这句，对「麻雀饿了」这个想法？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>正好支撑</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>不支撑，也不支撑别的观点，可放进都不支撑筐</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>说明它飞走了</div>
    </div>
    <div class="feedback" id="fb_quizMid1_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid1_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. 下面哪一句是「批注」，不是「摘抄」？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>它歪着头，一动不动</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>清晨，窗台上落了一只麻雀</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>怕纸响惊了它 → 我也屏住气了</div>
    </div>
    <div class="feedback" id="fb_quizMid1_2"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizMid1')">重做</button>
  </div>
  <span id="mid1Score" class="quiz-score"></span>
</div>
</section>

<!-- ===== p5: 对齐 · 四张句卡，两个观点，一个筐 ===== -->
<section class="page" id="p5">
<h2 class="teach-title">对齐 · 四张句卡，两个观点，一个筐</h2>

<div class="clearfix">
  <div class="fig float-r" id="p5fig">
<svg viewBox="0 0 300 170" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="四张句卡两个观点槽一个都不支撑筐">
  <rect x="8" y="10" width="128" height="150" rx="10" fill="#FFFFFF" stroke="#DDD3BE"/>
  <text x="18" y="32" font-size="13" fill="#7A7263" font-weight="700">左：句卡 4 张</text>
  <text x="18" y="58" font-size="12" fill="#4A463E">3 张真 + 1 张干扰</text>
  <rect x="152" y="10" width="140" height="46" rx="9" fill="#EDF3EE" stroke="#8FB9A3"/>
  <text x="164" y="38" font-size="13" fill="#2E5C4A">观点 A</text>
  <rect x="152" y="62" width="140" height="46" rx="9" fill="#EDF3EE" stroke="#8FB9A3"/>
  <text x="164" y="90" font-size="13" fill="#2E5C4A">观点 B</text>
  <rect x="152" y="114" width="140" height="46" rx="9" fill="#FBE9DD" stroke="#C0622F"/>
  <text x="164" y="142" font-size="13" fill="#C0622F" font-weight="700">都不支撑筐</text>
</svg>
  </div>

  <p class="teach-text" id="p5s1">
    把 4 张句卡放进 2 个观点槽或「都不支撑」筐。观点数比句卡少，还有一张干扰句——别想一一对应。
  </p>
  <p class="teach-text" id="p5s2">
    放完<b>强制补一步</b>：点这张卡下面的「第几段」，把依据记下。<b>连线和依据分别记录</b>，都不判对错。
  </p>
</div>

<div class="card-grid" id="p5cards">
  <div class="card">
    <h4>3 真 + 1 干扰</h4>
    <div class="eq">右栏少于左栏</div>
    <p>必有「都不支撑」筐。</p>
  </div>
  <div class="card">
    <h4>多对一</h4>
    <div class="eq">一句可连多个观点</div>
    <p>破除一对一暗示。</p>
  </div>
  <div class="card">
    <h4>只说再读第 X 段</h4>
    <div class="eq">不给分数</div>
    <p>不说对错。</p>
  </div>
</div>

<div class="key-box" id="p5key">
  <div id="alBox">
  <div class="al-cards" id="alCards">
    <div class="ev-card" data-n="1"><b>句卡 1</b><br>它歪着头，一动不动，像在听屋里的动静。
      <div class="ev-paras"><span class="ev-para" data-p="1">第1段</span><span class="ev-para" data-p="2">第2段</span><span class="ev-para" data-p="3">第3段</span></div></div>
    <div class="ev-card" data-n="2"><b>句卡 2</b><br>我放下笔，屏住气。
      <div class="ev-paras"><span class="ev-para" data-p="1">第1段</span><span class="ev-para" data-p="2">第2段</span><span class="ev-para" data-p="3">第3段</span></div></div>
    <div class="ev-card" data-n="3"><b>句卡 3</b><br>怕纸响惊了它，我没敢合上作业本。
      <div class="ev-paras"><span class="ev-para" data-p="1">第1段</span><span class="ev-para" data-p="2">第2段</span><span class="ev-para" data-p="3">第3段</span></div></div>
    <div class="ev-card" data-n="4"><b>句卡 4（干扰）</b><br>窗台上并没有半粒米。
      <div class="ev-paras"><span class="ev-para" data-p="1">第1段</span><span class="ev-para" data-p="2">第2段</span><span class="ev-para" data-p="3">第3段</span></div></div>
  </div>
  <div class="al-slots">
    <div class="ev-slot" data-slot="A"><b>观点 A：它很小心，一直没飞走</b>把支撑它的句卡放进来</div>
    <div class="ev-slot" data-slot="B"><b>观点 B：「我」不想惊动它</b>把支撑它的句卡放进来</div>
    <div class="ev-slot" data-slot="X"><b>都不支撑筐</b>原文有、但不支撑任何观点的干扰句</div>
  </div>
  <div class="trace-why" id="alWhy">点一张卡，再点一个槽放进去；同一张卡可以连多个观点，放完还要补「我是根据第几句连的」。</div>
  <div class="trace-note" id="alNote">已归位 0 / 4 · 依据补了 0 / 4（连线和依据分别记，不判对错）</div>
</div>
</div>
</section>

<!-- ===== p6: 仿真 ===== -->
<section class="page" id="p6">
<div class="sim-page">
  <h2 class="sim-title">说清 · 把想法接回原文</h2>
  <p class="sim-desc">点左边一句原文，再点右边一个想法，连成一环。用「因为第 X 段那句，所以我认为……」说清——不给分数，只看想法能不能落回原文。</p>

  <div class="sim-status">
    <span class="sim-readout" id="simReadout">依据链已连 0 / 3 环（不判对错）</span>
    <span class="sim-tip" id="simTip">先自己试一次，再看老师连一条</span>
  </div>

  <div class="sim-controls">
    <button class="btn" onclick="simNextCase()">换一篇短文</button>
    <button class="btn" onclick="simReset()">重来</button>
    <button class="btn-primary" onclick="simDemo()">看老师连一条</button>
  </div>

  <div class="sim-canvas-wrap">
    <div class="canvas-box">
      <canvas id="simCanvas" width="880" height="360"></canvas>
      <p class="cap">左边是文中写的，右边是我想的；第三环「我猜错了」也算一条真痕迹</p>
    </div>
  </div>

  <div class="sim-log" id="simLog"></div>

  <ul class="feature-list" style="margin-top:14px">
    <li>一句原文能撑住多个想法；连错了换一篇重连就行。</li>
    <li>连线记「连没连」，依据另记「第几句」，两样分开留痕。</li>
    <li>对不上时只说「再读第 X 段」，不给分数、不说对错。</li>
  </ul>
</div>
</section>

<section class="page" id="p7">
<div class="quiz-page" id="quizMid2">
  <h2 class="quiz-title">中测二 · 为什么不能变成配对游戏</h2>
  <p class="quiz-hint">三道题都有唯一答案，注意「防退化」的三条硬规则。</p>

  <div class="quiz-q" id="qq_quizMid2_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 连线之后，为什么还要再点一次「我是根据第几句连的」？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>让连线和依据分别留痕，防止靠排除法蒙</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>为了凑时间</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>交卷时好看</div>
    </div>
    <div class="feedback" id="fb_quizMid2_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid2_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 右栏观点数比句卡少，还放了一张干扰句，是为了？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>让页面好看</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>防止用一一对应的排除法通关，一个字不读</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>减少题量</div>
    </div>
    <div class="feedback" id="fb_quizMid2_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid2_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. 换一篇没有提示的短文，只准用哪两样工具？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>选 A/B/C 和看分数</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>背和抄</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>划和连</div>
    </div>
    <div class="feedback" id="fb_quizMid2_2"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizMid2')">重做</button>
  </div>
  <span id="mid2Score" class="quiz-score"></span>
</div>
</section>

<!-- ===== p8: 换文 · 撤掉提示，只剩划和连 ===== -->
<section class="page" id="p8">
<h2 class="teach-title">换文 · 撤掉提示，只剩划和连</h2>

<div class="clearfix">
  <p class="teach-text" id="p8s1">
    换一篇没提示的短文《雨里的一把伞》，自己划、自己连，再对着三条标准自查。勾不满也能翻页。
  </p>
  <p class="teach-text" id="p8s2">
    顺手把四个<b>易错</b>点看一遍：别把「找中心句」当成读懂，别把关键词命中当成理解，别把批注写成摘抄，也别把「我猜错了」藏起来。
  </p>
</div>

<div class="card-grid" id="p8cards">
  <div class="card">
    <h4>① 指得出段</h4>
    <div class="eq">第几段</div>
    <p>依据能定位。</p>
  </div>
  <div class="card">
    <h4>② 说得出句</h4>
    <div class="eq">从哪句知道</div>
    <p>依据建立。</p>
  </div>
  <div class="card">
    <h4>③ 讲得出来</h4>
    <div class="eq">自己的话</div>
    <p>理解落地。</p>
  </div>
</div>

<div class="key-box" id="p8key">
  <div id="trBox">
  <div class="tr-text">
    <span class="tr-s">放学时雨下得很急。我把伞往同桌那边挪了挪，自己半边肩膀湿了一路。</span>
    <span class="tr-s">他一路都在讲笑话，没发现伞偏了。到家我才发现，书包里那本作业本倒是干的。</span>
  </div>
  <div class="trace-note" id="trNote">自发划了 0 处（不判对错）。换了一篇没提示的短文，工具条只剩「划」和「连」。</div>
  <div class="tr-cks">
    <span class="tr-ck">① 我能指出这句话在第几段</span>
    <span class="tr-ck">② 我能说出「我是从哪句话知道的」</span>
    <span class="tr-ck">③ 我能用自己的话讲一遍</span>
  </div>
  <div class="trace-why" id="trAdvice">自查勾不满也照样能翻页：这三条只问「能不能指回原文」，不问「读懂了没有」。</div>
</div>
</div>

<p class="teach-text" id="p8apply">
  这一页只问「能不能指回原文」，不问「读懂了没有」。关键词提到没提到可以查，理解到了没有，机器不下结论。
</p>
</section>

<section class="page" id="p9">
<div class="quiz-page" id="quizPost">
  <h2 class="quiz-title">后测 · 五道题，把阅读的边界说清楚</h2>
  <p class="quiz-hint">五道题都有唯一答案。做完这一页，你就知道哪些能判、哪些只能留痕。</p>

  <div class="quiz-q" id="qq_quizPost_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 关键词圈出来了，就一定说明读懂了吗？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>不一定，圈中不等于理解，还要说得出依据</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>一定，圈对就是懂了</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>看圈了几个</div>
    </div>
    <div class="feedback" id="fb_quizPost_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 「我猜错了」这条，要不要留着？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>删掉，别让人看见</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>要留，它也是一条真痕迹</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>改成我猜对了</div>
    </div>
    <div class="feedback" id="fb_quizPost_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. 批注里只写「很好」「很美」，问题在哪？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>字数太少</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>没用成语</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>没贴着原文的词，说不出依据在哪</div>
    </div>
    <div class="feedback" id="fb_quizPost_2"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_3">
    <p class="q-stem"><span class="q-type">单选题</span>4. 想法和原文对不上时，反馈该说什么？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>再读第 2 段，看看那句到底写了什么</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>你错了</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>0 分</div>
    </div>
    <div class="feedback" id="fb_quizPost_3"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_4">
    <p class="q-stem"><span class="q-type">单选题</span>5. 这一课最后要留下的是什么？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>一次答对几题</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>一条能指回原文的依据链</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>一张排行榜</div>
    </div>
    <div class="feedback" id="fb_quizPost_4"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizPost')">重做</button>
  </div>
  <span id="postScore" class="quiz-score"></span>
</div>
</section>

<!-- ===== p10: 总结 V4 ===== -->
<section class="page" id="p10">
<h2 class="teach-title">这一课，装进四张卡</h2>

<div class="summary-v4-toolbar">
  <button type="button" onclick="expandAllV4()">全部展开</button>
  <button type="button" onclick="collapseAllV4()">全部收起</button>
</div>

<div class="summary-v4-grid">
  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">1</div>
      <div style="flex:1">
        <div class="summary-v4-title">留下的是依据链，不是答对率</div>
        <div class="summary-v4-summary">想法 → 原文 → 说清</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>阅读课的产出物是一条能指回原文的依据链。</p>
      <p>能指出第几句、能用自己的话讲一遍，才叫读懂。</p>
    </div>
  </div>

  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">2</div>
      <div style="flex:1">
        <div class="summary-v4-title">四个符号，四种痕迹</div>
        <div class="summary-v4-summary">○ □ ～ ？</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>○ 关键词、□ 人物、～ 好句、？ 不懂，各管一样。</p>
      <p>旁批 ≤ 10 字且贴着刚圈的词，不抄整句。</p>
    </div>
  </div>

  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">3</div>
      <div style="flex:1">
        <div class="summary-v4-title">最容易翻车的三处</div>
        <div class="summary-v4-summary">一一对应 / 关键词命中 / 摘抄</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>右栏观点少于句卡、必有干扰句和「都不支撑」筐，破掉排除法。</p>
      <p>圈中不等于理解；批注写成摘抄，就等于没留下自己的想法。</p>
    </div>
  </div>

  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">4</div>
      <div style="flex:1">
        <div class="summary-v4-title">只给事实，不给判断</div>
        <div class="summary-v4-summary">再读第 X 段</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>想法对不上时只说「再读第 X 段」，不给分数不说对错。</p>
      <p>「我猜错了」要留着，它是依据链里最诚实的一环。</p>
    </div>
  </div>

</div>

<p class="teach-text" style="margin-top:18px">
  <div class="my-chain" id="myChain"><b>你留下的依据链</b>　（结算页会显示你在「取证」那一页写下的想法。）</div>
把这条依据链讲给同桌听：先说你的想法，再翻回原文指给他看是第几句。他指出不来的地方，就是你下次要补的那一环。
</p>
</section>
</div><!-- /pageContainer -->

<!-- ===== 渐进揭示提示条 ===== -->
<div id="revealHint"><span class="r-dot"></span>点击页面继续揭示 <span class="r-progress" id="revealProgress"></span></div>

<!-- ===== 图片全屏灯箱 ===== -->
<div id="imgLightbox" onclick="closeLightbox()">
  <button class="lb-close" onclick="closeLightbox()">✕</button>
  <img id="lbImg" src="" alt="全屏查看">
</div>

<!-- ===== 底部翻页按钮 ===== -->
<div id="navBtns">
  <button id="btnPrev" onclick="prevPage()" disabled>◀</button>
  <span id="pageIndicator">1/N</span>
  <button id="btnNext" onclick="nextPage()">▶</button>
</div>

<script>
// ⚠ 加载顺序：page-flip-system.js 必须最先（其中定义了 getPageParam，供 mqtt-framework/teaching-control 复用）
// 引用: references/templates/page-flip-system.js
// 引用: references/templates/quiz-engine.js
// 引用: references/templates/matching-quiz.js
// 引用: references/templates/canvas-engine-patterns.js
// 引用: references/templates/infographic-generator.js
// 各仿真和绘制函数按需添加...

// ===== 全屏：v2026-09-28e 定案「默认不放按钮」 =====
// 外壳 sandbox 无 allow-fullscreen，网页代码达不到 F11 式真全屏，故不放全屏按钮及其 JS。
// 需要全屏 → 用户按 F11 或直开 HTML；确需按钮 → 从 teaching-control.js 取三级降级实现。


// ===== 渐进呈现动画引擎 =====
// 使用方式：在 onPageEnter 中调用 setupReveal(pageId, [...]), 定义每步揭示的元素
// 每个 item: { sel: 'CSS选择器', anim: '动画class名', delay: 可选延迟ms }
// 学生在讲授页点击空白区域依次揭示

var pageRevealQueues = {};   // { p2: [{sel, anim, delay}, ...], ... }
var pageRevealIndex = {};    // { p2: 2, ... }
var pageRevealActive = {};   // { p2: true, ... }
var _revealPlaying = {};     // 上一步动画现场 { p2: {els, anim, t0, dur} }，用于连点快进

/* ---------- 视觉顺序（v1.5.5 新增）----------
   揭示顺序一律按「版面位置」判定：先上后下、同行先左后右，禁止依赖 DOM 书写顺序。
   原因：grid/flex 的 order、column-count 多列、绝对定位、模板套用都会让 DOM 顺序 ≠ 视觉顺序，
   于是出现「下面的比上面的先出现」「右面的比左边的先出现」。 */
function _revealSortEls(els) {
  var arr = Array.prototype.slice.call(els).map(function(el, i) { return { el: el, i: i }; });
  var TOL = 12; // 同一行的容差（px）：卡片行内 top 完全一致，容差只为吸收亚像素/阴影差
  arr.sort(function(a, b) {
    var ra = a.el.getBoundingClientRect(), rb = b.el.getBoundingClientRect();
    if (Math.abs(ra.top - rb.top) > TOL) return ra.top - rb.top;
    if (Math.abs(ra.left - rb.left) > TOL) return ra.left - rb.left;
    return a.i - b.i; // 位置相同 → 保持原序（稳定）
  });
  return arr.map(function(o) { return o.el; });
}

/* 一步揭示实际命中的元素（支持 item.children：容器内子元素逐个揭示） */
function _revealMatch(pageId, item) {
  var base = document.querySelectorAll('#' + pageId + ' ' + item.sel);
  if (item.children) {
    var out = [];
    Array.prototype.forEach.call(base, function(c) {
      out = out.concat(Array.prototype.slice.call(c.querySelectorAll(item.children)));
    });
    return out;
  }
  return Array.prototype.slice.call(base);
}

function setupReveal(pageId, items) {
  pageRevealQueues[pageId] = items;
  pageRevealIndex[pageId] = 0;
  pageRevealActive[pageId] = items.length > 0;
  _revealPlaying[pageId] = null;
  // 初始隐藏所有待揭示元素
  items.forEach(function(item) {
    var els = _revealMatch(pageId, item);
    if (!els.length) {
      console.warn('[reveal] 选择器未命中，该步会被跳过并导致后续顺序前移：#' + pageId + ' ' + item.sel);
    }
    els.forEach(function(el) { el.classList.add('reveal-hidden'); });
  });
  updateRevealHint(pageId);
}

/* 零配置揭示：页面内元素标 data-reveal 即可，队列按视觉顺序自动生成（推荐，永不乱序）
   用法：
     <p data-reveal>段落</p>                        → 淡入上浮（默认）
     <figure class="fig float-r" data-reveal="reveal-float-in-r">…</figure>
     <div data-reveal data-reveal-children=".card" data-reveal-seq="150">…卡片组…</div>
   属性：data-reveal=动画class / data-reveal-children=组内逐个元素 / data-reveal-seq / data-reveal-delay */
function setupRevealAuto(pageId) {
  var root = document.getElementById(pageId);
  if (!root) { console.warn('[reveal] 页面不存在：' + pageId); return; }
  var nodes = Array.prototype.slice.call(root.querySelectorAll('[data-reveal]'));
  // 嵌套去重：祖先已带 data-reveal 的节点不再单独入队
  nodes = nodes.filter(function(el) {
    var p = el.parentElement;
    while (p && p !== root) {
      if (p.hasAttribute && p.hasAttribute('data-reveal')) return false;
      p = p.parentElement;
    }
    return true;
  });
  nodes.forEach(function(el, i) {
    if (!el.hasAttribute('data-reveal-id')) el.setAttribute('data-reveal-id', pageId + 'RV' + i);
  });

  function build() {
    var ordered = _revealSortEls(nodes);   // 每次重建都按当前真实位置排序
    var items = ordered.map(function(el) {
      return {
        sel: '[data-reveal-id="' + el.getAttribute('data-reveal-id') + '"]',
        anim: el.getAttribute('data-reveal') || 'reveal-fade-up',
        children: el.getAttribute('data-reveal-children') || '',
        seqDelay: parseInt(el.getAttribute('data-reveal-seq'), 10) || 0,
        delay: parseInt(el.getAttribute('data-reveal-delay'), 10) || 0
      };
    });
    setupReveal(pageId, items);
  }
  build();

  // 若调用时页面还没完成布局（元素 rect 全为 0，例如 display:none 中提前建队列），
  // 下一帧按真实位置重排一次队列——否则退化成 DOM 顺序，正是「下面先出/右面先出」的根源。
  var unmeasurable = nodes.some(function(el) {
    var r = el.getBoundingClientRect();
    return r.width === 0 && r.height === 0;
  });
  if (unmeasurable) {
    requestAnimationFrame(function() {
      if (pageRevealIndex[pageId] === 0) build();
    });
  }
}

function nextReveal(pageId) {
  if (!pageRevealActive[pageId]) return;
  var queue = pageRevealQueues[pageId];
  var idx = pageRevealIndex[pageId];
  if (!queue || idx >= queue.length) return;

  // ① 连点快进（v1.5.5）：上一步动画尚未播完就点了下一步 → 直接把上一步定格到终态。
  //    否则两次动画时间轴交叠，会出现「后一步还停在透明度 0 已开始计时、前一步刚过半」的倒序错觉。
  var prev = _revealPlaying[pageId];
  if (prev) {
    var elapsed = Date.now() - prev.t0;
    if (prev.dur > 0 && elapsed < prev.dur) {
      prev.els.forEach(function(el) { el.classList.remove(prev.anim); });
    }
    _revealPlaying[pageId] = null;
  }

  var item = queue[idx];
  var els = _revealMatch(pageId, item);
  if (!els.length) {
    console.warn('[reveal] 选择器未命中，该步被跳过：#' + pageId + ' ' + item.sel);
  }
  // ② 组内揭示顺序 = 视觉顺序（上→下、左→右），与 querySelectorAll 的 DOM 顺序无关
  els = _revealSortEls(els);

  var delay = item.delay || 0;
  var seq = item.seqDelay || 0;
  els.forEach(function(el, i) {
    var d = delay + seq * i;
    el.style.animationDelay = d + 'ms';
    el.classList.add(item.anim);
    el.classList.add('reveal-done');
  });

  // ③ 记录本步动画时长（含组内错峰），供下一步连点快进判断
  var dur = 0;
  if (els.length) {
    var ad = '';
    try { ad = getComputedStyle(els[0]).animationDuration || '0s'; } catch (e) {}
    dur = parseFloat(ad) * 1000;
    if (!isFinite(dur) || dur <= 0 || dur > 5000) dur = 0; // 持续型（kenburns 8s 等）不快进
    else dur += delay + seq * Math.max(0, els.length - 1);
  }
  _revealPlaying[pageId] = { els: els, anim: item.anim, t0: Date.now(), dur: dur };

  pageRevealIndex[pageId]++;
  updateRevealHint(pageId);
  // 全部揭示完 → 隐藏提示条
  if (pageRevealIndex[pageId] >= queue.length) {
    pageRevealActive[pageId] = false;
  }
}

// 逆向回退：撤销上一步揭示（配合键盘箭头回退，见 SKILL.md「Progressive Reveal Animation System」章节）
function prevReveal(pageId) {
  var queue = pageRevealQueues[pageId];
  var idx = pageRevealIndex[pageId];
  if (!queue || idx <= 0) return;
  idx--;
  var item = queue[idx];
  var els = _revealMatch(pageId, item);
  els.forEach(function(el) {
    el.classList.remove(item.anim, 'reveal-done');
    el.classList.add('reveal-hidden');
    el.style.animationDelay = '';
    // 项目扩展：此处重置该元素内的 count-num / typewriter 等特殊效果
    // 完整版（含 _twTimer 中断）见 SKILL.md「Progressive Reveal Animation System」章节 prevReveal 完整代码
  });
  _revealPlaying[pageId] = null;
  pageRevealIndex[pageId] = idx;
  pageRevealActive[pageId] = true;
  updateRevealHint(pageId);
}

function updateRevealHint(pageId) {
  var hint = document.getElementById('revealHint');
  var progress = document.getElementById('revealProgress');
  var active = pageRevealActive[pageId];
  var queue = pageRevealQueues[pageId];
  if (!active || !queue) { hint.style.display = 'none'; return; }
  var idx = pageRevealIndex[pageId];
  var remain = queue.length - idx;
  if (remain <= 0) { hint.style.display = 'none'; return; }
  hint.style.display = 'flex';
  progress.textContent = (idx + 1) + '/' + queue.length + ' ←→';
}

// 讲授页全局点击 → 触发 nextReveal（排除链接、按钮、quiz-q 等交互元素）
document.addEventListener('click', function(e) {
  var pageEl = document.querySelector('.page.active');
  if (!pageEl) return;
  var pid = pageEl.id;
  if (!pageRevealActive[pid]) return;
  // 排除交互元素（含图片——图片点击触发灯箱而非揭示）
  var tag = e.target.tagName;
  if (tag === 'A' || tag === 'BUTTON' || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'IMG') return;
  if (e.target.closest('.quiz-q') || e.target.closest('.opt') ||
      e.target.closest('nav') || e.target.closest('#navBtns') || e.target.closest('.timeline-card') ||
      e.target.closest('.mindmap') || e.target.closest('#imgLightbox')) return;
  nextReveal(pid);
});

// 翻页时重置提示条状态
var _origShowPage = showPage;
showPage = function(i) {
  _origShowPage(i);
  var pid = PAGE_IDS[i];
  setTimeout(function() { updateRevealHint(pid); }, 100);
};

// ===== 图片全屏灯箱 =====
function openLightbox(src) {
  document.getElementById('lbImg').src = src;
  document.getElementById('imgLightbox').classList.add('show');
}
function closeLightbox() {
  document.getElementById('imgLightbox').classList.remove('show');
}
// 页面图片点击 → 全屏放大
document.addEventListener('click', function(e) {
  if (e.target.tagName === 'IMG' && !e.target.closest('#imgLightbox') && !e.target.closest('.qr-img-wrap')) {
    e.stopPropagation();
    openLightbox(e.target.src);
  }
});
// ESC 关闭灯箱
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    var lb = document.getElementById('imgLightbox');
    if (lb.classList.contains('show')) { closeLightbox(); e.preventDefault(); }
  }
});

var PAGE_IDS = ["p0", "p1", "p2", "p3", "p3b", "p4", "p5", "p6", "p7", "p8", "p9", "p10"];
var PAGE_LABELS = ["封面", "前测", "起疑", "取证", "连一连", "中测1", "对齐", "说清", "中测2", "换文", "后测", "存起来"];
var IMG_PREFIX = 'img/';
var curPage = 0;

// ===== 测验数据 =====
var QUIZZES = {
  quizPre: {
    questions: [
      { answer: 0, explain: "○ 圈关键词，□ 框人物，～ 画好句，？ 标不懂。四个符号各管一样，混用就分不清自己当时在想什么。" },
      { answer: 1, explain: "旁批不是摘抄。≤10 字、且和所划句的关键词重合，才算把想法钉在了原文上。" },
      { answer: 2, explain: "落回原文＝说得出「第几段哪一句」。背下来、抄一遍都没有建立依据关系。" }
    ]
  },
  quizMid1: {
    questions: [
      { answer: 0, explain: "依据只能是原文里那一句。标题、插图都不算「文中写的」，指不回第几句的想法没有根。" },
      { answer: 1, explain: "它确实在原文里，却不支撑任何一个观点——这就是干扰句。放进「都不支撑」筐，别硬塞。" },
      { answer: 2, explain: "前两句是原文照抄。第三句用自己的话接住了原文那个词，才是旁批。" }
    ]
  },
  quizMid2: {
    questions: [
      { answer: 0, explain: "左右能一一对应时，学生用排除法就能通关、一个字不读。连线与依据分开记，才逼着回原文。" },
      { answer: 1, explain: "观点数少于句卡数＋必有干扰句＋「都不支撑」筐，三样合起来破掉「一对一」的暗示。" },
      { answer: 2, explain: "换文这一段就是把提示全撤掉，只剩「划」和「连」。给选项、给分数都会退回到检索，不是理解。" }
    ]
  },
  quizPost: {
    questions: [
      { answer: 0, explain: "「提到没提到」可以查，「懂没懂」不能靠关键词命中推断。评价红线：只提示提到没提到，绝不说「你懂了」。" },
      { answer: 1, explain: "推想里敢写「我猜错了」是最有价值的一条。删掉它，依据链就少了「后来」那一环。" },
      { answer: 2, explain: "问题不是短，是空。它没贴住任何一个原文词，别人看不出你是从哪句得出的。" },
      { answer: 0, explain: "只说「再读第 X 段」，不给分数、不说对错。机器判错时学生改的往往是对的判断，开放表达永不给否定结论。" },
      { answer: 1, explain: "阅读课的产出物是依据链，不是答对率。能指出第几句、能用自己的话讲一遍，才叫读懂。" }
    ]
  }
};
// ===== 翻页系统 =====
function getPageParam(k) {
  try {
    var h = location.hash || '';
    if (h.indexOf(k + '=') >= 0) {
      var m1 = new RegExp('[#&]' + k + '=([^&#]*)').exec(h);
      if (m1) return decodeURIComponent(m1[1]);
    }
    var q = location.search || '';
    if (q.indexOf(k + '=') >= 0) {
      var m2 = new RegExp('[?&]' + k + '=([^&#]*)').exec(q);
      if (m2) return decodeURIComponent(m2[1]);
    }
    if (window.parent && window.parent !== window) {
      try {
        var psrc = (window.parent.location.hash || '') + '&' + (window.parent.location.search || '');
        if (psrc.indexOf(k + '=') >= 0) {
          var m3 = new RegExp('[#&?]' + k + '=([^&#]*)').exec(psrc);
          if (m3) return decodeURIComponent(m3[1]);
        }
      } catch (e) {}
    }
  } catch (e) {}
  return null;
}

function showPage(i) {
  if (i < 0 || i >= PAGE_IDS.length) return;
  var oldEl = document.querySelector('.page.active');
  if (oldEl) oldEl.classList.remove('active');
  var newEl = document.getElementById(PAGE_IDS[i]);
  if (newEl) { newEl.classList.add('active'); newEl.scrollTop = 0; }
  curPage = i;
  document.querySelectorAll('#topNav .chip').forEach(function(c, idx) {
    c.classList.toggle('active', idx === i);
  });
  document.getElementById('progressBar').style.width = ((i + 1) / PAGE_IDS.length * 100) + '%';
  document.getElementById('pageIndicator').textContent = (i + 1) + '/' + PAGE_IDS.length;
  document.getElementById('btnPrev').disabled = (i === 0);
  document.getElementById('btnNext').disabled = (i === PAGE_IDS.length - 1);
  onPageEnter(i);
  var activeChip = document.querySelector('#topNav .chip.active');
  if (activeChip && typeof activeChip.scrollIntoView === 'function') activeChip.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
}

function nextPage() { if (curPage < PAGE_IDS.length - 1) showPage(curPage + 1); }
function prevPage() { if (curPage > 0) showPage(curPage - 1); }

document.querySelectorAll('#topNav .chip').forEach(function(chip) {
  chip.addEventListener('click', function() {
    showPage(parseInt(this.getAttribute('data-page')));
  });
});

document.addEventListener('keydown', function(e) {
  var pid = PAGE_IDS[curPage];
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
    e.preventDefault();
    if (typeof pageRevealActive !== 'undefined' && pageRevealActive[pid] &&
        pageRevealQueues[pid] && pageRevealIndex[pid] < pageRevealQueues[pid].length) {
      nextReveal(pid);
    } else { nextPage(); }
  } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
    e.preventDefault();
    if (typeof pageRevealQueues !== 'undefined' && pageRevealQueues[pid] && pageRevealIndex[pid] > 0) {
      prevReveal(pid);
    } else { prevPage(); }
  }
});

var touchStartX = 0, touchStartY = 0;
document.addEventListener('touchstart', function(e) {
  touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY;
}, { passive: true });
document.addEventListener('touchend', function(e) {
  var dx = e.changedTouches[0].clientX - touchStartX;
  var dy = e.changedTouches[0].clientY - touchStartY;
  if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 60) {
    if (dx < 0) nextPage(); else prevPage();
  }
});

var pageEntered = {};
function onPageEnter(i) {
  var id = PAGE_IDS[i];
  if (pageEntered[id]) return;
  pageEntered[id] = true;
  if (id === 'p2') {
    setupReveal('p2', [
      { sel: '#p2s1', anim: 'reveal-fade-up' },
      { sel: '#p2fig', anim: 'reveal-float-in-r' },
      { sel: '#p2s2', anim: 'reveal-fade-up' },
      { sel: '#p2s3', anim: 'reveal-fade-up' },
      { sel: '#p2cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 110 },
      { sel: '#p2key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p3') {
    setupReveal('p3', [
      { sel: '#p3s1', anim: 'reveal-fade-up' },
      { sel: '#p3fig', anim: 'reveal-float-in-r' },
      { sel: '#p3s2', anim: 'reveal-fade-up' },
      { sel: '#p3rules', anim: 'reveal-fade-up' },
      { sel: '#p3key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p3b') {
    setupReveal('p3b', [{ sel: '#p3bs1', anim: 'reveal-fade-up' }]);
    initMatching('matchP3', [
      ['○ 圈出关键词', '最重要的那几个词'],
      ['□ 框出人物', '谁在做这件事'],
      ['～ 画出好句', '想再读一遍的句子'],
      ['？ 标出不懂', '回头要问的地方'],
      ['旁批 ≤ 10 字', '写在句子旁边，不抄整句'],
      ['旁批贴关键词', '批注里得有刚圈的词'],
      ['先读一遍再圈', '别一上来就动笔'],
      ['依据落在原文', '想法能指回第几句']
    ], { leftTitle: '做法 / 符号', rightTitle: '它留下的痕迹', onDone: function(){ var d=document.querySelector('#matchP3 .mq-done'); if(d) d.textContent='✓ 八处都归位了：四个符号、两条旁批规矩、两条依据规矩'; } });
  }
  if (id === 'p5') {
    setupReveal('p5', [
      { sel: '#p5s1', anim: 'reveal-fade-up' },
      { sel: '#p5fig', anim: 'reveal-float-in-r' },
      { sel: '#p5s2', anim: 'reveal-fade-up' },
      { sel: '#p5cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 120 },
      { sel: '#p5key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p6') { simBind(); simDraw(); }
  if (id === 'p8') {
    setupReveal('p8', [
      { sel: '#p8cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 120 },
      { sel: '#p8key', anim: 'reveal-fade-up' },
      { sel: '#p8apply', anim: 'reveal-fade-up' }
    ]);
  }

  if (id === 'p2') { bindDoubt(); }
  if (id === 'p3') { bindEvidence(); }
  if (id === 'p5') { bindAlign(); }
  if (id === 'p8') { bindTransfer(); }
  if (id === 'p10') { updateMyChain(); }
}

// ===== 测验引擎 =====
(function(){
  if (document.getElementById('quiz-engine-css')) return;
  var st = document.createElement('style');
  st.id = 'quiz-engine-css';
  st.textContent = [
    '.q-type{display:inline-block;font-size:14px;font-weight:700;padding:1px 10px;border-radius:12px;margin-right:8px;vertical-align:2px;background:var(--primary-light);color:#fff;letter-spacing:1px}',
    '.q-type.multi{background:var(--accent)}',
    '.opt-confirm{margin-top:10px;padding:7px 22px;border-radius:18px;font-size:16px;font-weight:600;cursor:pointer;border:2px solid var(--accent);background:var(--paper);color:var(--accent);transition:all .2s}',
    '.opt-confirm:hover{background:var(--accent);color:#fff}',
    '.quiz-q.submitted .opt-confirm{display:none}'
  ].join('\n');
  document.head.appendChild(st);
})();

function isMultiQ(q){ return !!(q && q.multi && Array.isArray(q.answer)); }
function sameIdxArr(a, b){
  if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
  for (var i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
  return true;
}
function ascArr(a){ return a.slice().sort(function(x, y){ return x - y; }); }
function isCorrectChoice(q, chosen){
  if (isMultiQ(q)) return sameIdxArr(chosen, ascArr(q.answer));
  return chosen === q.answer;
}
function idxInAnswer(q, j){
  return Array.isArray(q.answer) ? q.answer.indexOf(j) >= 0 : j === q.answer;
}
function idxInChosen(c, j){
  return Array.isArray(c) ? c.indexOf(j) >= 0 : c === j;
}
function quizScoreId(containerId){
  var s = String(containerId).replace(/^quiz/, '');
  return s.charAt(0).toLowerCase() + s.slice(1) + 'Score';
}

function initQuiz(quizId) {
  var container = document.getElementById(quizId);
  if (!container || !QUIZZES[quizId]) return;
  if (container._initialized) return;
  container._initialized = true;
  container._questions = QUIZZES[quizId].questions;
  container._chosen = container._questions.map(function(q){ return isMultiQ(q) ? null : -1; });
  container._picked = container._questions.map(function(q){ return isMultiQ(q) ? [] : null; });
  var isSubmitMode = false;

  container.querySelectorAll('.quiz-q').forEach(function(qq, qi) {
    var q = container._questions[qi];
    if (!q) return;
    var opts = qq.querySelectorAll('.opt');
    if (isMultiQ(q)) {
      opts.forEach(function(opt) {
        opt.addEventListener('click', function() {
          if (container._submitted) return;
          var idx = parseInt(this.getAttribute('data-idx'));
          var pos = container._picked[qi].indexOf(idx);
          if (pos >= 0) { container._picked[qi].splice(pos, 1); this.classList.remove('selected'); }
          else { container._picked[qi].push(idx); this.classList.add('selected'); }
        });
      });
      var btn = qq.querySelector('.opt-confirm');
      if (btn) btn.addEventListener('click', function() {
        if (container._submitted) return;
        if (container._picked[qi].length === 0) return;
        container._chosen[qi] = ascArr(container._picked[qi]);
        qq.classList.add('answered');
        if (!isSubmitMode) { showFeedback(quizId, qi); updateQuizScore(quizId); }
      });
    } else {
      opts.forEach(function(opt) {
        opt.addEventListener('click', function() {
          if (container._submitted) return;
          var idx = parseInt(this.getAttribute('data-idx'));
          container._chosen[qi] = idx;
          opts.forEach(function(o) { o.classList.remove('selected'); });
          this.classList.add('selected');
          qq.classList.add('answered');
          if (!isSubmitMode) { showFeedback(quizId, qi); updateQuizScore(quizId); }
        });
      });
    }
  });
}

function showFeedback(quizId, qi) {
  var container = document.getElementById(quizId);
  var q = container._questions[qi];
  var c = container._chosen[qi];
  var qq = document.getElementById('qq_' + quizId + '_' + qi);
  var fb = document.getElementById('fb_' + quizId + '_' + qi);
  if (!qq || !fb) return;
  var isCorrect = isCorrectChoice(q, c);
  fb.innerHTML = '<span class="fb-icon">' + (isCorrect ? '✓' : '✗') + '</span>' +
    (isCorrect ? '答对了。' : '再看一遍。') + q.explain;
  fb.className = 'feedback show ' + (isCorrect ? 'correct-fb' : 'wrong-fb');
  qq.querySelectorAll('.opt').forEach(function(o, j) {
    if (idxInAnswer(q, j)) o.classList.add('correct');
    if (!isCorrect && idxInChosen(c, j) && !idxInAnswer(q, j)) o.classList.add('wrong');
    o.style.pointerEvents = 'none';
  });
}

function updateQuizScore(quizId) {
  var container = document.getElementById(quizId);
  var total = container._questions.length;
  var done = 0, score = 0;
  container._questions.forEach(function(q, i) {
    var c = container._chosen[i];
    var answered = isMultiQ(q) ? (Array.isArray(c) && c.length > 0) : c >= 0;
    if (answered) { done++; if (isCorrectChoice(q, c)) score++; }
  });
  var scoreEl = document.getElementById(quizScoreId(quizId));
  if (scoreEl) {
    scoreEl.style.display = 'block';
    if (done === total) {
      scoreEl.innerHTML = '得分：' + score + '/' + total + ' &nbsp;&nbsp;' +
        (score === total ? '🌟 全部正确！' : score >= total * 0.6 ? '👍 不错，继续加油！' : '💪 回到前面再看一遍');
    } else {
      scoreEl.textContent = '已答：' + done + '/' + total + ' 正确：' + score;
    }
  }
  try { localStorage.setItem('xmn_' + quizId, JSON.stringify({ score: score, total: total, done: done })); } catch (e) {}
}

function retryQuiz(quizId) {
  var container = document.getElementById(quizId);
  if (!container) return;
  container._chosen = container._questions.map(function(q){ return isMultiQ(q) ? null : -1; });
  container._picked = container._questions.map(function(q){ return isMultiQ(q) ? [] : null; });
  container.querySelectorAll('.quiz-q').forEach(function(qq) {
    qq.classList.remove('answered');
    qq.querySelectorAll('.opt').forEach(function(o) {
      o.classList.remove('selected', 'correct', 'wrong');
      o.style.pointerEvents = 'auto';
    });
  });
  container.querySelectorAll('.feedback').forEach(function(fb) { fb.className = 'feedback'; fb.innerHTML = ''; });
  var el = document.getElementById(quizScoreId(quizId));
  if (el) el.style.display = 'none';
}

Object.keys(QUIZZES).forEach(function(k) { initQuiz(k); });

// ===== 连线题引擎 =====
(function(){
  var CSS = [
    '.match-wrap{position:relative;margin:14px 0}',
    '.match-cols{display:grid;grid-template-columns:1fr 1fr;gap:40px}',
    '.match-col h4{font-size:18px;color:var(--primary);margin-bottom:10px;text-align:center}',
    '.match-item{padding:14px 18px;margin-bottom:12px;border:2px solid var(--line);border-radius:12px;background:#fff;font-size:19px;cursor:pointer;transition:all .2s;text-align:center}',
    '.match-item:hover{border-color:var(--primary-light)}',
    '.match-item.sel{border-color:var(--accent);background:var(--accent-soft)}',
    '.match-item.ok{border-color:var(--green);background:#E8F5F3}',
    '.match-item.bad{border-color:var(--red);animation:shakeX .35s}',
    '@keyframes shakeX{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}',
    '.match-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}',
    '.mq-actions{text-align:center;margin-top:10px}',
    '.mq-actions button{padding:7px 22px;border-radius:18px;font-size:16px;font-weight:600;cursor:pointer;border:2px solid var(--primary);background:var(--paper);color:var(--primary)}',
    '.mq-done{text-align:center;font-size:18px;font-weight:700;color:var(--green);margin-top:8px;min-height:24px}'
  ].join('\n');
  var st = document.createElement('style');
  st.textContent = CSS;
  document.head.appendChild(st);
})();

function initMatching(containerId, pairs, options){
  options = options || {};
  var c = document.getElementById(containerId);
  if (!c || c._initialized) return;
  c._initialized = true;
  var list = pairs.map(function(p){ return Array.isArray(p) ? {left:p[0], right:p[1]} : p; });
  var order = list.map(function(_, i){ return i; });
  for (var i = order.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = order[i]; order[i] = order[j]; order[j] = t;
  }
  c.innerHTML =
    '<div class="match-wrap"><div class="match-cols">' +
      '<div class="match-col"><h4>' + (options.leftTitle || '左侧') + '</h4>' +
        list.map(function(p, k){ return '<div class="match-item" data-side="L" data-i="' + k + '">' + p.left + '</div>'; }).join('') +
      '</div>' +
      '<div class="match-col"><h4>' + (options.rightTitle || '右侧') + '</h4>' +
        order.map(function(k){ return '<div class="match-item" data-side="R" data-i="' + k + '">' + list[k].right + '</div>'; }).join('') +
      '</div>' +
    '</div><svg class="match-svg"></svg></div>' +
    '<div class="mq-actions"><button type="button" data-act="retry">重试</button></div>' +
    '<div class="mq-done"></div>';

  var wrap = c.querySelector('.match-wrap');
  var svg = c.querySelector('.match-svg');
  var state = { sel: null, links: {}, ok: {} };

  function itemAt(side, idx){ return c.querySelector('.match-item[data-side="' + side + '"][data-i="' + idx + '"]'); }

  function drawLinks(){
    var box = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + box.width + ' ' + box.height);
    svg.innerHTML = '';
    Object.keys(state.links).forEach(function(l){
      var a = itemAt('L', Number(l)), b = itemAt('R', state.links[l]);
      if (!a || !b) return;
      var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
      var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', ra.right - box.left);
      line.setAttribute('y1', ra.top + ra.height / 2 - box.top);
      line.setAttribute('x2', rb.left - box.left);
      line.setAttribute('y2', rb.top + rb.height / 2 - box.top);
      line.setAttribute('stroke', state.ok[l] ? '#00897B' : '#D84315');
      line.setAttribute('stroke-width', '3');
      line.setAttribute('stroke-linecap', 'round');
      svg.appendChild(line);
    });
  }

  function checkDone(){
    var total = list.length;
    var done = Object.keys(state.ok).filter(function(k){ return state.ok[k]; }).length;
    if (done === total) {
      c.querySelector('.mq-done').textContent = '✓ 全部连对，三根针的速度都记住了';
      if (options.onDone) options.onDone(done, total);
    }
  }

  c.addEventListener('click', function(e){
    var el = e.target.closest('.match-item');
    if (!el) return;
    var side = el.getAttribute('data-side');
    var idx = parseInt(el.getAttribute('data-i'), 10);
    if (el.classList.contains('ok')) return;

    if (!state.sel || state.sel.side === side) {
      c.querySelectorAll('.match-item.sel').forEach(function(x){ x.classList.remove('sel'); });
      state.sel = { side: side, idx: idx };
      el.classList.add('sel');
      return;
    }
    var l = side === 'L' ? idx : state.sel.idx;
    var r = side === 'R' ? idx : state.sel.idx;
    if (state.links[l] !== undefined) delete state.links[l];
    state.links[l] = r;
    state.ok[l] = (l === r);
    var leftEl = itemAt('L', l), rightEl = itemAt('R', r);
    c.querySelectorAll('.match-item.sel').forEach(function(x){ x.classList.remove('sel'); });
    if (state.ok[l]) {
      leftEl.classList.add('ok'); rightEl.classList.add('ok');
    } else {
      leftEl.classList.add('bad'); rightEl.classList.add('bad');
      setTimeout(function(){ leftEl.classList.remove('bad'); rightEl.classList.remove('bad'); }, 400);
    }
    state.sel = null;
    drawLinks();
    checkDone();
  });

  c.querySelector('[data-act="retry"]').addEventListener('click', function(){
    state = { sel: null, links: {}, ok: {} };
    c.querySelectorAll('.match-item').forEach(function(x){ x.className = 'match-item'; });
    c.querySelector('.mq-done').textContent = '';
    drawLinks();
  });
  window.addEventListener('resize', drawLinks);
}

// ===== 六年级仿真通用绘图库（每课 course.js 前缀） =====
var SIM_W = 880, SIM_H = 360;
var SIM_FONT = '"Microsoft YaHei","Noto Sans SC",sans-serif';

function simCtx() { return document.getElementById('simCanvas').getContext('2d'); }

function simTxt(t, x, y, size, color, weight, align) {
  var ctx = simCtx();
  ctx.save();
  ctx.font = (weight ? weight + ' ' : '') + size + 'px ' + SIM_FONT;
  ctx.fillStyle = color;
  ctx.textAlign = align || 'left';
  ctx.fillText(t, x, y);
  ctx.restore();
}

function simLine(x1, y1, x2, y2, color, w, dash) {
  var ctx = simCtx();
  ctx.save();
  ctx.strokeStyle = color; ctx.lineWidth = w || 1.6; ctx.lineCap = 'round';
  if (dash) ctx.setLineDash(dash);
  ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
  ctx.restore();
}

function simBox(x, y, w, h, fill, stroke, r) {
  var ctx = simCtx();
  r = (r === undefined) ? 8 : r;
  if (r > Math.min(w, h) / 2) r = Math.min(w, h) / 2;
  ctx.save();
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
  if (fill) { ctx.fillStyle = fill; ctx.fill(); }
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1.6; ctx.stroke(); }
  ctx.restore();
}

function simDot(x, y, r, fill, stroke) {
  var ctx = simCtx();
  ctx.save();
  ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2);
  ctx.fillStyle = fill; ctx.fill();
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1.4; ctx.stroke(); }
  ctx.restore();
}

function simArc(cx, cy, r, a0, a1, fill, stroke, w) {
  var ctx = simCtx();
  ctx.save();
  ctx.beginPath(); ctx.moveTo(cx, cy);
  ctx.arc(cx, cy, r, a0, a1); ctx.closePath();
  if (fill) { ctx.fillStyle = fill; ctx.fill(); }
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = w || 1.6; ctx.stroke(); }
  ctx.restore();
}

function simRing(cx, cy, r, color, w, dash) {
  var ctx = simCtx();
  ctx.save();
  ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.strokeStyle = color; ctx.lineWidth = w || 1.6;
  if (dash) ctx.setLineDash(dash);
  ctx.stroke(); ctx.restore();
}

function simLog(msg) {
  var box = document.getElementById('simLog');
  if (!box) return;
  var d = document.createElement('div');
  d.className = 'sim-log-line'; d.innerHTML = msg;
  box.appendChild(d);
  if (box.children.length > 3) box.removeChild(box.firstChild);
  box.scrollTop = box.scrollHeight;
}

function simFrac(n, d) { return n + '/' + d; }
function simGcd(a, b) { while (b) { var t = a % b; a = b; b = t; } return a; }
function simReduce(n, d) { var g = simGcd(n, d); return [n / g, d / g]; }

// ===== 阅读课样板 mt_read-mark「圈画与批注」：仿真与「留痕迹」互动 =====
// 设计依据：chinese-reading-writing.md 阅读五段（起疑→取证→对齐→说清→换文）
// 红线：只判「有没有痕迹、依据在哪」，不判「好不好」；关键词命中 ≠ 理解；
//       开放表达永不给否定结论；连线与依据分别记录，防止一一对应排除法。
// 仿真页是「依据链工作台」：点左边原文句 → 点右边想法 → 连成一环，不给分数。

var CN_CASES = [
  {
    name: '窗台上的麻雀',
    lines: [
      { p: 1, t: '它歪着头，一动不动，像在听屋里的动静。' },
      { p: 1, t: '我把作业本翻到新的一页，没敢合上，怕纸响惊了它。' },
      { p: 3, t: '玻璃里映着它自己，它跟那个影子对望了整整一个早上。' }
    ],
    ideas: [
      '它很小心，一直没飞走',
      '我不想惊动它',
      '我原先猜它饿了，后来发现猜错了'
    ]
  },
  {
    name: '雨里的一把伞',
    lines: [
      { p: 1, t: '我把伞往同桌那边挪了挪，自己半边肩膀湿了一路。' },
      { p: 1, t: '他一路都在讲笑话，没发现伞偏了。' },
      { p: 2, t: '到家我才发现，书包里那本作业本倒是干的。' }
    ],
    ideas: [
      '我特意把伞让给了他',
      '他一点也没察觉',
      '我原先以为书包会湿，结果猜错了'
    ]
  }
];

var SIM = { ci: 0, links: [], selL: null, hits: [], bound: false };

function simCase() { return CN_CASES[SIM.ci]; }
function simLinked(l, i) {
  return SIM.links.some(function (x) { return x.l === l && x.i === i; });
}
function simSetReadout() {
  var el = document.getElementById('simReadout');
  if (el) el.textContent = '依据链已连 ' + SIM.links.length + ' / 3 环（不判对错）';
}
function simWrap(t, n) {
  return t.length <= n ? [t] : [t.slice(0, n), t.slice(n)];
}

function simDraw() {
  var ctx = simCtx();
  ctx.fillStyle = '#FBF8F0';
  ctx.fillRect(0, 0, SIM_W, SIM_H);
  var c = simCase();
  SIM.hits = [];

  simTxt('把想法接回原文：' + c.name, 28, 30, 18, '#2E5C4A', '700');
  simTxt('文中写的', 28, 52, 13, '#7A7263', '700');
  simTxt('我想的', 590, 52, 13, '#7A7263', '700');

  var ys = [66, 146, 226];
  // 左：原文句块（可点）
  for (var l = 0; l < 3; l++) {
    var on = SIM.selL === l;
    simBox(24, ys[l], 400, 62, on ? '#FFF2C9' : '#FFFFFF', on ? '#E0A93B' : '#DDD3BE', 10);
    var ls = simWrap(c.lines[l].t, 20);
    for (var k = 0; k < ls.length; k++) simTxt(ls[k], 38, ys[l] + 25 + k * 22, 15, '#2B2B28', '600');
    simTxt('第 ' + c.lines[l].p + ' 段', 380, ys[l] + 55, 11, '#7A7263', '400', 'right');
    SIM.hits.push({ x: 24, y: ys[l], w: 400, h: 62, kind: 'l', idx: l });
  }
  // 右：想法块（可点）
  for (var i = 0; i < 3; i++) {
    var used = SIM.links.some(function (x) { return x.i === i; });
    simBox(480, ys[i], 376, 62, used ? '#FBE9DD' : '#FFFFFF', used ? '#C0622F' : '#DDD3BE', 10);
    var is = simWrap(c.ideas[i], 19);
    for (var m = 0; m < is.length; m++) simTxt(is[m], 496, ys[i] + 25 + m * 22, 15, '#2B2B28', '600');
    SIM.hits.push({ x: 480, y: ys[i], w: 376, h: 62, kind: 'i', idx: i });
  }
  // 中：连线（已连实线橙，未连淡虚线）
  for (var a = 0; a < 3; a++) {
    for (var b = 0; b < 3; b++) {
      var linked = simLinked(a, b);
      if (!linked && !(a === b)) continue;
      simLine(424, ys[a] + 31, 480, ys[b] + 31,
              linked ? '#C0622F' : '#E6DECB', linked ? 2.6 : 1, linked ? null : [4, 4]);
      if (linked) simDot(452, (ys[a] + ys[b]) / 2 + 31, 4, '#C0622F', null);
    }
  }

  simBox(24, 306, 832, 40, '#EDF3EE', null, 8);
  simTxt('依据链已连 ' + SIM.links.length + ' / 3 环', 40, 331, 16, '#2E5C4A', '700');
  simTxt('点左边一句原文，再点右边一个想法 —— 不打分，只看想法能不能指回第几句',
          250, 331, 13, '#4A463E', '400');
  simSetReadout();
}

function simLink(l, i) {
  var c = simCase();
  if (l < 0 || l > 2 || i < 0 || i > 2) return;
  if (simLinked(l, i)) { simLog('这一环已经连过了，换一句试试'); return; }
  SIM.links.push({ l: l, i: i });
  SIM.selL = null;
  simLog('第 ' + c.lines[l].p + ' 段那句 → 撑住了「<span class="hl">' + c.ideas[i] + '</span>」');
  simDraw();
}

function simPick(kind, idx) {
  if (kind === 'l') {
    SIM.selL = idx;
    simLog('选中第 ' + simCase().lines[idx].p + ' 段那句，再点右边一个想法');
    simDraw();
    return;
  }
  if (SIM.selL === null) { simLog('先点左边一句原文，再点右边的想法'); simDraw(); return; }
  simLink(SIM.selL, idx);
}

function simNextCase() {
  SIM.ci = (SIM.ci + 1) % CN_CASES.length;
  SIM.links = []; SIM.selL = null;
  simLog('换一篇：<span class="hl">' + simCase().name + '</span>，只用划和连，重新找依据');
  simDraw();
}
function simReset() {
  SIM.links = []; SIM.selL = null;
  simLog('重来：原文和想法都还在，把连过的线先收回去');
  simDraw();
}
function simDemo() {
  SIM.links = [{ l: 0, i: 0 }, { l: 1, i: 1 }, { l: 2, i: 2 }];
  SIM.selL = null;
  simLog('看老师连一条：<span class="hl">先自己试一次，再看不迟</span>。第三环是「我猜错了」，它也算一条真痕迹。');
  simDraw();
}
function simBind() {
  var cv = document.getElementById('simCanvas');
  if (!cv || cv.__simBound) return;
  cv.__simBound = true;
  cv.addEventListener('click', function (e) {
    var r = cv.getBoundingClientRect();
    var x = (e.clientX - r.left) * (SIM_W / r.width);
    var y = (e.clientY - r.top) * (SIM_H / r.height);
    for (var j = 0; j < SIM.hits.length; j++) {
      var h = SIM.hits[j];
      if (x >= h.x && x <= h.x + h.w && y >= h.y && y <= h.y + h.h) { simPick(h.kind, h.idx); return; }
    }
  });
}

// ===================== 五段里的「留痕迹」互动（都不判分） =====================

// 1 起疑 p2：点句子标灰「我在这儿停了一下」
function bindDoubt() {
  var box = document.getElementById('rdText');
  if (!box || box.__bound) return;
  box.__bound = true;
  box.addEventListener('click', function (e) {
    var el = e.target.closest('.rd-s');
    if (!el) return;
    el.classList.toggle('stopped');
    var n = box.querySelectorAll('.rd-s.stopped').length;
    var out = document.getElementById('rdNote');
    if (out) out.innerHTML = '停了 <b>' + n + '</b> 下。灰的是你读过又卡住过的整句——'
      + '<b>点哪句都行，不判对错</b>；落在整句上才算，落在空白处不算。';
  });
}

// 2 取证 p3：先选符号，再点句子划黄；想法框非空即可，都不判对错
function bindEvidence() {
  var root = document.getElementById('evBox');
  if (!root || root.__bound) return;
  root.__bound = true;
  var sym = '';
  function refresh() {
    var marked = root.querySelectorAll('.ev-s.marked').length;
    var idea = document.getElementById('evIdea');
    var has = idea && idea.value.trim().length > 0;
    var out = document.getElementById('evNote');
    if (out) out.innerHTML = '已取证 <b>' + marked + '</b> 处 · 想法' + (has ? '已写下' : '还没写')
      + '（<b>只记痕迹，不判对错</b>，写不完整也能往下走）';
    if (idea) { try { localStorage.setItem('cn_read_mark_idea', idea.value.trim()); } catch (e) { } }
  }
  root.addEventListener('click', function (e) {
    var b = e.target.closest('.ev-sym');
    if (b) {
      root.querySelectorAll('.ev-sym').forEach(function (n) { n.classList.remove('on'); });
      b.classList.add('on'); sym = b.getAttribute('data-s');
      var w = document.getElementById('evWhy');
      if (w) w.innerHTML = '选了「' + sym + '」。现在点一句原文，把它划下来。';
      return;
    }
    var s = e.target.closest('.ev-s');
    if (s) {
      s.classList.toggle('marked');
      if (s.classList.contains('marked')) {
        var badge = s.querySelector('.ev-badge');
        if (badge) badge.textContent = sym || '～';
      }
      var w2 = document.getElementById('evWhy');
      if (w2) w2.innerHTML = '这一句在<b>第 ' + s.getAttribute('data-p') + ' 段</b>。'
        + '依据要能指回第几句；<b>划中不等于读懂</b>，还得说得出「我是从哪句知道的」。';
      refresh();
      return;
    }
  });
  var idea = document.getElementById('evIdea');
  if (idea) idea.addEventListener('input', refresh);
}

// 3 对齐 p5：4 句卡 → 2 观点槽 + 都不支撑筐；连线后强制补「第几句」，分别记录
function bindAlign() {
  var root = document.getElementById('alBox');
  if (!root || root.__bound) return;
  root.__bound = true;
  var sel = null;
  function refresh() {
    var placed = root.querySelectorAll('.ev-card[data-slot]').length;
    var why = root.querySelectorAll('.ev-card[data-para]').length;
    var out = document.getElementById('alNote');
    if (out) out.innerHTML = '已归位 <b>' + placed + ' / 4</b> · 依据补了 <b>' + why + ' / 4</b>'
      + '（<b>连线和依据分别记，不判对错</b>）';
  }
  root.addEventListener('click', function (e) {
    var para = e.target.closest('.ev-para');
    // 依据按钮优先：卡片归位后会被移进槽里，此时它同时命中 .ev-slot
    if (para) {
      var c2 = para.closest('.ev-card');
      if (c2) {
        c2.setAttribute('data-para', para.getAttribute('data-p'));
        c2.querySelectorAll('.ev-para').forEach(function (n) { n.classList.remove('on'); });
        para.classList.add('on');
        var w3 = document.getElementById('alWhy');
        if (w3) w3.innerHTML = '依据记在第 <b>' + para.getAttribute('data-p') + ' 段</b>。'
          + '要是想法和原文对不上，只提示「再读第 ' + para.getAttribute('data-p') + ' 段」，不给分数、不说对错。';
        refresh();
      }
      return;
    }
    var card = e.target.closest('.ev-card');
    var slot = e.target.closest('.ev-slot');
    if (card) {
      root.querySelectorAll('.ev-card').forEach(function (n) { n.classList.remove('on'); });
      card.classList.add('on'); sel = card;
      var w = document.getElementById('alWhy');
      if (w) w.innerHTML = '选中第 ' + card.getAttribute('data-n') + ' 张卡。点右边一个槽把它放进去；'
        + '放完还要补一句「我是根据第几句连的」。';
      return;
    }
    if (slot && sel) {
      sel.setAttribute('data-slot', slot.getAttribute('data-slot'));
      slot.appendChild(sel);
      sel.classList.remove('on');
      sel = null;
      var w2 = document.getElementById('alWhy');
      if (w2) w2.innerHTML = '放好了。<b>现在点这张卡下面的「第几段」</b>，把依据补上——'
        + '连线归连线，依据归依据，两样都留痕才算数。';
      refresh();
      return;
    }
  });
  refresh();
}

// 5 换文 p8：新短文只用「划」和「连」+ 三条自查，只回执不判分
function bindTransfer() {
  var root = document.getElementById('trBox');
  if (!root || root.__bound) return;
  root.__bound = true;
  root.addEventListener('click', function (e) {
    var s = e.target.closest('.tr-s');
    if (s) {
      s.classList.toggle('marked');
      var n = root.querySelectorAll('.tr-s.marked').length;
      var out = document.getElementById('trNote');
      if (out) out.innerHTML = '自发划了 <b>' + n + '</b> 处（<b>不判对错</b>）。'
        + '换了一篇没提示的短文，工具条只剩「划」和「连」——看还能不能自己找到依据。';
      return;
    }
    var ck = e.target.closest('.tr-ck');
    if (ck) {
      ck.classList.toggle('on');
      var k = root.querySelectorAll('.tr-ck.on').length;
      var a = document.getElementById('trAdvice');
      if (a) a.innerHTML = '自查勾了 <b>' + k + ' / 3</b> 条。'
        + '三条都只问「能不能指回原文」，不问「读懂了没有」——<b>勾不满也照样能翻页</b>。';
      return;
    }
  });
}

// 存起来 p10：结算必须显示学生自己留下的依据链
function updateMyChain() {
  var el = document.getElementById('myChain');
  if (!el) return;
  var idea = '';
  try { idea = localStorage.getItem('cn_read_mark_idea') || ''; } catch (e) { }
  el.innerHTML = idea
    ? '<b>你留下的依据链</b>　我的想法：' + idea.replace(/</g, '&lt;')
      + '　→　回到原文，指出是从第几句知道的 → 用「因为……所以我认为……」说清。'
    : '<b>你留下的依据链</b>　（还没存想法。回到「取证」那一页写一句，它就会出现在这里。）';
}
// ===== V4 总结页 =====
function toggleCardV4(card){ card.classList.toggle('expanded'); }
function expandAllV4(){ document.querySelectorAll('.summary-v4-card').forEach(function(c){ c.classList.add('expanded'); }); }
function collapseAllV4(){ document.querySelectorAll('.summary-v4-card').forEach(function(c){ c.classList.remove('expanded'); }); }

// ===== 初始显示 =====
var _urlPage = getPageParam('page');
var _initIdx = (_urlPage && PAGE_IDS.indexOf(_urlPage) >= 0) ? PAGE_IDS.indexOf(_urlPage) : 0;
showPage(_initIdx);

</script>
</body>
</html>
