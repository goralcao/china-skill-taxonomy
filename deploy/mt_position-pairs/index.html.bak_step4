        <text x="212" y="196" font-size="12" fill="#FFCA28">第 5 列第 3 行 → (5, 3)</text>
        <text x="378" y="196" font-size="11" fill="rgba(255,255,255,.6)">先横数，再竖数</text>
      </g>
    </svg>
  </div>
</div>
</section>

<section class="page" id="p1">
<div class="quiz-page" id="quizPre">
  <h2 class="quiz-title">先答三道，凭感觉</h2>
  <p class="quiz-hint">这三道都关于「怎么描述一个位置」，不用数对也能答。</p>

  <div class="quiz-q" id="qq_quizPre_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 教室里你的座位是「第 3 组第 4 排」。如果先说排再说组，会不会说成另一个位子？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>会，听着就乱了</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>不会，一样清楚</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>要看教室怎么排</div>
    </div>
    <div class="feedback" id="fb_quizPre_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizPre_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 找「第 5 列第 8 行」，你打算先数哪个？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>先竖着数 5 列</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>先横着数 8 行</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>随便，哪个顺手都行</div>
    </div>
    <div class="feedback" id="fb_quizPre_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizPre_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. 快递柜 4 列 3 层，第 2 列第 3 层的柜门，跟第 3 列第 2 层是同一扇吗？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>是同一扇</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>不是，差一层</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>要看柜子大小</div>
    </div>
    <div class="feedback" id="fb_quizPre_2"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizPre')">重做</button>
  </div>
  <span id="preScore" class="quiz-score"></span>
</div>
</section>

<!-- ===== p2: 一张票 2 个数，锁定一个座位 ===== -->
<section class="page" id="p2">
<h2 class="teach-title">一张票 2 个数，锁定一个座位</h2>

<div class="clearfix">
  <div class="fig float-r" id="p2fig">
    <svg viewBox="0 0 400 250" width="400" height="250" role="img" aria-label="放映厅座位表 8 列 8 行，第 5 列第 8 行的座位被标出，写作数对 (5, 8)">
      <g font-family="sans-serif">
        <text x="12" y="18" font-size="12.5" font-weight="700" fill="#1A237E">放映厅座位表</text>
        <text x="388" y="18" text-anchor="end" font-size="10.5" fill="#5C6BC0">列 1–8 · 行 1–8</text>
        <rect x="64" y="26" width="272" height="9" rx="4" fill="#C5CAE9"/>
        <text x="200" y="21" text-anchor="middle" font-size="9.5" fill="#7986CB">银 幕</text>
        <rect x="64" y="42" width="272" height="144" fill="#FFFFFF" stroke="#CFD8DC" stroke-width="1.4"/>
        <line x1="98" y1="42" x2="98" y2="186" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="132" y1="42" x2="132" y2="186" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="166" y1="42" x2="166" y2="186" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="200" y1="42" x2="200" y2="186" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="234" y1="42" x2="234" y2="186" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="268" y1="42" x2="268" y2="186" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="302" y1="42" x2="302" y2="186" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="64" y1="60" x2="336" y2="60" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="64" y1="78" x2="336" y2="78" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="64" y1="96" x2="336" y2="96" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="64" y1="114" x2="336" y2="114" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="64" y1="132" x2="336" y2="132" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="64" y1="150" x2="336" y2="150" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="64" y1="168" x2="336" y2="168" stroke="#CFD8DC" stroke-width="1"/>
        <rect x="201" y="43" width="31" height="15" fill="#FFE0B2" stroke="#E65100" stroke-width="1.6"/>
        <text x="81" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">1</text>
        <text x="115" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">2</text>
        <text x="149" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">3</text>
        <text x="183" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">4</text>
        <text x="217" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">5</text>
        <text x="251" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">6</text>
        <text x="285" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">7</text>
        <text x="319" y="201" text-anchor="middle" font-size="10.5" fill="#607D8B">8</text>
        <text x="57" y="181" text-anchor="end" font-size="10.5" fill="#607D8B">1</text>
        <text x="57" y="163" text-anchor="end" font-size="10.5" fill="#607D8B">2</text>
        <text x="57" y="145" text-anchor="end" font-size="10.5" fill="#607D8B">3</text>
        <text x="57" y="127" text-anchor="end" font-size="10.5" fill="#607D8B">4</text>
        <text x="57" y="109" text-anchor="end" font-size="10.5" fill="#607D8B">5</text>
        <text x="57" y="91" text-anchor="end" font-size="10.5" fill="#607D8B">6</text>
        <text x="57" y="73" text-anchor="end" font-size="10.5" fill="#607D8B">7</text>
        <text x="57" y="55" text-anchor="end" font-size="10.5" fill="#607D8B">8</text>
        <line x1="46" y1="42" x2="46" y2="186" stroke="#C5CAE9" stroke-width="1.4"/>
        <rect x="64" y="212" width="272" height="24" rx="6" fill="#FFF8E1" stroke="#FFCA28" stroke-width="1.2"/>
        <text x="200" y="228" text-anchor="middle" font-size="11.5" font-weight="700" fill="#B26A00">第 5 列第 8 行 → 数对 (5, 8)</text>
      </g>
    </svg>
  </div>

  <p class="teach-text" id="p2s1">
    票上印着「8 排 5 号」，票价 35 元。放映厅里几百个座位，全靠这两个数锁定一个。
  </p>
  <p class="teach-text" id="p2s2">
    数学把这层意思压成一对数：(5, 8)。前面的 5 是列，后面的 8 是行。
  </p>
  <p class="teach-text" id="p2s3">
    次序不能换。写成 (8, 5) 就成了第 8 列第 5 行，人坐到别处去了。
  </p>
</div>

<div class="card-grid" id="p2cards">
  <div class="card">
    <h4>一个数不够</h4>
    <div class="eq">5 号 → 一排几十个</div>
    <p>只说号数，同排几十个座位全对上。</p>
  </div>
  <div class="card">
    <h4>两个数正好</h4>
    <div class="eq">(5, 8)</div>
    <p>一个管左右，一个管上下，位置立刻唯一。</p>
  </div>
  <div class="card">
    <h4>次序不能反</h4>
    <div class="eq">(5, 8) ≠ (8, 5)</div>
    <p>换个次序就换一格，这就是「有序」。</p>
  </div>
</div>

<div class="key-box" id="p2key">
  数对是一对<strong>有次序</strong>的数：先列后行。<strong>次序一换，位置就变</strong>。
</div>
</section>

<!-- ===== p3: 数对怎么读：先横着数列，再竖着数行 ===== -->
<section class="page" id="p3">
<h2 class="teach-title">数对怎么读：先横着数列，再竖着数行</h2>

<div class="clearfix">
  <div class="fig float-r" id="p3fig">
    <svg viewBox="0 0 420 246" width="424" height="248" role="img" aria-label="方格图上第 3 列第 2 行的位置被标出，读作数对 (3, 2)，换次序成 (2, 3) 就是另一格">
      <g font-family="sans-serif">
        <text x="14" y="22" font-size="12.5" font-weight="700" fill="#1A237E">第 3 列、第 2 行，记作 (3, 2)</text>
        <rect x="52" y="44" width="210" height="160" fill="#FFFFFF" stroke="#CFD8DC" stroke-width="1.4"/>
        <line x1="94" y1="44" x2="94" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="136" y1="44" x2="136" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="178" y1="44" x2="178" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="220" y1="44" x2="220" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="76" x2="262" y2="76" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="108" x2="262" y2="108" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="140" x2="262" y2="140" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="172" x2="262" y2="172" stroke="#CFD8DC" stroke-width="1"/>
        <rect x="137" y="141" width="39" height="29" fill="#FFCDD2" stroke="#C62828" stroke-width="1.6"/>
        <text x="157" y="160" text-anchor="middle" font-size="11" font-weight="700" fill="#C62828">(3,2)</text>
        <text x="73" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">1</text>
        <text x="115" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">2</text>
        <text x="157" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">3</text>
        <text x="199" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">4</text>
        <text x="241" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">5</text>
        <text x="45" y="192" text-anchor="end" font-size="10.5" fill="#607D8B">1</text>
        <text x="45" y="160" text-anchor="end" font-size="10.5" fill="#607D8B">2</text>
        <text x="45" y="128" text-anchor="end" font-size="10.5" fill="#607D8B">3</text>
        <text x="45" y="96" text-anchor="end" font-size="10.5" fill="#607D8B">4</text>
        <text x="45" y="64" text-anchor="end" font-size="10.5" fill="#607D8B">5</text>
        <rect x="276" y="54" width="130" height="44" rx="8" fill="#E8EAF6" stroke="#9FA8DA" stroke-width="1.4"/>
        <text x="341" y="84" text-anchor="middle" font-size="20" font-weight="700" fill="#1A237E">(3, 2)</text>
        <text x="341" y="114" text-anchor="middle" font-size="10.5" fill="#5C6BC0">前一个是列，后一个是行</text>

        <text x="341" y="140" text-anchor="middle" font-size="10.5" fill="#7986CB">换个次序试试</text>
        <rect x="276" y="148" width="130" height="38" rx="8" fill="#FBE9E7" stroke="#FFAB91" stroke-width="1.2"/>
        <text x="341" y="173" text-anchor="middle" font-size="16" font-weight="700" fill="#C62828">(2, 3)</text>
        <text x="341" y="204" text-anchor="middle" font-size="10.5" fill="#C62828">跑到另一格去了</text>

        <text x="52" y="238" font-size="10.5" fill="#5C6BC0">先横着数到第 3 列，再竖着数到第 2 行</text>
      </g>
    </svg>
  </div>

  <p class="teach-text" id="p3s1">
    方格图下边写列号，左边写行号。找位置时先看列，再看行。
  </p>
  <p class="teach-text" id="p3s2">
    第 3 列第 2 行记作 (3, 2)：括号、逗号、两个数，一个都不能少。
  </p>
</div>

<ul class="feature-list" id="p3rules">
  <li><strong>第 1 个数</strong>：列，从左往右数</li>
  <li><strong>第 2 个数</strong>：行，从下往上（从前往后）数</li>
  <li><strong>写法</strong>：括号里用逗号隔开，(3,2) 与 (2,3) 是两个位置</li>
</ul>

<div class="key-box" id="p3key">
  读法只有一条规矩：<strong>前一个是列，后一个是行</strong>。题目怎么问，都按这个次序写。
</div>
</section>

<!-- ===== p3b: 连一连 ===== -->
<section class="page" id="p3b">
<h2 class="teach-title">座位描述和数对，配成八对</h2>
<p class="teach-text" id="p3bs1">先看清是「第几列第几行」，再按先列后行写数对。</p>
<div class="match-wrap" id="matchP3"></div>
</section>

<section class="page" id="p4">
<div class="quiz-page" id="quizMid1">
  <h2 class="quiz-title">中测一 · 先列后行，站稳了吗</h2>
  <p class="quiz-hint">三个题只考读法和写法。</p>

  <div class="quiz-q" id="qq_quizMid1_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 数对 (4, 6) 表示什么位置？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>第 4 行第 6 列</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>第 4 列第 6 行</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>第 6 列第 4 行</div>
    </div>
    <div class="feedback" id="fb_quizMid1_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid1_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 第 7 列第 3 行，写成数对是？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>(7, 3)</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>(3, 7)</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>(7.3)</div>
    </div>
    <div class="feedback" id="fb_quizMid1_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid1_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. (2, 5) 和 (5, 2) 是同一个位置吗？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>是，两个数一样</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>不是，列和行反了</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>要看座位表才知道</div>
    </div>
    <div class="feedback" id="fb_quizMid1_2"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizMid1')">重做</button>
  </div>
  <span id="mid1Score" class="quiz-score"></span>
</div>
</section>

<!-- ===== p5: 同一列的数对，第一个数一样 ===== -->
<section class="page" id="p5">
<h2 class="teach-title">同一列的数对，第一个数一样</h2>

<div class="clearfix">
  <div class="fig float-r" id="p5fig">
    <svg viewBox="0 0 420 246" width="424" height="248" role="img" aria-label="方格图中第 2 行整行被标成青色，第 3 列整列被标成蓝色，说明同行第二个数相同、同列第一个数相同">
      <g font-family="sans-serif">
        <text x="14" y="22" font-size="12.5" font-weight="700" fill="#1A237E">一列竖着，一行横着</text>
        <rect x="52" y="44" width="210" height="160" fill="#FFFFFF" stroke="#CFD8DC" stroke-width="1.4"/>
        <line x1="94" y1="44" x2="94" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="136" y1="44" x2="136" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="178" y1="44" x2="178" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="220" y1="44" x2="220" y2="204" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="76" x2="262" y2="76" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="108" x2="262" y2="108" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="140" x2="262" y2="140" stroke="#CFD8DC" stroke-width="1"/>
        <line x1="52" y1="172" x2="262" y2="172" stroke="#CFD8DC" stroke-width="1"/>
        <rect x="53" y="141" width="39" height="29" fill="#B2EBF2" stroke="#00838F" stroke-width="1.6"/>
        <rect x="95" y="141" width="39" height="29" fill="#B2EBF2" stroke="#00838F" stroke-width="1.6"/>
        <rect x="137" y="141" width="39" height="29" fill="#B2EBF2" stroke="#00838F" stroke-width="1.6"/>
        <rect x="179" y="141" width="39" height="29" fill="#B2EBF2" stroke="#00838F" stroke-width="1.6"/>
        <rect x="221" y="141" width="39" height="29" fill="#B2EBF2" stroke="#00838F" stroke-width="1.6"/>
        <rect x="137" y="173" width="39" height="29" fill="#C5CAE9" stroke="#283593" stroke-width="1.6"/>
        <rect x="137" y="141" width="39" height="29" fill="#C5CAE9" stroke="#283593" stroke-width="1.6"/>
        <rect x="137" y="109" width="39" height="29" fill="#C5CAE9" stroke="#283593" stroke-width="1.6"/>
        <rect x="137" y="77" width="39" height="29" fill="#C5CAE9" stroke="#283593" stroke-width="1.6"/>
        <rect x="137" y="45" width="39" height="29" fill="#C5CAE9" stroke="#283593" stroke-width="1.6"/>
        <text x="73" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">1</text>
        <text x="115" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">2</text>
        <text x="157" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">3</text>
        <text x="199" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">4</text>
        <text x="241" y="219" text-anchor="middle" font-size="10.5" fill="#607D8B">5</text>
        <text x="45" y="192" text-anchor="end" font-size="10.5" fill="#607D8B">1</text>
        <text x="45" y="160" text-anchor="end" font-size="10.5" fill="#607D8B">2</text>
        <text x="45" y="128" text-anchor="end" font-size="10.5" fill="#607D8B">3</text>
        <text x="45" y="96" text-anchor="end" font-size="10.5" fill="#607D8B">4</text>
        <text x="45" y="64" text-anchor="end" font-size="10.5" fill="#607D8B">5</text>
        <line x1="52" y1="156" x2="262" y2="156" stroke="#00838F" stroke-width="1.4" stroke-dasharray="5 4"/>
        <line x1="157" y1="44" x2="157" y2="204" stroke="#283593" stroke-width="1.4" stroke-dasharray="5 4"/>

        <rect x="276" y="52" width="132" height="46" rx="7" fill="#E0F7FA" stroke="#4DD0E1" stroke-width="1.2"/>
        <text x="342" y="70" text-anchor="middle" font-size="10.5" fill="#00838F">同一行（第 2 个都是 2）</text>
        <text x="342" y="88" text-anchor="middle" font-size="11" font-weight="700" fill="#00838F">(1,2) (2,2) (3,2)</text>

        <rect x="276" y="110" width="132" height="46" rx="7" fill="#E8EAF6" stroke="#9FA8DA" stroke-width="1.2"/>
        <text x="342" y="128" text-anchor="middle" font-size="10.5" fill="#283593">同一列（第 1 个都是 3）</text>
        <text x="342" y="146" text-anchor="middle" font-size="11" font-weight="700" fill="#283593">(3,1) (3,2) (3,3)</text>

        <text x="276" y="184" font-size="10.5" fill="#5C6BC0">第一个数管左右，</text>
        <text x="276" y="202" font-size="10.5" fill="#5C6BC0">第二个数管上下。</text>
      </g>
    </svg>
  </div>

  <p class="teach-text" id="p5s1">
    竖着看一列：(3,1)、(3,2)、(3,3)、(3,4)——第一个数都是 3，变的只是行。
  </p>
  <p class="teach-text" id="p5s2">
    横着看一行：(1,2)、(2,2)、(3,2)——第二个数都是 2，变的只是列。
  </p>
</div>

<div class="card-grid" id="p5cards">
  <div class="card">
    <h4>同一列</h4>
    <div class="eq">(3,1) (3,2) (3,3)</div>
    <p>第一个数相同，竖着排成一列。</p>
  </div>
  <div class="card">
    <h4>同一行</h4>
    <div class="eq">(1,2) (2,2) (3,2)</div>
    <p>第二个数相同，横着排成一行。</p>
  </div>
  <div class="card">
    <h4>左右平移</h4>
    <div class="eq">(3,2) → (6,2)</div>
    <p>行不动、列加 3，往右挪 3 格。</p>
  </div>
</div>

<div class="key-box" id="p5key">
  数对的两个数<strong>各管一个方向</strong>：第一个管左右，第二个管上下。看哪个数变了，就知道往哪边动了。
</div>
</section>

<!-- ===== p6: 仿真 ===== -->
<section class="page" id="p6">
<div class="sim-page">
  <h2 class="sim-title">按数对找格子</h2>
  <p class="sim-desc">上方给出一个数对，点方格纸上对应的格子。点错了会告诉你差在列还是差在行——这正是最容易反的地方。</p>

  <div class="sim-status">
    <span class="sim-readout" id="simReadout">目标 (3, 4) · 还没点</span>
    <span class="sim-tip" id="simTip">先横着数 3 列，再竖着数 4 行</span>
  </div>

  <div class="sim-controls">
    <button class="btn-primary" onclick="simHint()">亮出行与列</button>
    <button class="btn-retry" onclick="simCase()">换一题</button>
    <button class="btn-retry" onclick="simReset()">重来</button>
    <button class="btn-retry" onclick="simDemo()">自动演示</button>
  </div>

  <div class="sim-canvas-wrap">
    <div class="canvas-box">
      <canvas id="simCanvas" width="880" height="360"></canvas>
      <p class="cap">列号在下面，行号在左边；点格子会留下痕迹，绿对红错</p>
    </div>
  </div>

  <div class="sim-log" id="simLog"></div>

  <ul class="feature-list" style="margin-top:14px">
    <li>点 (4, 3) 时错在哪一步？列数对了还是行数对了？</li>
    <li>把目标改成 (3, 4) 和 (4, 3)，两次点的是同一格吗？</li>
    <li>同一列的格子，点出来的数对哪个数一直没变？</li>
  </ul>
</div>
</section>

<section class="page" id="p7">
<div class="quiz-page" id="quizMid2">
  <h2 class="quiz-title">中测二 · 规律和迁移</h2>
  <p class="quiz-hint">数对不只是记位置，还能看出关系。</p>

  <div class="quiz-q" id="qq_quizMid2_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 同一列的两个数对，哪个数一定相同？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>第一个数</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>第二个数</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>两个都不同</div>
    </div>
    <div class="feedback" id="fb_quizMid2_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid2_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 数对 (6, 3) 往右移 2 格，新位置是？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>(6, 5)</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>(8, 3)</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>(4, 3)</div>
    </div>
    <div class="feedback" id="fb_quizMid2_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizMid2_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. 快递柜 4 列 3 层，第 2 列第 3 层用数对表示是？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>(3, 2)</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>(2.3)</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>(2, 3)</div>
    </div>
    <div class="feedback" id="fb_quizMid2_2"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizMid2')">重做</button>
  </div>
  <span id="mid2Score" class="quiz-score"></span>
</div>
</section>

<!-- ===== p8: 四个坑，一掉就指错座位 ===== -->
<section class="page" id="p8">
<h2 class="teach-title">四个坑，一掉就指错座位</h2>

<div class="clearfix">
</div>

<div class="card-grid" id="p8cards">
  <div class="card">
    <h4>坑一：先写行后写列</h4>
    <div class="eq">8 排 5 号 → (8, 5) ✗</div>
    <p>票上是「排 + 号」，数对是「列 + 行」。应该写 (5, 8)。</p>
  </div>
  <div class="card">
    <h4>坑二：行从上往下数</h4>
    <div class="eq">第 1 行数成最后一排 ✗</div>
    <p>第 1 行是最靠前（图中最下）的一行，往上行号变大。</p>
  </div>
  <div class="card">
    <h4>坑三：逗号写成小数点</h4>
    <div class="eq">(3.2) ✗</div>
    <p>那是小数 3.2，不是位置。数对必须用逗号隔开两个数。</p>
  </div>
  <div class="card">
    <h4>坑四：以为调个头一样</h4>
    <div class="eq">(3,2) 与 (2,3) 混用 ✗</div>
    <p>两个位置分居对角线两侧，差着好几排座位。</p>
  </div>
</div>

<div class="key-box" id="p8key">
  写之前先问自己一句：<strong>这是在说列，还是在说行</strong>？两个数各就各位，位置才不会偏。
</div>

<p class="teach-text" id="p8apply">
  回到那张票：「8 排 5 号」= 第 5 列第 8 行 = (5, 8)。进场先沿着过道数到第 8 排，再横着数 5 个座位，两步到位 ✓
</p>
</section>

<section class="page" id="p9">
<div class="quiz-page" id="quizPost">
  <h2 class="quiz-title">后测 · 五道题，换个场景还认得出吗</h2>
  <p class="quiz-hint">座位、柜格、棋盘，规矩都一样。</p>

  <div class="quiz-q" id="qq_quizPost_0">
    <p class="q-stem"><span class="q-type">单选题</span>1. 数对 (a, b) 里的 a 表示什么？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>行</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>列</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>第几个座位</div>
    </div>
    <div class="feedback" id="fb_quizPost_0"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_1">
    <p class="q-stem"><span class="q-type">单选题</span>2. 第 6 列第 2 行的数对是？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>(6, 2)</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>(2, 6)</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>(6.2)</div>
    </div>
    <div class="feedback" id="fb_quizPost_1"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_2">
    <p class="q-stem"><span class="q-type">单选题</span>3. 与 (4, 5) 在同一行的数对是？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>(4, 3)</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>(5, 5)</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>(7, 4)</div>
    </div>
    <div class="feedback" id="fb_quizPost_2"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_3">
    <p class="q-stem"><span class="q-type">单选题</span>4. 与 (4, 5) 在同一列的数对是？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>(4, 2)</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>(2, 5)</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>(5, 4)</div>
    </div>
    <div class="feedback" id="fb_quizPost_3"></div>
  </div>

  <div class="quiz-q" id="qq_quizPost_4">
    <p class="q-stem"><span class="q-type">单选题</span>5. 班里座位表写成「第 3 组第 4 排」，用数对怎么写？</p>
    <div class="opts">
      <div class="opt" data-idx="0"><span class="badge">A</span>(3, 4)</div>
      <div class="opt" data-idx="1"><span class="badge">B</span>(4, 3)</div>
      <div class="opt" data-idx="2"><span class="badge">C</span>(3.4)</div>
    </div>
    <div class="feedback" id="fb_quizPost_4"></div>
  </div>

  <div class="quiz-actions">
    <button class="btn-retry" onclick="retryQuiz('quizPost')">重做</button>
  </div>
  <span id="postScore" class="quiz-score"></span>
</div>
</section>

<!-- ===== p10: 总结 V4 ===== -->
<section class="page" id="p10">
<h2 class="teach-title">这一课，装进四张卡</h2>

<div class="summary-v4-toolbar">
  <button type="button" onclick="expandAllV4()">全部展开</button>
  <button type="button" onclick="collapseAllV4()">全部收起</button>
</div>

<div class="summary-v4-grid">
  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">1</div>
      <div style="flex:1">
        <div class="summary-v4-title">是什么</div>
        <div class="summary-v4-summary">一对有序的数，锁定一个点</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>数对 (列, 行)：前一个数是从左往右数的列，后一个是从下往上数的行。</p>
      <p>次序一换，位置就换，所以叫「有序」。</p>
    </div>
  </div>

  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">2</div>
      <div style="flex:1">
        <div class="summary-v4-title">为什么</div>
        <div class="summary-v4-summary">两个方向要两个数</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>只给一个数，一排上几十个座位全符合；给两个数，一横一竖交叉，只剩一个点。</p>
      <p>这也是地图、棋盘、Excel 单元格都用两个数定位的原因。</p>
    </div>
  </div>

  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">3</div>
      <div style="flex:1">
        <div class="summary-v4-title">怎么用</div>
        <div class="summary-v4-summary">先列后行，两步到位</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>① 找列：从左往右数到第几列。</p>
      <p>② 找行：从下往上数到第几行。</p>
      <p>③ 写成 (列, 行)，逗号不能省。</p>
    </div>
  </div>

  <div class="summary-v4-card" onclick="toggleCardV4(this)">
    <div class="summary-v4-header">
      <div class="summary-v4-num">4</div>
      <div style="flex:1">
        <div class="summary-v4-title">易错</div>
        <div class="summary-v4-summary">反序、行向、逗号、混用</div>
      </div>
      <div class="summary-v4-indicator">▼</div>
    </div>
    <div class="summary-v4-body">
      <p>坑一：先写行后写列。</p>
      <p>坑二：行从上往下数，把第 1 行数成了最后一排。</p>
      <p>坑三：(3.2) 当成数对，其实是小数。</p>
      <p>坑四：以为 (3,2) 和 (2,3) 是同一格。</p>
    </div>
  </div>

</div>

<p class="teach-text" style="margin-top:18px">
  记住这一句：<strong>先列后行，一对有序</strong>；两个数各管一个方向，次序一换位置就变。
</p>
</section>
</div><!-- /pageContainer -->

<!-- ===== 渐进揭示提示条 ===== -->
<div id="revealHint"><span class="r-dot"></span>点击页面继续揭示 <span class="r-progress" id="revealProgress"></span></div>

<!-- ===== 图片全屏灯箱 ===== -->
<div id="imgLightbox" onclick="closeLightbox()">
  <button class="lb-close" onclick="closeLightbox()">✕</button>
  <img id="lbImg" src="" alt="全屏查看">
</div>

<!-- ===== 底部翻页按钮 ===== -->
<div id="navBtns">
  <button id="btnPrev" onclick="prevPage()" disabled>◀</button>
  <span id="pageIndicator">1/N</span>
  <button id="btnNext" onclick="nextPage()">▶</button>
</div>

<script>
// ⚠ 加载顺序：page-flip-system.js 必须最先（其中定义了 getPageParam，供 mqtt-framework/teaching-control 复用）
// 引用: references/templates/page-flip-system.js
// 引用: references/templates/quiz-engine.js
// 引用: references/templates/matching-quiz.js
// 引用: references/templates/canvas-engine-patterns.js
// 引用: references/templates/infographic-generator.js
// 各仿真和绘制函数按需添加...

// ===== 全屏：v2026-09-28e 定案「默认不放按钮」 =====
// 外壳 sandbox 无 allow-fullscreen，网页代码达不到 F11 式真全屏，故不放全屏按钮及其 JS。
// 需要全屏 → 用户按 F11 或直开 HTML；确需按钮 → 从 teaching-control.js 取三级降级实现。


// ===== 渐进呈现动画引擎 =====
// 使用方式：在 onPageEnter 中调用 setupReveal(pageId, [...]), 定义每步揭示的元素
// 每个 item: { sel: 'CSS选择器', anim: '动画class名', delay: 可选延迟ms }
// 学生在讲授页点击空白区域依次揭示

var pageRevealQueues = {};   // { p2: [{sel, anim, delay}, ...], ... }
var pageRevealIndex = {};    // { p2: 2, ... }
var pageRevealActive = {};   // { p2: true, ... }
var _revealPlaying = {};     // 上一步动画现场 { p2: {els, anim, t0, dur} }，用于连点快进

/* ---------- 视觉顺序（v1.5.5 新增）----------
   揭示顺序一律按「版面位置」判定：先上后下、同行先左后右，禁止依赖 DOM 书写顺序。
   原因：grid/flex 的 order、column-count 多列、绝对定位、模板套用都会让 DOM 顺序 ≠ 视觉顺序，
   于是出现「下面的比上面的先出现」「右面的比左边的先出现」。 */
function _revealSortEls(els) {
  var arr = Array.prototype.slice.call(els).map(function(el, i) { return { el: el, i: i }; });
  var TOL = 12; // 同一行的容差（px）：卡片行内 top 完全一致，容差只为吸收亚像素/阴影差
  arr.sort(function(a, b) {
    var ra = a.el.getBoundingClientRect(), rb = b.el.getBoundingClientRect();
    if (Math.abs(ra.top - rb.top) > TOL) return ra.top - rb.top;
    if (Math.abs(ra.left - rb.left) > TOL) return ra.left - rb.left;
    return a.i - b.i; // 位置相同 → 保持原序（稳定）
  });
  return arr.map(function(o) { return o.el; });
}

/* 一步揭示实际命中的元素（支持 item.children：容器内子元素逐个揭示） */
function _revealMatch(pageId, item) {
  var base = document.querySelectorAll('#' + pageId + ' ' + item.sel);
  if (item.children) {
    var out = [];
    Array.prototype.forEach.call(base, function(c) {
      out = out.concat(Array.prototype.slice.call(c.querySelectorAll(item.children)));
    });
    return out;
  }
  return Array.prototype.slice.call(base);
}

function setupReveal(pageId, items) {
  pageRevealQueues[pageId] = items;
  pageRevealIndex[pageId] = 0;
  pageRevealActive[pageId] = items.length > 0;
  _revealPlaying[pageId] = null;
  // 初始隐藏所有待揭示元素
  items.forEach(function(item) {
    var els = _revealMatch(pageId, item);
    if (!els.length) {
      console.warn('[reveal] 选择器未命中，该步会被跳过并导致后续顺序前移：#' + pageId + ' ' + item.sel);
    }
    els.forEach(function(el) { el.classList.add('reveal-hidden'); });
  });
  updateRevealHint(pageId);
}

/* 零配置揭示：页面内元素标 data-reveal 即可，队列按视觉顺序自动生成（推荐，永不乱序）
   用法：
     <p data-reveal>段落</p>                        → 淡入上浮（默认）
     <figure class="fig float-r" data-reveal="reveal-float-in-r">…</figure>
     <div data-reveal data-reveal-children=".card" data-reveal-seq="150">…卡片组…</div>
   属性：data-reveal=动画class / data-reveal-children=组内逐个元素 / data-reveal-seq / data-reveal-delay */
function setupRevealAuto(pageId) {
  var root = document.getElementById(pageId);
  if (!root) { console.warn('[reveal] 页面不存在：' + pageId); return; }
  var nodes = Array.prototype.slice.call(root.querySelectorAll('[data-reveal]'));
  // 嵌套去重：祖先已带 data-reveal 的节点不再单独入队
  nodes = nodes.filter(function(el) {
    var p = el.parentElement;
    while (p && p !== root) {
      if (p.hasAttribute && p.hasAttribute('data-reveal')) return false;
      p = p.parentElement;
    }
    return true;
  });
  nodes.forEach(function(el, i) {
    if (!el.hasAttribute('data-reveal-id')) el.setAttribute('data-reveal-id', pageId + 'RV' + i);
  });

  function build() {
    var ordered = _revealSortEls(nodes);   // 每次重建都按当前真实位置排序
    var items = ordered.map(function(el) {
      return {
        sel: '[data-reveal-id="' + el.getAttribute('data-reveal-id') + '"]',
        anim: el.getAttribute('data-reveal') || 'reveal-fade-up',
        children: el.getAttribute('data-reveal-children') || '',
        seqDelay: parseInt(el.getAttribute('data-reveal-seq'), 10) || 0,
        delay: parseInt(el.getAttribute('data-reveal-delay'), 10) || 0
      };
    });
    setupReveal(pageId, items);
  }
  build();

  // 若调用时页面还没完成布局（元素 rect 全为 0，例如 display:none 中提前建队列），
  // 下一帧按真实位置重排一次队列——否则退化成 DOM 顺序，正是「下面先出/右面先出」的根源。
  var unmeasurable = nodes.some(function(el) {
    var r = el.getBoundingClientRect();
    return r.width === 0 && r.height === 0;
  });
  if (unmeasurable) {
    requestAnimationFrame(function() {
      if (pageRevealIndex[pageId] === 0) build();
    });
  }
}

function nextReveal(pageId) {
  if (!pageRevealActive[pageId]) return;
  var queue = pageRevealQueues[pageId];
  var idx = pageRevealIndex[pageId];
  if (!queue || idx >= queue.length) return;

  // ① 连点快进（v1.5.5）：上一步动画尚未播完就点了下一步 → 直接把上一步定格到终态。
  //    否则两次动画时间轴交叠，会出现「后一步还停在透明度 0 已开始计时、前一步刚过半」的倒序错觉。
  var prev = _revealPlaying[pageId];
  if (prev) {
    var elapsed = Date.now() - prev.t0;
    if (prev.dur > 0 && elapsed < prev.dur) {
      prev.els.forEach(function(el) { el.classList.remove(prev.anim); });
    }
    _revealPlaying[pageId] = null;
  }

  var item = queue[idx];
  var els = _revealMatch(pageId, item);
  if (!els.length) {
    console.warn('[reveal] 选择器未命中，该步被跳过：#' + pageId + ' ' + item.sel);
  }
  // ② 组内揭示顺序 = 视觉顺序（上→下、左→右），与 querySelectorAll 的 DOM 顺序无关
  els = _revealSortEls(els);

  var delay = item.delay || 0;
  var seq = item.seqDelay || 0;
  els.forEach(function(el, i) {
    var d = delay + seq * i;
    el.style.animationDelay = d + 'ms';
    el.classList.add(item.anim);
    el.classList.add('reveal-done');
  });

  // ③ 记录本步动画时长（含组内错峰），供下一步连点快进判断
  var dur = 0;
  if (els.length) {
    var ad = '';
    try { ad = getComputedStyle(els[0]).animationDuration || '0s'; } catch (e) {}
    dur = parseFloat(ad) * 1000;
    if (!isFinite(dur) || dur <= 0 || dur > 5000) dur = 0; // 持续型（kenburns 8s 等）不快进
    else dur += delay + seq * Math.max(0, els.length - 1);
  }
  _revealPlaying[pageId] = { els: els, anim: item.anim, t0: Date.now(), dur: dur };

  pageRevealIndex[pageId]++;
  updateRevealHint(pageId);
  // 全部揭示完 → 隐藏提示条
  if (pageRevealIndex[pageId] >= queue.length) {
    pageRevealActive[pageId] = false;
  }
}

// 逆向回退：撤销上一步揭示（配合键盘箭头回退，见 SKILL.md「Progressive Reveal Animation System」章节）
function prevReveal(pageId) {
  var queue = pageRevealQueues[pageId];
  var idx = pageRevealIndex[pageId];
  if (!queue || idx <= 0) return;
  idx--;
  var item = queue[idx];
  var els = _revealMatch(pageId, item);
  els.forEach(function(el) {
    el.classList.remove(item.anim, 'reveal-done');
    el.classList.add('reveal-hidden');
    el.style.animationDelay = '';
    // 项目扩展：此处重置该元素内的 count-num / typewriter 等特殊效果
    // 完整版（含 _twTimer 中断）见 SKILL.md「Progressive Reveal Animation System」章节 prevReveal 完整代码
  });
  _revealPlaying[pageId] = null;
  pageRevealIndex[pageId] = idx;
  pageRevealActive[pageId] = true;
  updateRevealHint(pageId);
}

function updateRevealHint(pageId) {
  var hint = document.getElementById('revealHint');
  var progress = document.getElementById('revealProgress');
  var active = pageRevealActive[pageId];
  var queue = pageRevealQueues[pageId];
  if (!active || !queue) { hint.style.display = 'none'; return; }
  var idx = pageRevealIndex[pageId];
  var remain = queue.length - idx;
  if (remain <= 0) { hint.style.display = 'none'; return; }
  hint.style.display = 'flex';
  progress.textContent = (idx + 1) + '/' + queue.length + ' ←→';
}

// 讲授页全局点击 → 触发 nextReveal（排除链接、按钮、quiz-q 等交互元素）
document.addEventListener('click', function(e) {
  var pageEl = document.querySelector('.page.active');
  if (!pageEl) return;
  var pid = pageEl.id;
  if (!pageRevealActive[pid]) return;
  // 排除交互元素（含图片——图片点击触发灯箱而非揭示）
  var tag = e.target.tagName;
  if (tag === 'A' || tag === 'BUTTON' || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'IMG') return;
  if (e.target.closest('.quiz-q') || e.target.closest('.opt') ||
      e.target.closest('nav') || e.target.closest('#navBtns') || e.target.closest('.timeline-card') ||
      e.target.closest('.mindmap') || e.target.closest('#imgLightbox')) return;
  nextReveal(pid);
});

// 翻页时重置提示条状态
var _origShowPage = showPage;
showPage = function(i) {
  _origShowPage(i);
  var pid = PAGE_IDS[i];
  setTimeout(function() { updateRevealHint(pid); }, 100);
};

// ===== 图片全屏灯箱 =====
function openLightbox(src) {
  document.getElementById('lbImg').src = src;
  document.getElementById('imgLightbox').classList.add('show');
}
function closeLightbox() {
  document.getElementById('imgLightbox').classList.remove('show');
}
// 页面图片点击 → 全屏放大
document.addEventListener('click', function(e) {
  if (e.target.tagName === 'IMG' && !e.target.closest('#imgLightbox') && !e.target.closest('.qr-img-wrap')) {
    e.stopPropagation();
    openLightbox(e.target.src);
  }
});
// ESC 关闭灯箱
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    var lb = document.getElementById('imgLightbox');
    if (lb.classList.contains('show')) { closeLightbox(); e.preventDefault(); }
  }
});

var PAGE_IDS = ["p0", "p1", "p2", "p3", "p3b", "p4", "p5", "p6", "p7", "p8", "p9", "p10"];
var PAGE_LABELS = ["封面", "前测", "电影票", "先列后行", "连一连", "中测1", "行列规律", "仿真", "中测2", "辨析", "后测", "总结"];
var IMG_PREFIX = 'img/';
var curPage = 0;

// ===== 测验数据 =====
var QUIZZES = {
  quizPre: {
    questions: [
      { answer: 0, explain: "两个数换个次序，听起来就是另一个座位。位置描述必须约定先后。" },
      { answer: 0, explain: "列和行是两个方向，先定一个再定另一个；教材统一规定先列后行。" },
      { answer: 1, explain: "列和层是两个方向，2 列 3 层与 3 列 2 层是两个不同的柜门。" }
    ]
  },
  quizMid1: {
    questions: [
      { answer: 1, explain: "前一个是列，后一个是行。选 A 把两个数都说反了；选 C 只把列行调了个头。" },
      { answer: 0, explain: "先列后行写 (7, 3)。选 B 是先写行后写列；选 C 把逗号写成了小数点，那不是数对。" },
      { answer: 1, explain: "次序换了位置就换。选 A 只看到两个数相同；选 C 忽略了数对本身就是位置。" }
    ]
  },
  quizMid2: {
    questions: [
      { answer: 0, explain: "列不变，变的是行 → 第一个数相同。选 B 说的是同一行的情况。" },
      { answer: 1, explain: "往右是列变大、行不变 → (8, 3)。选 A 把左右当成了上下；选 C 是往左移。" },
      { answer: 2, explain: "先列后层 → (2, 3)。选 A 顺序反了；选 B 写成了小数。" }
    ]
  },
  quizPost: {
    questions: [
      { answer: 1, explain: "a 是第一个数，管左右方向，就是列。选 A 把次序记反了。" },
      { answer: 0, explain: "先列后行 → (6, 2)。选 B 顺序反了；选 C 写成了小数。" },
      { answer: 1, explain: "同一行第二个数相同 → 必须是 (?, 5)。选 A 是同一列；选 C 两个数都变了。" },
      { answer: 0, explain: "同一列第一个数相同 → 必须是 (4, ?)。选 B 是同一行；选 C 是换到对角。" },
      { answer: 0, explain: "组是列、排是行，先组后排 → (3, 4)。选 B 把排当成了列；选 C 写成了小数。" }
    ]
  }
};
// ===== 翻页系统 =====
function getPageParam(k) {
  try {
    var h = location.hash || '';
    if (h.indexOf(k + '=') >= 0) {
      var m1 = new RegExp('[#&]' + k + '=([^&#]*)').exec(h);
      if (m1) return decodeURIComponent(m1[1]);
    }
    var q = location.search || '';
    if (q.indexOf(k + '=') >= 0) {
      var m2 = new RegExp('[?&]' + k + '=([^&#]*)').exec(q);
      if (m2) return decodeURIComponent(m2[1]);
    }
    if (window.parent && window.parent !== window) {
      try {
        var psrc = (window.parent.location.hash || '') + '&' + (window.parent.location.search || '');
        if (psrc.indexOf(k + '=') >= 0) {
          var m3 = new RegExp('[#&?]' + k + '=([^&#]*)').exec(psrc);
          if (m3) return decodeURIComponent(m3[1]);
        }
      } catch (e) {}
    }
  } catch (e) {}
  return null;
}

function showPage(i) {
  if (i < 0 || i >= PAGE_IDS.length) return;
  var oldEl = document.querySelector('.page.active');
  if (oldEl) oldEl.classList.remove('active');
  var newEl = document.getElementById(PAGE_IDS[i]);
  if (newEl) { newEl.classList.add('active'); newEl.scrollTop = 0; }
  curPage = i;
  document.querySelectorAll('#topNav .chip').forEach(function(c, idx) {
    c.classList.toggle('active', idx === i);
  });
  document.getElementById('progressBar').style.width = ((i + 1) / PAGE_IDS.length * 100) + '%';
  document.getElementById('pageIndicator').textContent = (i + 1) + '/' + PAGE_IDS.length;
  document.getElementById('btnPrev').disabled = (i === 0);
  document.getElementById('btnNext').disabled = (i === PAGE_IDS.length - 1);
  onPageEnter(i);
  var activeChip = document.querySelector('#topNav .chip.active');
  if (activeChip && typeof activeChip.scrollIntoView === 'function') activeChip.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
}

function nextPage() { if (curPage < PAGE_IDS.length - 1) showPage(curPage + 1); }
function prevPage() { if (curPage > 0) showPage(curPage - 1); }

document.querySelectorAll('#topNav .chip').forEach(function(chip) {
  chip.addEventListener('click', function() {
    showPage(parseInt(this.getAttribute('data-page')));
  });
});

document.addEventListener('keydown', function(e) {
  var pid = PAGE_IDS[curPage];
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
    e.preventDefault();
    if (typeof pageRevealActive !== 'undefined' && pageRevealActive[pid] &&
        pageRevealQueues[pid] && pageRevealIndex[pid] < pageRevealQueues[pid].length) {
      nextReveal(pid);
    } else { nextPage(); }
  } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
    e.preventDefault();
    if (typeof pageRevealQueues !== 'undefined' && pageRevealQueues[pid] && pageRevealIndex[pid] > 0) {
      prevReveal(pid);
    } else { prevPage(); }
  }
});

var touchStartX = 0, touchStartY = 0;
document.addEventListener('touchstart', function(e) {
  touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY;
}, { passive: true });
document.addEventListener('touchend', function(e) {
  var dx = e.changedTouches[0].clientX - touchStartX;
  var dy = e.changedTouches[0].clientY - touchStartY;
  if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 60) {
    if (dx < 0) nextPage(); else prevPage();
  }
});

var pageEntered = {};
function onPageEnter(i) {
  var id = PAGE_IDS[i];
  if (pageEntered[id]) return;
  pageEntered[id] = true;
  if (id === 'p2') {
    setupReveal('p2', [
      { sel: '#p2s1', anim: 'reveal-fade-up' },
      { sel: '#p2fig', anim: 'reveal-float-in-r' },
      { sel: '#p2s2', anim: 'reveal-fade-up' },
      { sel: '#p2s3', anim: 'reveal-fade-up' },
      { sel: '#p2cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 110 },
      { sel: '#p2key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p3') {
    setupReveal('p3', [
      { sel: '#p3s1', anim: 'reveal-fade-up' },
      { sel: '#p3fig', anim: 'reveal-float-in-r' },
      { sel: '#p3s2', anim: 'reveal-fade-up' },
      { sel: '#p3rules', anim: 'reveal-fade-up' },
      { sel: '#p3key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p3b') {
    setupReveal('p3b', [{ sel: '#p3bs1', anim: 'reveal-fade-up' }]);
    initMatching('matchP3', [
      ['第 2 列第 5 行', '(2, 5)'],
      ['第 5 列第 2 行', '(5, 2)'],
      ['第 1 列第 6 行', '(1, 6)'],
      ['第 6 列第 1 行', '(6, 1)'],
      ['第 4 列第 4 行', '(4, 4)'],
      ['第 3 列第 7 行', '(3, 7)'],
      ['第 7 列第 3 行', '(7, 3)'],
      ['第 8 列第 2 行', '(8, 2)']
    ], { leftTitle: '座位描述', rightTitle: '数对' });
  }
  if (id === 'p5') {
    setupReveal('p5', [
      { sel: '#p5s1', anim: 'reveal-fade-up' },
      { sel: '#p5fig', anim: 'reveal-float-in-r' },
      { sel: '#p5s2', anim: 'reveal-fade-up' },
      { sel: '#p5cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 120 },
      { sel: '#p5key', anim: 'reveal-fade-up' }
    ]);
  }
  if (id === 'p6') { simBind(); simDraw(); }
  if (id === 'p8') {
    setupReveal('p8', [
      { sel: '#p8cards', anim: 'reveal-card-grid', children: '.card', seqDelay: 120 },
      { sel: '#p8key', anim: 'reveal-fade-up' },
      { sel: '#p8apply', anim: 'reveal-fade-up' }
    ]);
  }
}

// ===== 测验引擎 =====
(function(){
  if (document.getElementById('quiz-engine-css')) return;
  var st = document.createElement('style');
  st.id = 'quiz-engine-css';
  st.textContent = [
    '.q-type{display:inline-block;font-size:14px;font-weight:700;padding:1px 10px;border-radius:12px;margin-right:8px;vertical-align:2px;background:var(--primary-light);color:#fff;letter-spacing:1px}',
    '.q-type.multi{background:var(--accent)}',
    '.opt-confirm{margin-top:10px;padding:7px 22px;border-radius:18px;font-size:16px;font-weight:600;cursor:pointer;border:2px solid var(--accent);background:var(--paper);color:var(--accent);transition:all .2s}',
    '.opt-confirm:hover{background:var(--accent);color:#fff}',
    '.quiz-q.submitted .opt-confirm{display:none}'
  ].join('\n');
  document.head.appendChild(st);
})();

function isMultiQ(q){ return !!(q && q.multi && Array.isArray(q.answer)); }
function sameIdxArr(a, b){
  if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
  for (var i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
  return true;
}
function ascArr(a){ return a.slice().sort(function(x, y){ return x - y; }); }
function isCorrectChoice(q, chosen){
  if (isMultiQ(q)) return sameIdxArr(chosen, ascArr(q.answer));
  return chosen === q.answer;
}
function idxInAnswer(q, j){
  return Array.isArray(q.answer) ? q.answer.indexOf(j) >= 0 : j === q.answer;
}
function idxInChosen(c, j){
  return Array.isArray(c) ? c.indexOf(j) >= 0 : c === j;
}
function quizScoreId(containerId){
  var s = String(containerId).replace(/^quiz/, '');
  return s.charAt(0).toLowerCase() + s.slice(1) + 'Score';
}

function initQuiz(quizId) {
  var container = document.getElementById(quizId);
  if (!container || !QUIZZES[quizId]) return;
  if (container._initialized) return;
  container._initialized = true;
  container._questions = QUIZZES[quizId].questions;
  container._chosen = container._questions.map(function(q){ return isMultiQ(q) ? null : -1; });
  container._picked = container._questions.map(function(q){ return isMultiQ(q) ? [] : null; });
  var isSubmitMode = false;

  container.querySelectorAll('.quiz-q').forEach(function(qq, qi) {
    var q = container._questions[qi];
    if (!q) return;
    var opts = qq.querySelectorAll('.opt');
    if (isMultiQ(q)) {
      opts.forEach(function(opt) {
        opt.addEventListener('click', function() {
          if (container._submitted) return;
          var idx = parseInt(this.getAttribute('data-idx'));
          var pos = container._picked[qi].indexOf(idx);
          if (pos >= 0) { container._picked[qi].splice(pos, 1); this.classList.remove('selected'); }
          else { container._picked[qi].push(idx); this.classList.add('selected'); }
        });
      });
      var btn = qq.querySelector('.opt-confirm');
      if (btn) btn.addEventListener('click', function() {
        if (container._submitted) return;
        if (container._picked[qi].length === 0) return;
        container._chosen[qi] = ascArr(container._picked[qi]);
        qq.classList.add('answered');
        if (!isSubmitMode) { showFeedback(quizId, qi); updateQuizScore(quizId); }
      });
    } else {
      opts.forEach(function(opt) {
        opt.addEventListener('click', function() {
          if (container._submitted) return;
          var idx = parseInt(this.getAttribute('data-idx'));
          container._chosen[qi] = idx;
          opts.forEach(function(o) { o.classList.remove('selected'); });
          this.classList.add('selected');
          qq.classList.add('answered');
          if (!isSubmitMode) { showFeedback(quizId, qi); updateQuizScore(quizId); }
        });
      });
    }
  });
}

function showFeedback(quizId, qi) {
  var container = document.getElementById(quizId);
  var q = container._questions[qi];
  var c = container._chosen[qi];
  var qq = document.getElementById('qq_' + quizId + '_' + qi);
  var fb = document.getElementById('fb_' + quizId + '_' + qi);
  if (!qq || !fb) return;
  var isCorrect = isCorrectChoice(q, c);
  fb.innerHTML = '<span class="fb-icon">' + (isCorrect ? '✓' : '✗') + '</span>' +
    (isCorrect ? '答对了。' : '再看一遍。') + q.explain;
  fb.className = 'feedback show ' + (isCorrect ? 'correct-fb' : 'wrong-fb');
  qq.querySelectorAll('.opt').forEach(function(o, j) {
    if (idxInAnswer(q, j)) o.classList.add('correct');
    if (!isCorrect && idxInChosen(c, j) && !idxInAnswer(q, j)) o.classList.add('wrong');
    o.style.pointerEvents = 'none';
  });
}

function updateQuizScore(quizId) {
  var container = document.getElementById(quizId);
  var total = container._questions.length;
  var done = 0, score = 0;
  container._questions.forEach(function(q, i) {
    var c = container._chosen[i];
    var answered = isMultiQ(q) ? (Array.isArray(c) && c.length > 0) : c >= 0;
    if (answered) { done++; if (isCorrectChoice(q, c)) score++; }
  });
  var scoreEl = document.getElementById(quizScoreId(quizId));
  if (scoreEl) {
    scoreEl.style.display = 'block';
    if (done === total) {
      scoreEl.innerHTML = '得分：' + score + '/' + total + ' &nbsp;&nbsp;' +
        (score === total ? '🌟 全部正确！' : score >= total * 0.6 ? '👍 不错，继续加油！' : '💪 回到前面再看一遍');
    } else {
      scoreEl.textContent = '已答：' + done + '/' + total + ' 正确：' + score;
    }
  }
  try { localStorage.setItem('xmn_' + quizId, JSON.stringify({ score: score, total: total, done: done })); } catch (e) {}
}

function retryQuiz(quizId) {
  var container = document.getElementById(quizId);
  if (!container) return;
  container._chosen = container._questions.map(function(q){ return isMultiQ(q) ? null : -1; });
  container._picked = container._questions.map(function(q){ return isMultiQ(q) ? [] : null; });
  container.querySelectorAll('.quiz-q').forEach(function(qq) {
    qq.classList.remove('answered');
    qq.querySelectorAll('.opt').forEach(function(o) {
      o.classList.remove('selected', 'correct', 'wrong');
      o.style.pointerEvents = 'auto';
    });
  });
  container.querySelectorAll('.feedback').forEach(function(fb) { fb.className = 'feedback'; fb.innerHTML = ''; });
  var el = document.getElementById(quizScoreId(quizId));
  if (el) el.style.display = 'none';
}

Object.keys(QUIZZES).forEach(function(k) { initQuiz(k); });

// ===== 连线题引擎 =====
(function(){
  var CSS = [
    '.match-wrap{position:relative;margin:14px 0}',
    '.match-cols{display:grid;grid-template-columns:1fr 1fr;gap:40px}',
    '.match-col h4{font-size:18px;color:var(--primary);margin-bottom:10px;text-align:center}',
    '.match-item{padding:14px 18px;margin-bottom:12px;border:2px solid var(--line);border-radius:12px;background:#fff;font-size:19px;cursor:pointer;transition:all .2s;text-align:center}',
    '.match-item:hover{border-color:var(--primary-light)}',
    '.match-item.sel{border-color:var(--accent);background:var(--accent-soft)}',
    '.match-item.ok{border-color:var(--green);background:#E8F5F3}',
    '.match-item.bad{border-color:var(--red);animation:shakeX .35s}',
    '@keyframes shakeX{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}',
    '.match-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}',
    '.mq-actions{text-align:center;margin-top:10px}',
    '.mq-actions button{padding:7px 22px;border-radius:18px;font-size:16px;font-weight:600;cursor:pointer;border:2px solid var(--primary);background:var(--paper);color:var(--primary)}',
    '.mq-done{text-align:center;font-size:18px;font-weight:700;color:var(--green);margin-top:8px;min-height:24px}'
  ].join('\n');
  var st = document.createElement('style');
  st.textContent = CSS;
  document.head.appendChild(st);
})();

function initMatching(containerId, pairs, options){
  options = options || {};
  var c = document.getElementById(containerId);
  if (!c || c._initialized) return;
  c._initialized = true;
  var list = pairs.map(function(p){ return Array.isArray(p) ? {left:p[0], right:p[1]} : p; });
  var order = list.map(function(_, i){ return i; });
  for (var i = order.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = order[i]; order[i] = order[j]; order[j] = t;
  }
  c.innerHTML =
    '<div class="match-wrap"><div class="match-cols">' +
      '<div class="match-col"><h4>' + (options.leftTitle || '左侧') + '</h4>' +
        list.map(function(p, k){ return '<div class="match-item" data-side="L" data-i="' + k + '">' + p.left + '</div>'; }).join('') +
      '</div>' +
      '<div class="match-col"><h4>' + (options.rightTitle || '右侧') + '</h4>' +
        order.map(function(k){ return '<div class="match-item" data-side="R" data-i="' + k + '">' + list[k].right + '</div>'; }).join('') +
      '</div>' +
    '</div><svg class="match-svg"></svg></div>' +
    '<div class="mq-actions"><button type="button" data-act="retry">重试</button></div>' +
    '<div class="mq-done"></div>';

  var wrap = c.querySelector('.match-wrap');
  var svg = c.querySelector('.match-svg');
  var state = { sel: null, links: {}, ok: {} };

  function itemAt(side, idx){ return c.querySelector('.match-item[data-side="' + side + '"][data-i="' + idx + '"]'); }

  function drawLinks(){
    var box = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + box.width + ' ' + box.height);
    svg.innerHTML = '';
    Object.keys(state.links).forEach(function(l){
      var a = itemAt('L', Number(l)), b = itemAt('R', state.links[l]);
      if (!a || !b) return;
      var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
      var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', ra.right - box.left);
      line.setAttribute('y1', ra.top + ra.height / 2 - box.top);
      line.setAttribute('x2', rb.left - box.left);
      line.setAttribute('y2', rb.top + rb.height / 2 - box.top);
      line.setAttribute('stroke', state.ok[l] ? '#00897B' : '#D84315');
      line.setAttribute('stroke-width', '3');
      line.setAttribute('stroke-linecap', 'round');
      svg.appendChild(line);
    });
  }

  function checkDone(){
    var total = list.length;
    var done = Object.keys(state.ok).filter(function(k){ return state.ok[k]; }).length;
    if (done === total) {
      c.querySelector('.mq-done').textContent = '✓ 全部连对，三根针的速度都记住了';
      if (options.onDone) options.onDone(done, total);
    }
  }

  c.addEventListener('click', function(e){
    var el = e.target.closest('.match-item');
    if (!el) return;
    var side = el.getAttribute('data-side');
    var idx = parseInt(el.getAttribute('data-i'), 10);
    if (el.classList.contains('ok')) return;

    if (!state.sel || state.sel.side === side) {
      c.querySelectorAll('.match-item.sel').forEach(function(x){ x.classList.remove('sel'); });
      state.sel = { side: side, idx: idx };
      el.classList.add('sel');
      return;
    }
    var l = side === 'L' ? idx : state.sel.idx;
    var r = side === 'R' ? idx : state.sel.idx;
    if (state.links[l] !== undefined) delete state.links[l];
    state.links[l] = r;
    state.ok[l] = (l === r);
    var leftEl = itemAt('L', l), rightEl = itemAt('R', r);
    c.querySelectorAll('.match-item.sel').forEach(function(x){ x.classList.remove('sel'); });
    if (state.ok[l]) {
      leftEl.classList.add('ok'); rightEl.classList.add('ok');
    } else {
      leftEl.classList.add('bad'); rightEl.classList.add('bad');
      setTimeout(function(){ leftEl.classList.remove('bad'); rightEl.classList.remove('bad'); }, 400);
    }
    state.sel = null;
    drawLinks();
    checkDone();
  });

  c.querySelector('[data-act="retry"]').addEventListener('click', function(){
    state = { sel: null, links: {}, ok: {} };
    c.querySelectorAll('.match-item').forEach(function(x){ x.className = 'match-item'; });
    c.querySelector('.mq-done').textContent = '';
    drawLinks();
  });
  window.addEventListener('resize', drawLinks);
}

// ===== 仿真：按数对找格子 =====
var SIM_W = 880, SIM_H = 360;
var SIM_FONT = '"Microsoft YaHei","Noto Sans SC",sans-serif';

var SIM_COLS = 8, SIM_ROWS = 6;
var SIM_CW = 80, SIM_CH = 38;
var SIM_X0 = 130, SIM_Y0 = 72;

var SIM_CASES = [[3, 4], [6, 2], [1, 5], [8, 3], [5, 6], [2, 2]];

// i = 题号；pick = 学生点的格子 {c,r}；hint = 是否亮出行列
var SIM = { i: 0, pick: null, hint: false };

function simT() { return SIM_CASES[SIM.i]; }
function simCtx() { return document.getElementById('simCanvas').getContext('2d'); }

function simTxt(t, x, y, size, color, weight, align) {
  var ctx = simCtx();
  ctx.save();
  ctx.font = (weight ? weight + ' ' : '') + size + 'px ' + SIM_FONT;
  ctx.fillStyle = color;
  ctx.textAlign = align || 'left';
  ctx.fillText(t, x, y);
  ctx.restore();
}

function simLine(x1, y1, x2, y2, color, w, dash) {
  var ctx = simCtx();
  ctx.save();
  ctx.strokeStyle = color; ctx.lineWidth = w || 2; ctx.lineCap = 'round';
  if (dash) ctx.setLineDash(dash);
  ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
  ctx.restore();
}

function simBox(x, y, w, h, fill, stroke, r) {
  var ctx = simCtx();
  r = (r === undefined) ? 8 : r;
  ctx.save();
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
  if (fill) { ctx.fillStyle = fill; ctx.fill(); }
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1.6; ctx.stroke(); }
  ctx.restore();
}

function simCellPos(c, r) {
  return { x: SIM_X0 + (c - 1) * SIM_CW, y: SIM_Y0 + (SIM_ROWS - r) * SIM_CH };
}

function simDraw() {
  var ctx = simCtx(), t = simT();
  ctx.clearRect(0, 0, SIM_W, SIM_H);

  // 题面
  simBox(24, 16, 832, 44, '#F6F7FC', '#CFD3E8', 10);
  simTxt('要点的位置', 44, 44, 13, '#7986CB');
  simTxt('(' + t[0] + ', ' + t[1] + ')', 132, 46, 22, '#283593', '700');
  simTxt('= 第 ' + t[0] + ' 列 第 ' + t[1] + ' 行', 226, 44, 14, '#283593');
  simTxt('列号看下边，行号看左边', 776, 44, 13, '#90A4AE', '', 'end');

  // 行列提示
  if (SIM.hint) {
    var cy = SIM_Y0 + (SIM_ROWS - t[1]) * SIM_CH + SIM_CH / 2;
    var cx = SIM_X0 + (t[0] - 1) * SIM_CW + SIM_CW / 2;
    simLine(SIM_X0, cy, SIM_X0 + SIM_COLS * SIM_CW, cy, '#26C6DA', 2, [7, 5]);
    simLine(cx, SIM_Y0, cx, SIM_Y0 + SIM_ROWS * SIM_CH, '#26C6DA', 2, [7, 5]);
  }

  // 底格
  for (var c = 1; c <= SIM_COLS; c++) {
    for (var r = 1; r <= SIM_ROWS; r++) {
      var p = simCellPos(c, r);
      simBox(p.x + 1.5, p.y + 1.5, SIM_CW - 3, SIM_CH - 3, '#FFFFFF', '#CFD3E8', 5);
    }
  }

  // 点过的格子
  if (SIM.pick) {
    var ok = (SIM.pick.c === t[0] && SIM.pick.r === t[1]);
    var pp = simCellPos(SIM.pick.c, SIM.pick.r);
    simBox(pp.x + 1.5, pp.y + 1.5, SIM_CW - 3, SIM_CH - 3,
           ok ? '#C8E6C9' : '#FFCDD2', ok ? '#2E7D32' : '#C62828', 5);
    simTxt('(' + SIM.pick.c + ',' + SIM.pick.r + ')', pp.x + SIM_CW / 2, pp.y + SIM_CH / 2 + 5, 14,
           ok ? '#1B5E20' : '#B71C1C', '700', 'center');
  }

  // 列号 / 行号
  for (var c2 = 1; c2 <= SIM_COLS; c2++) {
    simTxt(String(c2), SIM_X0 + (c2 - 0.5) * SIM_CW, SIM_Y0 + SIM_ROWS * SIM_CH + 20, 13, '#5C6BC0', '', 'center');
  }
  for (var r2 = 1; r2 <= SIM_ROWS; r2++) {
    simTxt(String(r2), SIM_X0 - 14, SIM_Y0 + (SIM_ROWS - r2) * SIM_CH + SIM_CH / 2 + 5, 13, '#5C6BC0', '', 'right');
  }
  simTxt('列 →', SIM_X0 + SIM_COLS * SIM_CW + 14, SIM_Y0 + SIM_ROWS * SIM_CH + 20, 12, '#90A4AE');
  simTxt('行 ↑', 30, SIM_Y0 + 6, 12, '#90A4AE');

  var ro = document.getElementById('simReadout');
  if (ro) {
    ro.textContent = '目标 (' + t[0] + ', ' + t[1] + ') · ' +
      (SIM.pick ? ('你点了 (' + SIM.pick.c + ', ' + SIM.pick.r + ')') : '还没点');
  }
  var tip = document.getElementById('simTip');
  if (tip) {
    if (!SIM.pick) tip.textContent = '先横着数 ' + t[0] + ' 列，再竖着数 ' + t[1] + ' 行';
    else if (SIM.pick.c === t[0] && SIM.pick.r === t[1]) tip.textContent = '对了，就是 ( ' + t[0] + ', ' + t[1] + ' )';
    else if (SIM.pick.c !== t[0] && SIM.pick.r !== t[1]) tip.textContent = '列和行都差着，再数一遍';
    else if (SIM.pick.c !== t[0]) tip.textContent = '行数对了，列数差 ' + Math.abs(SIM.pick.c - t[0]) + ' 格';
    else tip.textContent = '列数对了，行数差 ' + Math.abs(SIM.pick.r - t[1]) + ' 格';
  }
}

function simLog(msg, hl) {
  var box = document.getElementById('simLog');
  if (!box) return;
  var d = document.createElement('div');
  d.className = 'sim-log-line' + (hl ? ' hl' : '');
  d.textContent = msg;
  box.appendChild(d);
  if (box.children.length > 4) box.removeChild(box.firstChild);
}

function simHint() {
  SIM.hint = !SIM.hint;
  simDraw();
  var t = simT();
  simLog(SIM.hint ? ('第 ' + t[0] + ' 列是一道竖条，第 ' + t[1] + ' 行是一道横条，交叉那一格就是') : '收起了行列提示');
}

function simCase() {
  SIM.i = (SIM.i + 1) % SIM_CASES.length;
  SIM.pick = null; SIM.hint = false;
  simDraw();
  var t = simT();
  simLog('换一题：找 (' + t[0] + ', ' + t[1] + ')');
}

function simReset() {
  SIM.pick = null; SIM.hint = false;
  simDraw();
  simLog('重来：找 (' + simT()[0] + ', ' + simT()[1] + ')', true);
}

var SIM_TIMER = null;
function simDemo() {
  if (SIM_TIMER) { clearInterval(SIM_TIMER); SIM_TIMER = null; }
  SIM.pick = null; SIM.hint = true;
  simDraw();
  var t = simT();
  simLog('自动演示：先横向数 ' + t[0] + ' 列');
  SIM_TIMER = setTimeout(function () {
    SIM.pick = { c: t[0], r: t[1] };
    simDraw();
    simLog('再竖向数 ' + t[1] + ' 行，交点就是 (' + t[0] + ', ' + t[1] + ')', true);
    SIM_TIMER = null;
  }, 900);
}

function simBind() {
  var cv = document.getElementById('simCanvas');
  if (!cv || cv.dataset.bound) return;
  cv.dataset.bound = '1';
  cv.style.cursor = 'pointer';
  cv.addEventListener('click', function (e) {
    var rect = cv.getBoundingClientRect();
    var x = (e.clientX - rect.left) * (SIM_W / rect.width);
    var y = (e.clientY - rect.top) * (SIM_H / rect.height);
    var c = Math.floor((x - SIM_X0) / SIM_CW) + 1;
    var r = SIM_ROWS - Math.floor((y - SIM_Y0) / SIM_CH);
    if (c < 1 || c > SIM_COLS || r < 1 || r > SIM_ROWS) return;
    SIM.pick = { c: c, r: r };
    simDraw();
    var t = simT();
    if (c === t[0] && r === t[1]) simLog('点对了：(' + c + ', ' + r + ')', true);
    else simLog('点到了 (' + c + ', ' + r + ')，目标是 (' + t[0] + ', ' + t[1] + ')');
  });
}
// ===== V4 总结页 =====
function toggleCardV4(card){ card.classList.toggle('expanded'); }
function expandAllV4(){ document.querySelectorAll('.summary-v4-card').forEach(function(c){ c.classList.add('expanded'); }); }
function collapseAllV4(){ document.querySelectorAll('.summary-v4-card').forEach(function(c){ c.classList.remove('expanded'); }); }

// ===== 初始显示 =====
var _urlPage = getPageParam('page');
var _initIdx = (_urlPage && PAGE_IDS.indexOf(_urlPage) >= 0) ? PAGE_IDS.indexOf(_urlPage) : 0;
showPage(_initIdx);

</script>
</body>
</html>
