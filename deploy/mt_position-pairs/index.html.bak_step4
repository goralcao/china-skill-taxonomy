  <span class="chip" data-page="6">行列规律</span>
  <span class="chip sim" data-page="7">仿真</span>
  <span class="chip mid" data-page="8">中测2</span>
  <span class="chip" data-page="9">辨析</span>
  <span class="chip post" data-page="10">后测</span>
  <span class="chip chip-end" data-page="11">总结</span>
</nav>

<!-- ===== 进度条 ===== -->
<!-- ===== 进度条 ===== -->
